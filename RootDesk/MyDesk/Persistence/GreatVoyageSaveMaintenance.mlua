@Logic
script GreatVoyageSaveMaintenance extends Logic

	property boolean enabled = true
	-- 主人已授權公開世界初次上線初始化；這是固定維護版，完成後須停用並重新發布。
	property boolean initialRolloutAuthorized = true
	property string expectedWorldId = "cb91356a3a624026ad7d8d2155333c27"
	property string maintenanceUserId = "20372100005470373"
	property boolean attempted = false
	property boolean running = false
	property boolean setAttempted = false
	property string storageName = "GVSaveV1Bootstrap"
	property string storagePrefix = "GVSaveV1"
	property string gateKey = "gate"
	property string openValue = "OPEN"
	property integer notFoundCode = 1000002

	@ExecSpace("ServerOnly")
	method boolean HasSafeContext(string userId)
		-- 限定正式世界、指定維護者及單人場景；每次原生呼叫返回後重新確認。
		if self.enabled ~= true or self.initialRolloutAuthorized ~= true then return false end
		if type(userId) ~= "string" or userId == "" or userId ~= self.maintenanceUserId then return false end
		if self.expectedWorldId == "" or Environment:IsPublishedPlay() ~= true or Environment.WorldId ~= self.expectedWorldId then return false end
		if _UserService == nil then return false end
		local count = 0
		local found = false
		for _, entity in ipairs(_UserService.UserEntities.Values) do
			if entity ~= nil and entity.PlayerComponent ~= nil then
				count = count + 1
				if entity.PlayerComponent.UserId == userId then found = true end
			end
		end
		if count ~= 1 or found ~= true then return false end
		local store = _GreatVoyageProfileStore
		if store == nil or store.storagePrefix ~= self.storagePrefix or store.bootstrapGateKey ~= self.gateKey or type(store.accounts) ~= "table" then return false end
		for _, account in pairs(store.accounts) do
			if account ~= nil and (account.saving == true or account.reconcileInProgress == true or account.writeKind ~= nil or account.bootstrapSetAttempted == true or account.bootstrapGateToken ~= nil or account.bootstrapGatePhase ~= nil) then return false end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsOnlyReleaseInstance(string userId)
		-- 清單只是快照；整份維護版禁止一般建檔，拒絕同時存在的其他 instance。
		local callOk, ok, pages = pcall(function() return _WorldInstanceService:GetWorldInstanceInfoPagesAndWait() end)
		if callOk ~= true then return false end
		if self:HasSafeContext(userId) ~= true then return false end
		if ok ~= true or pages == nil then return false end
		local count = 0
		local currentFound = false
		local pageCount = 0
		while true do
			pageCount = pageCount + 1
			if pageCount > 64 then return false end
			local pageOk, pageData = pcall(function() return pages:GetCurrentPageDatas() end)
			if pageOk ~= true then return false end
			if type(pageData) ~= "table" then return false end
			for _, instance in pairs(pageData) do
				if instance == nil or type(instance.Id) ~= "string" or type(instance.CurrentUserCount) ~= "number" then return false end
				count = count + 1
				if count > 1 then return false end
				if instance.Id == _WorldInstanceService.WorldInstanceId and instance.CurrentUserCount == 1 then currentFound = true end
			end
			if type(pages.IsLastPage) ~= "boolean" then return false end
			if pages.IsLastPage then break end
			local moveOk, moved = pcall(function() return pages:MoveToNextPageAndWait() end)
			if moveOk ~= true or moved ~= true then return false end
			if self:HasSafeContext(userId) ~= true then return false end
		end
		return count == 1 and currentFound
	end

	@ExecSpace("ServerOnly")
	method void TrySeedGate(string userId)
		-- 每個 instance 最多一次嘗試；只補缺少的門，不讀寫玩家存檔。
		if self.running == true or self.attempted == true then return end
		if self:HasSafeContext(userId) ~= true then return end
		self.running = true
		self.attempted = true
		if self:IsOnlyReleaseInstance(userId) ~= true then
			self.running = false
			log("[SaveV1][Maintenance] refused: release instance enumeration or context check failed")
			return
		end
		if self:HasSafeContext(userId) ~= true then self.running = false return end
		local storageOk, storage = pcall(function() return _DataStorageService:GetGlobalDataStorage(self.storageName) end)
		if storageOk ~= true or storage == nil then self.running = false log("[SaveV1][Maintenance] stopped: storage unavailable") return end
		local getOk, code, value = pcall(function() return storage:GetAndWait(self.gateKey) end)
		if getOk ~= true then self.running = false log("[SaveV1][Maintenance] stopped: gate read exception; no write") return end
		if self:HasSafeContext(userId) ~= true then self.running = false log("[SaveV1][Maintenance] stopped after gate read: context changed; no further calls") return end
		if code == 0 and value == self.openValue then
			self.running = false
			log("[VRF][SaveV1][Maintenance] gate already OPEN; no write and no profile access")
			return
		end
		local missing = (code == 0 or code == self.notFoundCode) and value == nil
		if missing ~= true then
			self.running = false
			log("[SaveV1][Maintenance] refused: gate read was not confirmed missing; no write")
			return
		end
		if self:HasSafeContext(userId) ~= true or self.setAttempted == true then self.running = false return end
		self.setAttempted = true
		local setOk, setCode = pcall(function() return storage:SetAndWait(self.gateKey, self.openValue) end)
		if setOk ~= true then setCode = "exception" end
		if self:HasSafeContext(userId) ~= true then
			self.running = false
			log("[SaveV1][Maintenance] indeterminate: context changed after Set; stopped without retry")
			return
		end
		local readOk, readCode, readValue = pcall(function() return storage:GetAndWait(self.gateKey) end)
		if readOk ~= true then readCode = "exception" readValue = nil end
		if self:HasSafeContext(userId) ~= true then
			self.running = false
			log("[SaveV1][Maintenance] indeterminate: context changed after readback; stopped without retry")
			return
		end
		self.running = false
		if readCode == 0 and readValue == self.openValue then
			log("[VRF][SaveV1][Maintenance] gate OPEN confirmed by exact readback; no profile touched; disable maintenance and republish before normal play")
		else
			log("[SaveV1][Maintenance] indeterminate: SetCode=" .. tostring(setCode) .. " readCode=" .. tostring(readCode) .. " readValueKind=" .. tostring(type(readValue)) .. "; stopped without retry")
		end
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 僅檢查已在場的指定維護者；不輪詢、不建立計時器。
		if self.maintenanceUserId ~= "" then self:TrySeedGate(self.maintenanceUserId) end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		-- 只接受服務端登入事件中的指定使用者，不提供客戶端 RPC。
		if event == nil or event.UserId == nil then return end
		self:TrySeedGate(event.UserId)
	end
end
