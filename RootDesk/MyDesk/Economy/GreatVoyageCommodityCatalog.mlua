			{ id = "commodity_ereve_93", sourceRow = 93, displayName = "夢之石", price = 150000, originId = "ereve", sourceRegion = "耶雷弗", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "astral", description = "製作西格諾斯光之山戒指所需的神祕石材，以軟墊隔開收存。名字像睡前故事，珠寶工匠卻會認真檢查每一塊。", iconRuid = "044f7ee7c68f4e5695b0163ed2f18af2", nativeResourceRuid = "044f7ee7c68f4e5695b0163ed2f18af2", iconType = "sprite", originalItemId = 4021019, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "꿈의 돌" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/044f7ee7c68f4e5695b0163ed2f18af2" }, replacementForName = nil, researchNote = nil, demands = { forest = 3.00, rien = 1.00, sky = 5.00, aqua = 0.80, ludus = 1.50, nihal = 4.00, mulung = 1.25, leafre = 2.00, edelstein = 0.50, japan = 0.65 } },
			{ id = "commodity_ereve_94", sourceRow = 94, displayName = "黑暗碎片", price = 120000, originId = "ereve", sourceRegion = "耶雷弗", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "dark", description = "殘留守護西格諾斯之騎士力量的碎片，封裝於分格內匣。外表只是零散殘片，來歷卻牽連著整支騎士團。", iconRuid = "f836c9137f824f6cae68c082ee33c39f", nativeResourceRuid = "f836c9137f824f6cae68c082ee33c39f", iconType = "sprite", originalItemId = 4009156, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Piece of Darkness", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "어둠의 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Piece_of_Darkness", "https://maplestorywiki.net/w/Empress_Set" }, replacementForName = "Dark Fragment", researchNote = "這是 ETC Piece of Darkness（ID 4009156），與 CRA consume Piece of Time / Anguish / Destruction 三件不同；原作掉落/套裝來源證據不等同於可交易證據，本作貨運交易是本遊戲封裝規則。", demands = { forest = 3.00, rien = 0.65, sky = 1.25, aqua = 0.80, ludus = 1.50, nihal = 4.00, mulung = 1.00, leafre = 2.50, edelstein = 2.00, japan = 5.00 } },
			{ id = "commodity_ereve_95", sourceRow = 95, displayName = "毀滅碎片", price = 135000, originId = "ereve", sourceRegion = "耶雷弗", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "destruction", description = "蘊含西格諾斯破壞力量的碎片，依批次封存裝箱。與普通礦料混放的風險，首先就是被不識貨的人低估了。", iconRuid = "e343e1195459417cba07f3624ecb0351", nativeResourceRuid = "e343e1195459417cba07f3624ecb0351", iconType = "sprite", originalItemId = 2434588, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Black Destruction Fragment", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "검은 파괴의 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 2.50, rien = 2.00, sky = 1.25, aqua = 0.80, ludus = 1.50, nihal = 3.00, mulung = 1.00, leafre = 4.00, edelstein = 5.00, japan = 0.65 } },
			{ id = "commodity_ereve_96", sourceRow = 96, displayName = "西格諾斯光之山戒指配方", price = 240000, originId = "ereve", sourceRegion = "耶雷弗", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "holy_recipe", description = "記載西格諾斯光之山戒指製法的配方，按份平放於防潮內盒。夢之石等材料尚未備齊前，紙上的華麗仍只是構想。", iconRuid = "016121af3b754fbe83edded197a0acac", nativeResourceRuid = "016121af3b754fbe83edded197a0acac", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Cygnus Kohinoor Ring Recipe", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "시그너스의 코히누르 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cygnus_Kohinoor_Ring", "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = nil, demands = { forest = 4.00, rien = 1.25, sky = 3.00, aqua = 0.80, ludus = 1.00, nihal = 2.50, mulung = 2.00, leafre = 1.50, edelstein = 0.50, japan = 0.65 } },
			{ id = "commodity_ereve_97", sourceRow = 97, displayName = "西格諾斯靈魂碎片", price = 200000, originId = "ereve", sourceRegion = "耶雷弗", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "royal_soul", description = "收存著西格諾斯部分靈魂力量的碎片，各自封入小匣。整箱安靜無聲，名字卻足以讓買家重新端正看貨的態度。", iconRuid = "10a8221c22074da3b8ad72ed454357ce", nativeResourceRuid = "10a8221c22074da3b8ad72ed454357ce", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Cygnus's Soul Shard", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "시그너스의 소울 조각" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cygnus%27s_Soul_Shard" }, replacementForName = nil, researchNote = nil, demands = { forest = 4.00, rien = 1.25, sky = 3.00, aqua = 0.50, ludus = 0.80, nihal = 2.50, mulung = 2.00, leafre = 1.50, edelstein = 0.65, japan = 1.00 } },
			{ id = "commodity_rien_109", sourceRow = 109, displayName = "穆魯毛球", price = 2000, originId = "rien", sourceRegion = "瑞恩", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "textile", description = "帶著寒冷氣息的白色小毛球，輕輕聚在箱內。遠看像收集起來的雪球，摸上去才知道是細細的絨毛。", iconRuid = "1d677902e1cc48a8a0cf2a25e21323a3", nativeResourceRuid = "1d677902e1cc48a8a0cf2a25e21323a3", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Muru's Furball", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "무루의 털뭉치" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, ereve = 1.41, sky = 1.44, aqua = 1.23, ludus = 1.47, nihal = 1.20, mulung = 1.35, leafre = 1.26, edelstein = 1.32, japan = 1.29 } },
			{ id = "commodity_rien_110", sourceRow = 110, displayName = "穆魯帕毛球", price = 2500, originId = "rien", sourceRegion = "瑞恩", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "textile", description = "絨毛間黏著小葉片的毛球，保持原貌分袋收存。葉子不是裝箱時混入的雜物，而是這批毛料有趣的辨識點。", iconRuid = "dc19d29b672d43ca99f384ff83637814", nativeResourceRuid = "dc19d29b672d43ca99f384ff83637814", iconType = "sprite", originalItemId = 4000494, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Murupa's Furball", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "무루파의 털뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, ereve = 1.41, sky = 1.44, aqua = 1.23, ludus = 1.47, nihal = 1.20, mulung = 1.35, leafre = 1.26, edelstein = 1.32, japan = 1.29 } },
			{ id = "commodity_rien_111", sourceRow = 111, displayName = "穆魯皮亞毛球", price = 3000, originId = "rien", sourceRegion = "瑞恩", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "textile", description = "看起來像有什麼正從裡面長出來的毛球，蓬鬆地排滿內箱。介於毛料與小盆栽之間的模樣，總讓人多看一眼。", iconRuid = "af84c0e526784d649dcdd04bbd58a619", nativeResourceRuid = "af84c0e526784d649dcdd04bbd58a619", iconType = "sprite", originalItemId = 4000495, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "무루피아의 털뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/af84c0e526784d649dcdd04bbd58a619" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, ereve = 1.41, sky = 1.44, aqua = 1.23, ludus = 1.47, nihal = 1.20, mulung = 1.35, leafre = 1.26, edelstein = 1.32, japan = 1.29 } },
			{ id = "commodity_rien_112", sourceRow = 112, displayName = "穆魯穆魯毛球", price = 3500, originId = "rien", sourceRegion = "瑞恩", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "輕輕黏在一起便像小雪人的毛球，裝箱時盡量保留輪廓。明明是原料，排成一列後卻很像等待出發的乘客。", iconRuid = "454accd7510240448cd8d9b2e42f1d78", nativeResourceRuid = "454accd7510240448cd8d9b2e42f1d78", iconType = "sprite", originalItemId = 4000496, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Murumuru's Furball", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "무루무루의 털뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_rien_113", sourceRow = 113, displayName = "穆魯昆毛球", price = 4000, originId = "rien", sourceRegion = "瑞恩", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "原本覆在尖角周圍的毛球，保留著不太規則的外形。看似只有一團軟毛，來處卻比想像中多了一點鋒利。", iconRuid = "d71dd12f6dff4f3a9daa1b7dfd5862c0", nativeResourceRuid = "d71dd12f6dff4f3a9daa1b7dfd5862c0", iconType = "sprite", originalItemId = 4000497, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "무루쿤의 털뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/d71dd12f6dff4f3a9daa1b7dfd5862c0" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_rien_114", sourceRow = 114, displayName = "瓦礫碎片", price = 6000, originId = "rien", sourceRegion = "瑞恩海峽", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mineral", description = "稜角不齊的瓦礫碎塊，大小混雜，細粉沉在箱底。買家先辨材質，再挑能重新利用的部分，不是每塊碎石都藏著寶物。", iconRuid = "184829e852ab4810898f5bb72b9db8a3", nativeResourceRuid = "184829e852ab4810898f5bb72b9db8a3", iconType = "sprite", originalItemId = 2431057, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Rubble", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "화석 부스러기" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.40, sky = 1.80, aqua = 1.10, ludus = 1.70, nihal = 1.90, mulung = 1.30, leafre = 1.50, edelstein = 2.00, japan = 1.00 } },
			{ id = "commodity_rien_115", sourceRow = 115, displayName = "惡臭油污", price = 7500, originId = "rien", sourceRegion = "瑞恩海峽", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "oil", description = "黏稠油污分桶密封，外箱另加防漏襯層。這批貨辨認起來不太需要標籤，封口稍有疏漏，氣味就會先行報到。", iconRuid = "5cb32d1cb1eb4d34baaafb166ddd14f2", nativeResourceRuid = "5cb32d1cb1eb4d34baaafb166ddd14f2", iconType = "sprite", originalItemId = 4034919, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Stinky Oil", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "끈끈한 기름" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Polluter_Barrel" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.10, ereve = 1.00, sky = 1.20, aqua = 1.60, ludus = 1.90, nihal = 1.70, mulung = 1.30, leafre = 1.40, edelstein = 2.00, japan = 1.50 } },
			{ id = "commodity_sky_135", sourceRow = 135, displayName = "星光精靈星星碎片", price = 14800, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "astral", description = "星光精靈留下的星形碎片，分格鋪在深色內襯上。細小光芒聚在一起，像替貨箱裝進了一角夜空。", iconRuid = "24f6b7a6e22c426b9d27f197ecb3f4d1", nativeResourceRuid = "24f6b7a6e22c426b9d27f197ecb3f4d1", iconType = "sprite", originalItemId = 4000059, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Star Pixie's Starpiece", nameVerificationStatus = "unresolved", sourceNameKo = { "반짝이는 별", "스타픽시의 별조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Star_Pixie%27s_Starpiece" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.44, ereve = 1.41, rien = 1.29, aqua = 1.26, ludus = 1.35, nihal = 1.47, mulung = 1.32, leafre = 1.38, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_sky_136", sourceRow = 136, displayName = "月光精靈月亮碎片", price = 14800, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "astral", description = "帶著月光般光澤的碎片，以薄紙隔開收存。與耀眼的寶石相比，它們更像安靜停在箱底的一片月色。", iconRuid = "38b6acb253d94d2abc5c1dfbde19b4f5", nativeResourceRuid = "38b6acb253d94d2abc5c1dfbde19b4f5", iconType = "sprite", originalItemId = 4000060, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Lunar Pixie's Moonpiece", nameVerificationStatus = "unresolved", sourceNameKo = { "루나픽시의 달조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Lunar_Pixie%27s_Moonpiece" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.44, ereve = 1.41, rien = 1.29, aqua = 1.26, ludus = 1.35, nihal = 1.47, mulung = 1.32, leafre = 1.38, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_sky_137", sourceRow = 137, displayName = "日光精靈太陽碎片", price = 16000, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "astral", description = "日光精靈留下的明亮碎片，整齊排入有蓋內匣。箱蓋掀起時，耀眼的光澤往往比貨單更先吸引目光。", iconRuid = "d3b052a8877a4460bb801c4aebea442c", nativeResourceRuid = "d3b052a8877a4460bb801c4aebea442c", iconType = "sprite", originalItemId = 4000061, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Luster Pixie's Sunpiece", nameVerificationStatus = "unresolved", sourceNameKo = { "러스터픽시의 태양조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Luster_Pixie%27s_Sunpiece" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.70, rien = 1.30, aqua = 1.20, ludus = 1.50, nihal = 1.90, mulung = 1.40, leafre = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_138", sourceRow = 138, displayName = "幼獨角獅硬角", price = 14000, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "animal", description = "幼獨角獅留下的小型硬角，按完整程度分類。角身不算巨大，收集成箱後，仍能看出一排排俐落的尖端。", iconRuid = "72fe27116f294c5abece7a1e97cf1359", nativeResourceRuid = "72fe27116f294c5abece7a1e97cf1359", iconType = "sprite", originalItemId = 4000073, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Solid Horn", nameVerificationStatus = "unresolved", sourceNameKo = { "단단한 뿔" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestory.fandom.com/wiki/Jr._Lioner" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.44, rien = 1.32, aqua = 1.29, ludus = 1.26, nihal = 1.41, mulung = 1.47, leafre = 1.50, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_sky_139", sourceRow = 139, displayName = "食人花種子", price = 15000, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "seed", description = "帶毒的食人花種子，分袋封好並加上醒目標記。它們尚未長出葉子，就已經不適合混進一般穀物箱。", iconRuid = "ed21ecda52ac4965b8feefb0e9ce6c47", nativeResourceRuid = "ed21ecda52ac4965b8feefb0e9ce6c47", iconType = "sprite", originalItemId = 4000058, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Nependeath Seed", nameVerificationStatus = "unresolved", sourceNameKo = { "네펜데스의 씨앗" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Nependeath" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.90, ereve = 1.50, rien = 1.70, aqua = 1.40, ludus = 1.30, nihal = 1.80, mulung = 2.00, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_140", sourceRow = 140, displayName = "食人花蜂蜜", price = 18000, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "honey", description = "從食人花取得的蜂蜜，盛在封口緊密的罐子裡。蜜色誘人，商品名稱卻很誠實地提醒了採集地點。", iconRuid = "c1cb9dc5108b4feabc20f40c745fc218", nativeResourceRuid = "c1cb9dc5108b4feabc20f40c745fc218", iconType = "sprite", originalItemId = 2022039, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Nependeath's Honey", nameVerificationStatus = "unresolved", sourceNameKo = { "네펜데스의 꿀" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Nependeath%27s_Honey" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.50, rien = 1.90, aqua = 1.80, ludus = 1.30, nihal = 1.40, mulung = 2.00, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_141", sourceRow = 141, displayName = "小石球外殼碎片", price = 15200, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mineral", description = "帶著弧面的堅硬石殼，邊緣仍能看出破裂痕跡。碼放整齊後，像一箱被拆散的小型石製盔甲。", iconRuid = "0fa0670f6168431f9c7d14ef54cf8392", nativeResourceRuid = "0fa0670f6168431f9c7d14ef54cf8392", iconType = "sprite", originalItemId = 4000083, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Jr. Sentinel Shellpiece", nameVerificationStatus = "unresolved", sourceNameKo = { "주니어 스톤볼의 돌조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.40, rien = 1.20, aqua = 1.10, ludus = 1.70, nihal = 1.90, mulung = 1.30, leafre = 1.50, edelstein = 2.00, japan = 1.00 } },
			{ id = "commodity_sky_142", sourceRow = 142, displayName = "黑利堤毛球", price = 15400, originId = "sky", sourceRegion = "天空城", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "黑利堤留下的細軟毛球，以輕網袋收住散毛。輕飄飄的毛絨容易浮起，清點時不宜對著箱口大口吹氣。", iconRuid = "cc0a9826c88a4f90893dee1ac294ed50", nativeResourceRuid = "cc0a9826c88a4f90893dee1ac294ed50", iconType = "sprite", originalItemId = 4000087, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Dark Leatty Furball", nameVerificationStatus = "unresolved", sourceNameKo = { "다크 리티의 털뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_sky_143", sourceRow = 143, displayName = "月石", price = 180000, originId = "sky", sourceRegion = "天空城", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "astral", description = "挑選過的月石，以布袋分裝，保留礦面的自然光澤。名稱很適合吟遊詩人，成色與裂隙則留給礦商判斷。", iconRuid = "980bf14460cb4a6ba6abcf09b2fb53ad", nativeResourceRuid = "980bf14460cb4a6ba6abcf09b2fb53ad", iconType = "sprite", originalItemId = 4011007, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Moon Rock", nameVerificationStatus = "unresolved", sourceNameKo = { "달의 돌" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Moon_Rock" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.70, rien = 1.30, aqua = 1.20, ludus = 1.50, nihal = 1.90, mulung = 1.40, leafre = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_144", sourceRow = 144, displayName = "無限飛鏢配方", price = 120000, originId = "sky", sourceRegion = "天空城", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "weapon_recipe", description = "記載無限飛鏢製法的配方，按份平整收存於防潮內匣。這箱賣的是製作方法，不是取之不盡的成品。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 2510260, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Infinite Throwing-Knives Recipe", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = "原作配方存在；舊版道具手冊列 ID 2510260。MSW 英韓精確查詢未取到可由名稱標籤確認的配方 sprite；曾見候選 4036709 無名稱標籤，不能當圖示證據。", demands = { forest = 1.60, ereve = 1.80, rien = 1.40, aqua = 1.00, ludus = 1.50, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.20, japan = 1.10 } },
			{ id = "commodity_sky_145", sourceRow = 145, displayName = "特殊艾利傑變身藥水配方", price = 90000, originId = "sky", sourceRegion = "天空城", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "alchemy_recipe", description = "以艾利傑為變身對象的藥水配方，整份捲收裝箱。名字指的是成品要變出的模樣，不是配方作者的署名。", iconRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", nativeResourceRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", iconType = "sprite", originalItemId = 2512046, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-shared-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Special Eliza Transform Potion Recipe", nameVerificationStatus = "unresolved", sourceNameKo = { "스페셜 엘리쟈 변신 포션 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestory.fandom.com/wiki/Special_Eliza_Transform_Potion" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.30, rien = 1.50, aqua = 1.20, ludus = 1.00, nihal = 2.00, mulung = 1.90, leafre = 1.70, edelstein = 1.60, japan = 1.10 } },
			{ id = "commodity_sky_151", sourceRow = 151, displayName = "赫克拉尾巴", price = 16000, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "覆著褐色粗毛的尾巴，整理後成束收妥。質感不如細絨柔滑，卻保留著雪原野獸粗獷的模樣。", iconRuid = "b76dba7e1ee5486fbfed28a0c9bc89f1", nativeResourceRuid = "b76dba7e1ee5486fbfed28a0c9bc89f1", iconType = "sprite", originalItemId = 4000051, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Hector Tail", nameVerificationStatus = "unresolved", sourceNameKo = { "헥터의 꼬리" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Hector_Tail" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_sky_152", sourceRow = 152, displayName = "白狼尾巴", price = 18000, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "長著柔軟白毛的狼尾，順著毛向分層鋪放。貨色是否漂亮，一眼就能看出；壓亂後要整理回來卻沒那麼容易。", iconRuid = "20d20a2048c64c1ebc31360488e4bbf5", nativeResourceRuid = "20d20a2048c64c1ebc31360488e4bbf5", iconType = "sprite", originalItemId = 4000052, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "White Fang Tail", nameVerificationStatus = "unresolved", sourceNameKo = { "화이트팽의 꼬리" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/White_Fang_Tail" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_sky_153", sourceRow = 153, displayName = "雪吉拉之角", price = 24000, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "堅硬耐損的雪吉拉角，根部與尖端分別固定。厚實角質藏在粗獷外形之下，是一箱不能只看重量的材料。", iconRuid = "7e52f685e9eb44b4a78055b7b176ec54", nativeResourceRuid = "7e52f685e9eb44b4a78055b7b176ec54", iconType = "sprite", originalItemId = 4000049, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Yeti Horn", nameVerificationStatus = "unresolved", sourceNameKo = { "예티의 뿔" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Yeti_Horn" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_154", sourceRow = 154, displayName = "黑色雪吉拉之角", price = 26000, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "黑色雪吉拉留下的硬角，整批按形狀排入長箱。深色角面讓細小缺口不易察覺，驗貨時得轉著角度看。", iconRuid = "dffa55be965e4cc4a3c4f4ca86c5a047", nativeResourceRuid = "dffa55be965e4cc4a3c4f4ca86c5a047", iconType = "sprite", originalItemId = 4000056, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Dark Yeti Horn", nameVerificationStatus = "unresolved", sourceNameKo = { "다크 예티의 뿔" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Dark_Yeti_Horn" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_155", sourceRow = 155, displayName = "狼人的腳趾甲", price = 24400, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "狼人留下的尖銳趾甲，彎曲尖端套上護套。數量再多也不能隨手抓一把，這不是普通的裝飾碎片。", iconRuid = "6510196b6e7442e4b0d46adba7fca98b", nativeResourceRuid = "6510196b6e7442e4b0d46adba7fca98b", iconType = "sprite", originalItemId = 4000053, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Werewolf Claw", nameVerificationStatus = "unresolved", sourceNameKo = { "웨어울프의 발톱" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Werewolf_Claw" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_156", sourceRow = 156, displayName = "狼人首領的腳趾甲", price = 28000, originId = "sky", sourceRegion = "冰原雪域", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "極難折斷的堅硬趾甲，逐枚包裹後入箱。原本屬於狼人首領的利爪，如今仍是很不好伺候的貨物。", iconRuid = "4d817b470ecb434cbd4f072b450d446e", nativeResourceRuid = "4d817b470ecb434cbd4f072b450d446e", iconType = "sprite", originalItemId = 4000054, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Lycanthrope Toenail", nameVerificationStatus = "unresolved", sourceNameKo = { "라이칸스로프의 발톱" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Lycanthrope_Toenail" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_162", sourceRow = 162, displayName = "殭屍遺失的牙齒", price = 24800, originId = "sky", sourceRegion = "廢棄礦坑", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "腐朽而容易碎裂的牙齒，以小袋分裝，避免顛簸磨成粉末。這箱貨最怕的不是咬人，而是抵港時只剩牙屑。", iconRuid = "28c35a26ac304769ba34bee560cba413", nativeResourceRuid = "28c35a26ac304769ba34bee560cba413", iconType = "sprite", originalItemId = 4000069, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Zombie's Lost Molar", nameVerificationStatus = "unresolved", sourceNameKo = { "이빨빠진 좀비의 어금니", "좀비의 잃어버린 어금니" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_163", sourceRow = 163, displayName = "小獵犬尖牙", price = 22000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "小巧卻緊密堅硬的尖牙，按尺寸排入淺格。沒有巨獸獠牙的排場，但完整的牙尖仍值得仔細保護。", iconRuid = "3ae00b8c436a4d5bb63b8b8129b04860", nativeResourceRuid = "3ae00b8c436a4d5bb63b8b8129b04860", iconType = "sprite", originalItemId = 4000078, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Junior Bulldog's Fang", nameVerificationStatus = "unresolved", sourceNameKo = { "주니어 불독의 송곳니" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Junior_Bulldog%27s_Fang" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_sky_164", sourceRow = 164, displayName = "飛行眼翅膀", price = 20000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "feather", description = "帶刺又沾著污痕的翅膀，逐片隔開收納。不是羽毛店會掛在門口招客的貨，倒很容易讓研究者認出來源。", iconRuid = "79c9115d5ab847638aea0ad7a500d2b1", nativeResourceRuid = "79c9115d5ab847638aea0ad7a500d2b1", iconType = "sprite", originalItemId = 4000076, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Fly-Eye Wing", nameVerificationStatus = "unresolved", sourceNameKo = { "플라이아이의 날개" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Fly-Eye_Wing" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.50, rien = 1.90, aqua = 1.10, ludus = 1.70, nihal = 1.30, mulung = 1.40, leafre = 1.20, edelstein = 1.00, japan = 2.00 } },
			{ id = "commodity_sky_165", sourceRow = 165, displayName = "火焰炸彈的火種", price = 24000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "fire", description = "仍散發灼熱氣息的火種，分置於耐熱容器內。箱外的警示只有一個重點：它是貨物，不是貨艙的照明設備。", iconRuid = "273f53b99c354e27809dd3ca9b079f06", nativeResourceRuid = "273f53b99c354e27809dd3ca9b079f06", iconType = "sprite", originalItemId = 4000081, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Firebomb Flame", nameVerificationStatus = "unresolved", sourceNameKo = { "파이어봄의 불씨" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Firebomb_Flame" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.40, rien = 2.00, aqua = 1.00, ludus = 1.80, nihal = 1.50, mulung = 1.30, leafre = 1.20, edelstein = 1.90, japan = 1.10 } },
			{ id = "commodity_sky_166", sourceRow = 166, displayName = "水中信紙眼飾", price = 250000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory", description = "名叫信紙，實際上是與殘暴炎魔相關的眼部飾品。逐件裝入小盒後，這箱看起來更像珠寶貨，而不是郵件。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Aquatic Letter Eye Accessory", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://www.grandislibrary.com/content/boss-matchmaking-pre-quests" }, replacementForName = nil, researchNote = "現代原作有 Aquatic Letter Eye Accessory（Zakum 普通模式以上獎勵）；本輪精確 MSW 英韓查詢未取到名稱吻合 icon，item ID 未從可靠來源核定。", demands = { forest = 1.25, ereve = 5.00, rien = 1.00, aqua = 0.80, ludus = 1.50, nihal = 0.65, mulung = 2.00, leafre = 2.50, edelstein = 0.50, japan = 3.00 } },
			{ id = "commodity_sky_167", sourceRow = 167, displayName = "凝聚力量的結晶石", price = 300000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "energy", description = "以力量結晶為主體的臉部飾品，連同配戴結構一併固定裝盒。驗貨除了看晶體，也要檢查那些容易被忽略的細部。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 1012478, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Condensed Power Crystal", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://mxd.dvg.cn/item_info.php?id=1012478&region=KMS" }, replacementForName = nil, researchNote = "現代原作有 Condensed Power Crystal，該公開 KMS/TMS 對照頁列 ID 1012478；MSW 精確英韓查詢未找到名稱吻合 icon，強力結晶候選名稱不同，不錯配。", demands = { forest = 2.50, ereve = 2.00, rien = 0.65, aqua = 0.50, ludus = 3.00, nihal = 5.00, mulung = 1.00, leafre = 1.25, edelstein = 4.00, japan = 0.80 } },
			{ id = "commodity_sky_168", sourceRow = 168, displayName = "憤怒的殘暴炎魔腰帶", price = 420000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory", description = "帶著殘暴炎魔名號的腰帶，捲收時以厚布護住帶扣。粗獷的造型，即使整齊躺在貨箱裡也不太像日常服飾。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Enraged Zakum Belt", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestory.fandom.com/wiki/Zakum" }, replacementForName = nil, researchNote = "Enraged Zakum Belt 是原作首領裝備；目前精確 MSW 英韓搜尋未找到可確認的原生裝備 icon，item ID 未核定。", demands = { forest = 1.25, ereve = 5.00, rien = 1.00, aqua = 0.80, ludus = 1.50, nihal = 0.65, mulung = 2.00, leafre = 2.50, edelstein = 0.50, japan = 3.00 } },
			{ id = "commodity_sky_169", sourceRow = 169, displayName = "憤怒的殘暴炎魔披風", price = 420000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory", description = "氣勢鮮明的殘暴炎魔披風，沿著摺線分層收妥。展開才能看清完整樣貌，裝箱時則得顧好邊緣與裝飾。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Enraged Zakum Cape", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestory.fandom.com/wiki/Zakum" }, replacementForName = nil, researchNote = "Enraged Zakum Cape 是原作首領裝備；目前精確 MSW 英韓搜尋未找到可確認的原生裝備 icon，item ID 未核定。", demands = { forest = 1.25, ereve = 5.00, rien = 1.00, aqua = 0.80, ludus = 1.50, nihal = 0.65, mulung = 2.00, leafre = 2.50, edelstein = 0.50, japan = 3.00 } },
			{ id = "commodity_sky_170", sourceRow = 170, displayName = "殘暴炎魔靈魂碎片", price = 350000, originId = "sky", sourceRegion = "廢棄礦坑", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "fire_soul", description = "凝聚著殘暴炎魔部分靈魂力量的碎片，各自封存在小匣中。與一般礦石相比，這箱貨的來歷遠比外形沉重。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Zakum's Soul Shard (Sealed Cargo)", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Zakum%27s_Soul_Shard" }, replacementForName = nil, researchNote = "原作 Soul Shard 拾取後直接登錄收藏；封裝貨運為本作規則。", demands = { forest = 3.00, ereve = 2.50, rien = 4.00, aqua = 0.50, ludus = 1.25, nihal = 5.00, mulung = 1.00, leafre = 1.50, edelstein = 0.80, japan = 0.65 } },
			{ id = "commodity_aqua_183", sourceRow = 183, displayName = "蝦肉", price = 15400, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "seafood", description = "整理過的蝦肉分包排入保冷箱，肉色與彈性都是驗貨重點。這批貨的行情，往往比其他商品更在意航程長短。", iconRuid = "b6b586fc32e44fef92e61b5c5ef92edb", nativeResourceRuid = "b6b586fc32e44fef92e61b5c5ef92edb", iconType = "sprite", originalItemId = 4000166, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Shrimp Meat", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "새우살" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.40, rien = 1.90, sky = 1.60, ludus = 1.70, nihal = 1.80, mulung = 2.00, leafre = 1.30, edelstein = 1.10, japan = 1.20 } },
			{ id = "commodity_aqua_184", sourceRow = 184, displayName = "海馬之角", price = 15200, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "animal", description = "海馬留下的硬角，依形狀分組固定。細緻的角面適合近看，粗手粗腳地倒出整箱，只會增加碎角的比例。", iconRuid = "0e9ba5d98ec64ec7aa4c1c4c61cba623", nativeResourceRuid = "0e9ba5d98ec64ec7aa4c1c4c61cba623", iconType = "sprite", originalItemId = 4000163, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "해마의 뿔" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/0e9ba5d98ec64ec7aa4c1c4c61cba623" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.44, rien = 1.32, sky = 1.38, ludus = 1.26, nihal = 1.41, mulung = 1.47, leafre = 1.50, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_aqua_185", sourceRow = 185, displayName = "海馬尾巴", price = 15200, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "animal", description = "捲曲的海馬尾巴分排收存，保留原有的彎度。乍看像一箱奇形怪狀的小鉤子，近看才知道是海中的生物材料。", iconRuid = "a3a2f6b4252c4a2b9111ebb9d6c9bc5e", nativeResourceRuid = "a3a2f6b4252c4a2b9111ebb9d6c9bc5e", iconType = "sprite", originalItemId = 4000161, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "해마의 꼬리" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/a3a2f6b4252c4a2b9111ebb9d6c9bc5e" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.44, rien = 1.32, sky = 1.38, ludus = 1.26, nihal = 1.41, mulung = 1.47, leafre = 1.50, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_aqua_186", sourceRow = 186, displayName = "海豹肉", price = 14400, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "seafood", description = "海豹肉切分後密封保冷，箱內留有隔層避免擠壓。對長途交易而言，妥善保存比把貨箱塞得毫無空隙更重要。", iconRuid = "7f5808bc437b4f45b24ea058a3a47c52", nativeResourceRuid = "7f5808bc437b4f45b24ea058a3a47c52", iconType = "sprite", originalItemId = 4000157, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Seal Meat", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "물개고기" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.32, rien = 1.47, sky = 1.38, ludus = 1.41, nihal = 1.44, mulung = 1.50, leafre = 1.29, edelstein = 1.23, japan = 1.26 } },
			{ id = "commodity_aqua_187", sourceRow = 187, displayName = "海豹皮", price = 16000, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "經過處理的海豹皮，順著皮面捲束裝箱。攤開後才能檢查完整度，是皮革工坊會逐張挑選的材料。", iconRuid = "047a8b665e9f4e559949885c26ea3b12", nativeResourceRuid = "047a8b665e9f4e559949885c26ea3b12", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Seal Skin", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "물개가죽" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, ludus = 1.90, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_aqua_188", sourceRow = 188, displayName = "泡泡魚的思念", price = 16000, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "來自泡泡魚體內的小紅寶石，分格鋪在絨布上。名字像裝了一箱心事，珠寶商看見的卻是光澤與成色。", iconRuid = "6bae8262c48c4e16a63aa8d6841fc87b", nativeResourceRuid = "6bae8262c48c4e16a63aa8d6841fc87b", iconType = "sprite", originalItemId = 4000164, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "버블피쉬의 마음" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/6bae8262c48c4e16a63aa8d6841fc87b" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, ludus = 1.20, nihal = 1.70, mulung = 1.60, leafre = 1.50, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_aqua_189", sourceRow = 189, displayName = "華麗花瓣", price = 18000, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "herb", description = "花魚頭上的華麗花瓣，輕輕疊放在淺層內盒。明明採自海中，看起來卻像剛從花園整理出的鮮豔花材。", iconRuid = "869b0fbba0214a278a46d5b52bdb381d", nativeResourceRuid = "869b0fbba0214a278a46d5b52bdb381d", iconType = "sprite", originalItemId = 4000165, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "화려한 꽃잎" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/869b0fbba0214a278a46d5b52bdb381d" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.30, rien = 1.60, sky = 1.40, ludus = 1.10, nihal = 1.90, mulung = 2.00, leafre = 1.20, edelstein = 1.00, japan = 1.80 } },
			{ id = "commodity_aqua_190", sourceRow = 190, displayName = "一捆蝦虎魚", price = 21200, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "seafood", description = "綑束好的蝦虎魚逐束排入保冷貨箱，滑溜的魚身被繫得妥妥當當。商品名說的是一捆，這裡賣的可是整箱。", iconRuid = "3e9c454cec82428f9e36df49316cdd25", nativeResourceRuid = "3e9c454cec82428f9e36df49316cdd25", iconType = "sprite", originalItemId = 4000179, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "A Bundle of Goby", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "망둥이 묶음" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = "Bundle of Fish Fry", researchNote = "wrapper sprite search exact Korean title; resource tags exact original item iconRaw subPath confirms item ID.", demands = { forest = 1.50, ereve = 1.40, rien = 1.90, sky = 1.60, ludus = 1.70, nihal = 1.80, mulung = 2.00, leafre = 1.30, edelstein = 1.10, japan = 1.20 } },
			{ id = "commodity_aqua_191", sourceRow = 191, displayName = "堅硬的尖刺", price = 24000, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "從海中魔物取得的硬刺，以護套包住尖端。外箱沒有漂亮裝飾，卻很認真地畫了幾個不能徒手亂抓的標記。", iconRuid = "232025965a3742da8c0ad8c9b1c41a1e", nativeResourceRuid = "232025965a3742da8c0ad8c9b1c41a1e", iconType = "sprite", originalItemId = 4032982, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Hard Needle", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "단단한 송곳니" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.40, sky = 1.60, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_aqua_192", sourceRow = 192, displayName = "石灰粉瓶", price = 28000, originId = "aqua", sourceRegion = "水世界", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mineral", description = "由骨魚骨頭製成的石灰粉，分瓶封口並直立裝箱。看似普通白粉，來源卻比礦場裡挖出的石料古怪得多。", iconRuid = "fe264173b17e4dc38fc3e5f8625d171b", nativeResourceRuid = "fe264173b17e4dc38fc3e5f8625d171b", iconType = "sprite", originalItemId = 4000182, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Lime Powder Bottle", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "석회가루병" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://miramms.com/?base=main&db=monsters&entry=8140600&lang=en&page=database", "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc", "https://strategywiki.org/wiki/MapleStory/Drops_%28Ossyria%29" }, replacementForName = "Bone Fish's Bone", researchNote = "原名稱 Bone Fish's Bone 未能在原作資料核實；改為 Bone Fish 掉落的 Lime Powder Bottle。MSW tags subPath 04000182/info/iconRaw 對應 item ID 4000182。沿用原貨物 sourceRow、價格與需求。", demands = { forest = 1.60, ereve = 1.40, rien = 1.20, sky = 1.80, ludus = 1.70, nihal = 1.90, mulung = 1.30, leafre = 1.50, edelstein = 2.00, japan = 1.00 } },
			{ id = "commodity_aqua_193", sourceRow = 193, displayName = "無限飛鏢配方", price = 130000, originId = "aqua", sourceRegion = "水世界", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "weapon_recipe", description = "記載無限飛鏢製法的配方，按份平整收存於防潮內匣。這箱賣的是製作方法，不是取之不盡的成品。", iconRuid = "001920523e344c5f95fcce8d67ddaaaf", nativeResourceRuid = "001920523e344c5f95fcce8d67ddaaaf", iconType = "sprite", originalItemId = 2510260, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Infinite Throwing-Knives Recipe", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "무한의 수리검 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Infinite_Throwing-Knives", "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.80, rien = 1.40, sky = 1.30, ludus = 1.50, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.20, japan = 1.10 } },
			{ id = "commodity_aqua_194", sourceRow = 194, displayName = "巨人藥水配方", price = 100000, originId = "aqua", sourceRegion = "水世界", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "alchemy_recipe", description = "記載巨人藥水調製方法的配方，成份與步驟完整收存。圖紙裝得進箱子，喝下成品後能否走過門框則是另一回事。", iconRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", nativeResourceRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", iconType = "sprite", originalItemId = 2512260, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Giant Potion Recipe", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "자이언트 비약 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Giant_Potion", "https://www.maplestorydb.com/itemsinfo.php?id=2512260", "https://maplestorywiki.net/w/Seruf", "https://maplestorywiki.net/w/Desert_Giant" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.30, rien = 1.50, sky = 1.40, ludus = 1.00, nihal = 2.00, mulung = 1.90, leafre = 1.70, edelstein = 1.60, japan = 1.10 } },
			{ id = "commodity_aqua_195", sourceRow = 195, displayName = "巨居蟹貝殼床", price = 150000, originId = "aqua", sourceRegion = "水世界", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "furniture", description = "貝殼造型的床具，以木架和厚墊固定在大型貨箱裡。貨艙裝它時嫌占地方，想休息時又覺得很有道理。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 2672181, verified = false, catalogNameVerified = true, verificationStatus = "catalog-name-only-icon-unresolved", proofSource = "catalog-artwork-review", sourceNameEn = "Seruf's Clam Bed", nameVerificationStatus = "officially-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Seruf", "https://mxd.dvg.cn/itemsinfo.php?id=2672181" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.00, ereve = 4.00, rien = 3.00, sky = 5.00, ludus = 2.50, nihal = 0.65, mulung = 2.00, leafre = 1.25, edelstein = 0.80, japan = 1.50 } },
			{ id = "commodity_aqua_196", sourceRow = 196, displayName = "魚王靈魂碎片", price = 320000, originId = "aqua", sourceRegion = "水世界", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "sea_soul", description = "魚王留下的靈魂碎片，逐份封裝於帶隔層的內匣。小小一箱裝得下戰利品，卻裝不下深海巨獸原本的威勢。", iconRuid = "10a8221c22074da3b8ad72ed454357ce", nativeResourceRuid = "10a8221c22074da3b8ad72ed454357ce", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Pianus's Soul Shard", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "피아누스의 소울 조각" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Pianus%27s_Soul_Shard" }, replacementForName = nil, researchNote = nil, demands = { forest = 5.00, ereve = 3.00, rien = 1.25, sky = 4.00, ludus = 0.80, nihal = 2.50, mulung = 2.00, leafre = 1.50, edelstein = 0.65, japan = 1.00 } },
			{ id = "commodity_aqua_197", sourceRow = 197, displayName = "迷你魚王", price = 260000, originId = "aqua", sourceRegion = "水世界", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "aquarium", description = "仿照魚王模樣製成的微型模型，以軟墊保護細部。兇猛的深海身影縮進貨箱後，終於適合擺在櫥窗裡展示。", iconRuid = "360f9facfced4077a35f11ac704fcb9a", nativeResourceRuid = "360f9facfced4077a35f11ac704fcb9a", iconType = "sprite", originalItemId = 4000175, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Miniature Pianus", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "피아누스 미니어쳐" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://mapleplanet.gg/items/4000175-%ED%94%BC%EC%95%84%EB%88%84%EC%8A%A4-%EB%AF%B8%EB%8B%88%EC%96%B4%EC%B3%90", "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 3.00, rien = 2.50, sky = 5.00, ludus = 4.00, nihal = 1.25, mulung = 1.50, leafre = 1.00, edelstein = 0.65, japan = 0.80 } },
			{ id = "commodity_ludus_216", sourceRow = 216, displayName = "玩具熊棉花", price = 22400, originId = "ludus", sourceRegion = "玩具城地表", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "textile", description = "從玩具熊取得的柔軟填充棉，清理後壓成輕盈棉包。箱子看來塞得很滿，掀開卻是一片幾乎沒有重量的蓬鬆。", iconRuid = "2e7b56ddc71c4394aea01a68fbc076aa", nativeResourceRuid = "2e7b56ddc71c4394aea01a68fbc076aa", iconType = "sprite", originalItemId = 4000106, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Teddy's Cotton", nameVerificationStatus = "unresolved", sourceNameKo = { "곰인형의 솜뭉치", "부드러운 솜뭉치" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, ereve = 1.41, rien = 1.50, sky = 1.44, aqua = 1.23, nihal = 1.20, mulung = 1.35, leafre = 1.26, edelstein = 1.32, japan = 1.29 } },
			{ id = "commodity_ludus_217", sourceRow = 217, displayName = "玩具鼓", price = 22000, originId = "ludus", sourceRegion = "玩具城地表", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "toy", description = "小鼓以墊料隔開，鼓面朝向內側保護。貨箱稍有晃動就可能傳出零星鼓聲，像一支尚未排練好的小樂隊。", iconRuid = "42285050fd8040009ece90ad32864db9", nativeResourceRuid = "42285050fd8040009ece90ad32864db9", iconType = "sprite", originalItemId = 4000127, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Toy Drum", nameVerificationStatus = "unresolved", sourceNameKo = { "장난감 북" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.44, rien = 1.38, sky = 1.47, aqua = 1.32, nihal = 1.29, mulung = 1.41, leafre = 1.26, edelstein = 1.20, japan = 1.23 } },
			{ id = "commodity_ludus_218", sourceRow = 218, displayName = "玩具士兵之劍", price = 24000, originId = "ludus", sourceRegion = "玩具工廠", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "weapon", description = "玩具士兵使用的塑膠小劍，成束固定於箱內。造型很有衝鋒的氣勢，材質則誠實地提醒人別拿它當真正兵器。", iconRuid = "682ef6cc7aa64076820f7e1da4dd54f8", nativeResourceRuid = "682ef6cc7aa64076820f7e1da4dd54f8", iconType = "sprite", originalItemId = 4000110, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Toy Trojan Sword", nameVerificationStatus = "unresolved", sourceNameKo = { "장난감 병정의 칼", "장난감 칼" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 2.00, rien = 1.60, sky = 1.50, aqua = 1.30, nihal = 1.80, mulung = 1.90, leafre = 1.90, edelstein = 1.10, japan = 1.00 } },
			{ id = "commodity_ludus_219", sourceRow = 219, displayName = "時鐘發條", price = 24000, originId = "ludus", sourceRegion = "時間塔上層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mechanical", description = "細小的時鐘發條分盒收存，捲曲的金屬片彼此隔開。別看零件不起眼，少了它，漂亮的鐘面也只剩裝飾。", iconRuid = "752a314d933a45f788b43b24ad42f7d0", nativeResourceRuid = "752a314d933a45f788b43b24ad42f7d0", iconType = "sprite", originalItemId = 4000113, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Clock Spring", nameVerificationStatus = "unresolved", sourceNameKo = { "시계 태엽", "작은 태엽" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 1.50, rien = 1.20, sky = 1.60, aqua = 1.80, nihal = 1.90, mulung = 1.30, leafre = 1.10, edelstein = 1.70, japan = 1.00 } },
			{ id = "commodity_ludus_220", sourceRow = 220, displayName = "齒輪", price = 24000, originId = "ludus", sourceRegion = "時間塔上層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mechanical", description = "大小不同的齒輪按規格分類，齒面以墊片隔開。懂機械的人先看咬合與磨損，不會只挑最閃亮的那一枚。", iconRuid = "553c341196f046fb8c97ef2862854cc6", nativeResourceRuid = "553c341196f046fb8c97ef2862854cc6", iconType = "sprite", originalItemId = 4000115, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Cog", nameVerificationStatus = "unresolved", sourceNameKo = { "작은 톱니바퀴", "톱니바퀴" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 1.50, rien = 1.20, sky = 1.60, aqua = 1.80, nihal = 1.90, mulung = 1.30, leafre = 1.10, edelstein = 1.70, japan = 1.00 } },
			{ id = "commodity_ludus_221", sourceRow = 221, displayName = "藍色玩具積木", price = 24000, originId = "ludus", sourceRegion = "玩具工廠", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "toy", description = "原本構成積木巨人的藍色方塊，拆散後整齊碼放。如今安分待在箱裡，模樣與普通玩具幾乎沒有兩樣。", iconRuid = "659926f80581475b8a5c7e00d9e8750e", nativeResourceRuid = "659926f80581475b8a5c7e00d9e8750e", iconType = "sprite", originalItemId = 4000102, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Blue Toy Block", nameVerificationStatus = "unresolved", sourceNameKo = { "파란색 장난감 블록" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.60, sky = 1.90, aqua = 1.40, nihal = 1.30, mulung = 1.70, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_ludus_222", sourceRow = 222, displayName = "桌上時鐘", price = 24000, originId = "ludus", sourceRegion = "時間塔上層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mechanical", description = "仍在走動的桌上時鐘，逐座固定於內架。整箱細碎滴答聲交錯，像把一間鐘錶店搬進了貨艙。", iconRuid = "4112deed7dda4736a70939a9ee5e2e53", nativeResourceRuid = "4112deed7dda4736a70939a9ee5e2e53", iconType = "sprite", originalItemId = 4000114, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Table Clock", nameVerificationStatus = "unresolved", sourceNameKo = { "작은 시계", "탁상용 시계" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 1.50, rien = 1.20, sky = 1.60, aqua = 1.80, nihal = 1.90, mulung = 1.30, leafre = 1.10, edelstein = 1.70, japan = 1.00 } },
			{ id = "commodity_ludus_223", sourceRow = 223, displayName = "殭屍玩具熊", price = 23400, originId = "ludus", sourceRegion = "時間塔下層", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "dark", description = "外觀破舊的殭屍玩具熊，逐隻裹布收納。歪斜的輪廓與磨損布面，讓這批貨更適合怪奇收藏店而非嬰兒房。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 4000143, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Zombie Teddy Bear", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://mxd079.dvg.cn/item_info.php?id=4000143" }, replacementForName = nil, researchNote = "經典原作道具 ID 4000143；MSW 英韓精確搜尋沒有同名 ETC 圖示，僅有近似玩具圖示，故留空。", demands = { forest = 1.44, ereve = 1.20, rien = 1.23, sky = 1.32, aqua = 1.26, nihal = 1.47, mulung = 1.29, leafre = 1.41, edelstein = 1.38, japan = 1.50 } },
			{ id = "commodity_ludus_224", sourceRow = 224, displayName = "自由的靈魂", price = 26000, originId = "ludus", sourceRegion = "時間塔下層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "royal_soul", description = "以容器收存的游離靈魂，分別安置在貨箱內。標籤上寫著自由，封口卻比旁邊幾箱都還仔細。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 4000144, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Free Spirit", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://mapledb.kr/search.php?q=4000144&t=item" }, replacementForName = nil, researchNote = "經典原作道具 ID 4000144；MSW 英韓精確搜尋沒有同名 ETC 圖示，僅有自由通行證等近似詞結果，故留空。", demands = { forest = 1.90, ereve = 2.00, rien = 1.40, sky = 1.80, aqua = 1.00, nihal = 1.70, mulung = 1.60, leafre = 1.50, edelstein = 1.10, japan = 1.30 } },
			{ id = "commodity_ludus_225", sourceRow = 225, displayName = "被封印的玩具熊", price = 28000, originId = "ludus", sourceRegion = "時間塔下層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "dark", description = "帶著封印的玩具熊，以不碰傷封印的方式固定。拆箱時得分清楚哪些是包裝，哪些才是應該原封不動留下的東西。", iconRuid = "5ee3b6c1e23c491a8d3d509a16f41bb6", nativeResourceRuid = "5ee3b6c1e23c491a8d3d509a16f41bb6", iconType = "sprite", originalItemId = 4000147, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Sealed Teddy Bear", nameVerificationStatus = "unresolved", sourceNameKo = { "봉인된 테니", "봉인된 테니인형" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Sealed_Teddy_Bear" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.00, rien = 1.10, sky = 1.40, aqua = 1.20, nihal = 1.90, mulung = 1.30, leafre = 1.70, edelstein = 1.60, japan = 2.00 } },
			{ id = "commodity_ludus_226", sourceRow = 226, displayName = "束縛韁繩", price = 30000, originId = "ludus", sourceRegion = "時間塔下層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "收成圓圈的奇異韁繩，扣件與繩身分別襯墊。原本牽住了什麼已不在箱中，只剩那個不太輕鬆的名字。", iconRuid = "057c78ea73334a27addd0aaa0520efc1", nativeResourceRuid = "057c78ea73334a27addd0aaa0520efc1", iconType = "sprite", originalItemId = 4000148, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Binding Bridle", nameVerificationStatus = "unresolved", sourceNameKo = { "속박의 굴레", "속박의 손" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_ludus_227", sourceRow = 227, displayName = "扭曲的時間", price = 35000, originId = "ludus", sourceRegion = "時間塔下層", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "time", description = "被收存成貨物的異常時間，分隔安置於特製內盒。貨單記得下出貨日期，卻說不清這批東西究竟有多老。", iconRuid = "d1d062a9ab0a43c7a9b327cf00c5c20b", nativeResourceRuid = "d1d062a9ab0a43c7a9b327cf00c5c20b", iconType = "sprite", originalItemId = 4021031, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Essence of Twisted Time", nameVerificationStatus = "unresolved", sourceNameKo = { "뒤틀린 시간의 정수" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Essence_of_Twisted_Time" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.40, rien = 1.00, sky = 1.80, aqua = 1.10, nihal = 1.90, mulung = 1.20, leafre = 1.50, edelstein = 2.00, japan = 1.30 } },
