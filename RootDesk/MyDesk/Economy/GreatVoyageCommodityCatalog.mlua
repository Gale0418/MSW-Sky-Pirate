			{ id = "commodity_forest_71", sourceRow = 71, displayName = "時間碎片", price = 165000, originId = "forest", sourceRegion = "露塔必思", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "time", description = "蘊含混沌斑斑力量的碎片，分格封存在貨箱內。商人能替它標上售價，卻不保證能拿來補回錯過的船期。", iconRuid = "f2a7b33645a7451392302c1f6ffd59b4", nativeResourceRuid = "f2a7b33645a7451392302c1f6ffd59b4", iconType = "sprite", originalItemId = 2434584, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Piece of Time", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "시간의 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Piece_of_Time", "https://maplestorywiki.net/w/Root_Abyss" }, replacementForName = "Piece of Time", researchNote = "CRA consume Piece of Time 的 MSW exact Korean string 時間의 조각，consume item ID 2434584 的 iconRaw subPath 確認；原先 ID 4020009 是不同的普通 ETC 道具，已撤除錯配。保留價格與需求。", demands = { ereve = 1.25, rien = 0.50, sky = 3.00, aqua = 0.65, ludus = 5.00, nihal = 4.00, mulung = 0.80, leafre = 1.50, edelstein = 5.00, japan = 1.00 } },
			{ id = "commodity_forest_72", sourceRow = 72, displayName = "嘲弄碎片", price = 165000, originId = "forest", sourceRegion = "露塔必思", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "dark", description = "殘留混沌皮耶爾力量的碎片，外覆軟墊逐一收妥。名字像場玩笑，曾與那位小丑交手的人卻不太笑得出來。", iconRuid = "c635528b95d1409b96d56ceafe87e38e", nativeResourceRuid = "c635528b95d1409b96d56ceafe87e38e", iconType = "sprite", originalItemId = 2434585, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Piece of Mockery", nameVerificationStatus = "unresolved", sourceNameKo = { "조롱의 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Piece_of_Mockery" }, replacementForName = nil, researchNote = nil, demands = { ereve = 0.50, rien = 0.65, sky = 1.25, aqua = 0.80, ludus = 1.50, nihal = 4.00, mulung = 1.00, leafre = 2.50, edelstein = 2.00, japan = 5.00 } },
			{ id = "commodity_forest_73", sourceRow = 73, displayName = "毀滅碎片", price = 190000, originId = "forest", sourceRegion = "露塔必思", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "destruction", description = "封存著混沌貝倫力量的碎片，每份都有獨立內盒。買家看重的不是斷面的漂亮紋路，而是它背後那頭巨獸。", iconRuid = "9906221d856a457cba4f6561cd2b0484", nativeResourceRuid = "9906221d856a457cba4f6561cd2b0484", iconType = "sprite", originalItemId = 2434587, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Piece of Destruction", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "파멸의 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Piece_of_Destruction", "https://maplestorywiki.net/w/Root_Abyss" }, replacementForName = "Piece of Destruction", researchNote = "CRA consume Piece of Destruction：MSW exact Korean string 파멸의 조각，consume item ID 2434587 的 iconRaw subPath 確認；保留源列價格與需求。", demands = { ereve = 0.50, rien = 2.00, sky = 1.25, aqua = 0.80, ludus = 1.50, nihal = 3.00, mulung = 1.00, leafre = 4.00, edelstein = 5.00, japan = 0.65 } },
			{ id = "commodity_ereve_87", sourceRow = 87, displayName = "提諾的羽毛", price = 2000, originId = "ereve", sourceRegion = "耶雷弗", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "feather", description = "輕薄的小羽毛綑成細束，整齊鋪滿箱底。搬起來幾乎感覺不到重量，卻得留神別讓空港的風先把貨領走。", iconRuid = "08399e61197e44aaaa7921dedfb25614", nativeResourceRuid = "08399e61197e44aaaa7921dedfb25614", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Tino's Feather", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "티노의 깃털" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, rien = 1.47, sky = 1.44, aqua = 1.23, ludus = 1.41, nihal = 1.29, mulung = 1.32, leafre = 1.26, edelstein = 1.20, japan = 1.50 } },
			{ id = "commodity_ereve_88", sourceRow = 88, displayName = "提普的羽毛", price = 2500, originId = "ereve", sourceRegion = "耶雷弗", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "feather", description = "極容易被風吹散的羽毛，以細網袋分裝。這批貨不怕搬不動，怕的是開箱清點時，數量突然開始往天上跑。", iconRuid = "8cc1608f003a4e149a1d932fecea69b2", nativeResourceRuid = "8cc1608f003a4e149a1d932fecea69b2", iconType = "sprite", originalItemId = 4000483, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "티브의 깃털" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/8cc1608f003a4e149a1d932fecea69b2" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, rien = 1.47, sky = 1.44, aqua = 1.23, ludus = 1.41, nihal = 1.29, mulung = 1.32, leafre = 1.26, edelstein = 1.20, japan = 1.50 } },
