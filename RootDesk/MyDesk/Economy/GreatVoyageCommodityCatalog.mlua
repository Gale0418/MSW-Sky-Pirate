			{ id = "commodity_japan_414", sourceRow = 414, displayName = "巨大蟾蜍靈魂碎片", price = 450000, originId = "japan", sourceRegion = "楓城", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "folk_soul", description = "巨大蟾蜍留下的靈魂碎片，逐份封入小匣。從楓城的古怪事件一路流轉到港口，如今成了收藏架上的異鄉貨。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "catalog-name-only-icon-unresolved", proofSource = "catalog-artwork-review", sourceNameEn = "Gigatoad Soul Shard", nameVerificationStatus = "officially-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Gigatoad_Soul_Shard" }, replacementForName = nil, researchNote = nil, demands = { forest = 3.00, ereve = 1.50, rien = 0.80, sky = 4.00, aqua = 1.00, ludus = 1.25, nihal = 0.65, mulung = 2.50, leafre = 2.00, edelstein = 0.50 } }
		}
		self._T.byId = {}
		self._T.byPort = {}
		for _, good in ipairs(self._T.catalog) do
			self._T.byId[good.id] = good
			if self._T.byPort[good.originId] == nil then self._T.byPort[good.originId] = {} end
			-- 未核實原作商品不進入可購買貨架，但仍保留在完整圖鑑。
			if good.verified then table.insert(self._T.byPort[good.originId], good) end
		end
		return self._T.catalog
	end

	method any GetForPort(string portId)
		-- 等待伺服器工作階段種子同步完成，避免先快取空貨架。
		self:GetAll()
		if self.shopStockSeed <= 0 then return {} end
		if self._T.shopStockSeed ~= self.shopStockSeed then
			self._T.shopStockByPort = {}
			self._T.shopStockSeed = self.shopStockSeed
		end
		if self._T.shopStockByPort[portId] ~= nil then return self._T.shopStockByPort[portId] end
		local available = self._T.byPort[portId] or {}
		local portSeed = 0
		for index = 1, #portId do
			portSeed = (portSeed * 31 + string.byte(portId, index)) % 2147483647
		end
		local shuffled = {}
		for _, good in ipairs(available) do
			table.insert(shuffled, good)
		end
		local randomState = (self.shopStockSeed + portSeed) % 2147483647
		if randomState <= 0 then randomState = 1 end
		for index = #shuffled, 2, -1 do
			randomState = (randomState * 48271) % 2147483647
			local swapIndex = randomState % index + 1
			shuffled[index], shuffled[swapIndex] = shuffled[swapIndex], shuffled[index]
		end
		local stock = {}
		for index = 1, math.min(12, math.ceil(#shuffled * 0.6)) do table.insert(stock, shuffled[index]) end
		table.sort(stock, function(a, b) return a.sourceRow < b.sourceRow end)
		self._T.shopStockByPort[portId] = stock
		log("[CommodityCatalog] shop stock port=" .. portId .. " count=" .. tostring(#stock) .. " catalog=" .. tostring(#available))
		return stock
	end

	method any GetById(string goodId)
		-- 依圖鑑識別碼取得單筆貨物。
		self:GetAll()
		return self._T.byId[goodId]
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 由伺服器為本世界工作階段抽取種子，@Sync 讓所有客戶端重現相同貨架。
		self.shopStockSeed = _UtilLogic:RandomIntegerRange(1, 2147483646)
		log("[CommodityCatalog] shop stock seed=" .. tostring(self.shopStockSeed))
		-- 輸出圖鑑載入數量供檢查。
		log("[CommodityCatalog] entries=" .. tostring(#self:GetAll()))
	end
end
