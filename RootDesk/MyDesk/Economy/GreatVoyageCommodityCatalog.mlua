			{ id = "commodity_forest_60", sourceRow = 60, displayName = "章魚腳", price = 4000, originId = "forest", sourceRegion = "墮落城市", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "seafood", description = "帶著一排排吸盤的章魚觸手，分包置於保冷內箱。挑貨要看肉質與完整度，不能只挑那根捲得最漂亮的。", iconRuid = "294ce4fd15bb405b8c57f0ae6f7a0bce", nativeResourceRuid = "294ce4fd15bb405b8c57f0ae6f7a0bce", iconType = "sprite", originalItemId = 4000006, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Octopus Leg", nameVerificationStatus = "unresolved", sourceNameKo = { "옥토퍼스의 다리" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Octopus_Leg" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.40, rien = 1.90, sky = 1.60, aqua = 1.00, ludus = 1.70, nihal = 1.80, mulung = 2.00, leafre = 1.30, edelstein = 1.10, japan = 1.20 } },
			{ id = "commodity_forest_61", sourceRow = 61, displayName = "藍水靈大水珠", price = 4500, originId = "forest", sourceRegion = "墮落城市", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "water", description = "藍水靈留下的大水珠，分別盛在有蓋容器裡。透亮的外觀很容易讓人忘記：這批貨不是普通的飲用水。", iconRuid = "ee7a45c22990498892f74a3cc3c26fe8", nativeResourceRuid = "ee7a45c22990498892f74a3cc3c26fe8", iconType = "sprite", originalItemId = 4000037, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Bubbling's Huge Bubble", nameVerificationStatus = "unresolved", sourceNameKo = { "버블링의 큰 방울" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Bubbling%27s_Huge_Bubble" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.40, rien = 1.70, sky = 1.60, aqua = 1.00, ludus = 1.80, nihal = 2.00, mulung = 1.30, leafre = 1.20, edelstein = 1.90, japan = 1.10 } },
			{ id = "commodity_forest_62", sourceRow = 62, displayName = "刺菇菇傘", price = 5000, originId = "forest", sourceRegion = "弓箭手村", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "herb", description = "表面帶刺的菌傘，逐層墊開，避免運輸時互相刮傷。箱子看起來像在賣蘑菇，打開卻有幾分針線盒的架勢。", iconRuid = "49b3f12c200044b591eeada1ae93a38d", nativeResourceRuid = "49b3f12c200044b591eeada1ae93a38d", iconType = "sprite", originalItemId = 4000015, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Horny Mushroom Cap", nameVerificationStatus = "unresolved", sourceNameKo = { "뿔버섯의 갓", "뿔버섯의 모자" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.30, rien = 1.60, sky = 1.40, aqua = 1.50, ludus = 1.10, nihal = 1.90, mulung = 2.00, leafre = 1.20, edelstein = 1.00, japan = 1.80 } },
			{ id = "commodity_forest_63", sourceRow = 63, displayName = "火肥肥的尖牙", price = 5500, originId = "forest", sourceRegion = "勇士之村", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "animal", description = "從火肥肥取得的犬齒，清理後按形狀分排固定。彎曲的牙身與尖端一目了然，包裝不能只顧好看。", iconRuid = "bc2522ab99304e0cb8a3f752fb99fe59", nativeResourceRuid = "bc2522ab99304e0cb8a3f752fb99fe59", iconType = "sprite", originalItemId = 4000024, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Fire Boar's Tooth", nameVerificationStatus = "unresolved", sourceNameKo = { "파이어보어의 송곳니" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.80, rien = 1.40, sky = 1.60, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_forest_64", sourceRow = 64, displayName = "盧平的香蕉", price = 4500, originId = "forest", sourceRegion = "魔法森林", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "fruit", description = "盧平喜愛的香蕉，連串排入通風貨箱。果香在成熟後漸漸濃起，貨單上列的是商品，不是沿途的免費點心。", iconRuid = "19cb5a8c16654c00bfb6d153fadece14", nativeResourceRuid = "19cb5a8c16654c00bfb6d153fadece14", iconType = "sprite", originalItemId = 4000029, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Lupin's Banana", nameVerificationStatus = "exact-official-name-and-item-id", sourceNameKo = { "루팡의 바나나" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = "Monkey's Banana / Banana", researchNote = "wrapper sprite search exact Korean title; resource tags exact original item iconRaw subPath confirms item ID.", demands = { ereve = 1.50, rien = 2.00, sky = 1.70, aqua = 1.80, ludus = 1.40, nihal = 1.90, mulung = 1.30, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_forest_65", sourceRow = 65, displayName = "殭屍菇菇符咒", price = 6500, originId = "forest", sourceRegion = "奇幻村", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "從殭屍菇菇身上取得的符紙，攤平後夾入薄板保存。紙上的筆畫比紙張本身更受重視，不能把它當普通包裝紙。", iconRuid = "0cdc7593390743b98d08fbc1b720e392", nativeResourceRuid = "0cdc7593390743b98d08fbc1b720e392", iconType = "sprite", originalItemId = 4033033, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Zombie Mushmom's Charm", nameVerificationStatus = "unresolved", sourceNameKo = { "좀비머쉬맘의 부적" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.60, leafre = 1.50, edelstein = 1.00, japan = 1.10 } },
