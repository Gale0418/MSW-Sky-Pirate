			{ id = "commodity_forest_68", sourceRow = 68, displayName = "菇菇王孢子", price = 45000, originId = "forest", sourceRegion = "弓箭手村", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "spores", description = "菇菇王留下的孢子，分罐密封後裝入內匣。箱標上的菇菇畫得十分可愛，採集這批貨可沒有那麼輕鬆。", iconRuid = "5d8f687d1a5143bbb51d1fb431154f30", nativeResourceRuid = "5d8f687d1a5143bbb51d1fb431154f30", iconType = "sprite", originalItemId = 4000040, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Mushmom's Spore", nameVerificationStatus = "unresolved", sourceNameKo = { "머쉬맘의 포자", "커다란 포자" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { ereve = 0.50, rien = 0.65, sky = 1.50, aqua = 1.00, ludus = 1.25, nihal = 5.00, mulung = 4.00, leafre = 2.50, edelstein = 2.00, japan = 0.80 } },
