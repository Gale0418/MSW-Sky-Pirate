			{ id = "commodity_leafre_336", sourceRow = 336, displayName = "格瑞芬多之角", price = 80000, originId = "leafre", sourceRegion = "米納爾森林", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "animal", description = "格瑞芬多留下的角，以木托穩穩承住。看貨時不必刻意雕琢，保留原本輪廓就已足夠醒目。", iconRuid = "4cd7e33e030046bfa024093cd8a3d945", nativeResourceRuid = "4cd7e33e030046bfa024093cd8a3d945", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Griffey's Horn", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "그리프의 뿔" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Griffey" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 3.00, rien = 1.25, sky = 2.00, aqua = 1.00, ludus = 0.80, nihal = 2.50, mulung = 4.00, edelstein = 0.50, japan = 0.65 } },
			{ id = "commodity_leafre_342", sourceRow = 342, displayName = "時間碎片（神殿一般怪）", price = 45000, originId = "leafre", sourceRegion = "時間神殿", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "time", description = "時間神殿出產、蘊含時間力量的礦材，以小袋分類裝箱。遠看只是碎礦，工匠辨認的卻是其中不同於普通石料的力量。", iconRuid = "08b3b2f7dabb4f4482a8664c99683a00", nativeResourceRuid = "08b3b2f7dabb4f4482a8664c99683a00", iconType = "sprite", originalItemId = 4020009, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "시간 조각" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/08b3b2f7dabb4f4482a8664c99683a00" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.40, rien = 1.00, sky = 1.80, aqua = 1.10, ludus = 2.00, nihal = 1.90, mulung = 1.20, edelstein = 2.00, japan = 1.30 } },
			{ id = "commodity_leafre_343", sourceRow = 343, displayName = "回憶祭司布料", price = 38000, originId = "leafre", sourceRegion = "時間神殿", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "回憶祭司留下的布料，整平後依完整程度收束。縫邊與殘留摺痕，讓人仍能想見它原本作為衣袍的一部分。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "catalog-name-only-icon-unresolved", proofSource = "catalog-artwork-review", sourceNameEn = "Memory Priest's Cloth", nameVerificationStatus = "officially-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Category%3ALeftovers" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_leafre_344", sourceRow = 344, displayName = "悔恨祭司布料", price = 42000, originId = "leafre", sourceRegion = "時間神殿", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "悔恨祭司留下的衣料，殘片與大片布幅分開整理。來歷寫在箱標上，布本身則安靜得沒有一句懺悔。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "catalog-name-only-icon-unresolved", proofSource = "catalog-artwork-review", sourceNameEn = "Regret Priest's Cloth", nameVerificationStatus = "officially-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Category%3ALeftovers" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, edelstein = 1.40, japan = 1.30 } },
