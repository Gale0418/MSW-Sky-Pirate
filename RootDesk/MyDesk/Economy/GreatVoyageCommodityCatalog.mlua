		self._T.byId = {}
		self._T.byPort = {}
		for _, good in ipairs(self._T.catalog) do
			self._T.byId[good.id] = good
			if self._T.byPort[good.originId] == nil then self._T.byPort[good.originId] = {} end
			-- 未核實原作商品不進入可購買貨架，但仍保留在完整圖鑑。
			if good.verified then table.insert(self._T.byPort[good.originId], good) end
		end
		return self._T.catalog
	end

	method any GetForPort(string portId)
		-- 取得指定港口可購買的已核實貨物。
		self:GetAll()
		return self._T.byPort[portId] or {}
	end

	method any GetById(string goodId)
		-- 依圖鑑識別碼取得單筆貨物。
		self:GetAll()
		return self._T.byId[goodId]
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 輸出圖鑑載入數量供檢查。
		log("[CommodityCatalog] entries=" .. tostring(#self:GetAll()))
	end
end
