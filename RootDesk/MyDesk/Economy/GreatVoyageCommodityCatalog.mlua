			{ id = "commodity_forest_57", sourceRow = 57, displayName = "橘菇菇傘", price = 2000, originId = "forest", sourceRegion = "楓之島", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "herb", description = "圓厚的橘色菌傘，以乾燥墊料分層隔開。遠看像裝滿小傘的貨箱，近看才發現沒有一把附傘柄。", iconRuid = "0ed1b7cbeece48fa87e5f9ea37096d8d", nativeResourceRuid = "0ed1b7cbeece48fa87e5f9ea37096d8d", iconType = "sprite", originalItemId = 4000001, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Orange Mushroom Cap", nameVerificationStatus = "unresolved", sourceNameKo = { "머쉬맘의 갓", "주황버섯의 갓", "주황버섯의 모자" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Orange_Mushroom_Cap" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.30, rien = 1.60, sky = 1.40, aqua = 1.50, ludus = 1.10, nihal = 1.90, mulung = 2.00, leafre = 1.20, edelstein = 1.00, japan = 1.80 } },
			{ id = "commodity_forest_58", sourceRow = 58, displayName = "綠水靈液體", price = 3000, originId = "forest", sourceRegion = "魔法森林", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "alchemy", description = "封在寬口瓶中的濃稠黏液，傾斜時緩慢流動，瓶口容易拉出黏絲。整箱最值錢的配角，是那些牢靠的瓶塞。", iconRuid = "89ff14273d9940eebe8d44b003563915", nativeResourceRuid = "89ff14273d9940eebe8d44b003563915", iconType = "sprite", originalItemId = 4000004, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Squishy Liquid", nameVerificationStatus = "unresolved", sourceNameKo = { "물컹물컹한 액체" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Squishy_Liquid" }, replacementForName = nil, researchNote = nil, demands = { ereve = 1.10, rien = 1.40, sky = 1.30, aqua = 1.60, ludus = 1.50, nihal = 2.00, mulung = 1.90, leafre = 1.70, edelstein = 1.20, japan = 1.00 } },
