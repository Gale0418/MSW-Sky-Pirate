			{ id = "commodity_leafre_349", sourceRow = 349, displayName = "金色幸運草腰帶", price = 500000, originId = "leafre", sourceRegion = "時間神殿", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory", description = "飾有金色幸運草意象的腰帶，捲收後護好帶扣。外觀帶著討喜的寓意，成交時仍得照貨色而不是照運氣出價。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 1132272, verified = false, catalogNameVerified = true, verificationStatus = "catalog-name-only-icon-unresolved", proofSource = "catalog-artwork-review", sourceNameEn = "Golden Clover Belt", nameVerificationStatus = "officially-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorydb.com/itemsinfo.php?id=1132272", "https://maplestorywiki.net/w/Boss_Accessory_Set", "https://maplestorywiki.net/w/Golden_Clover_Belt", "https://maplestorywiki.net/w/Maple_Guide/Boss_Content" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.25, ereve = 5.00, rien = 1.00, sky = 4.00, aqua = 0.80, ludus = 1.50, nihal = 0.65, mulung = 2.00, edelstein = 0.50, japan = 3.00 } },
			{ id = "commodity_leafre_350", sourceRow = 350, displayName = "支配者墜飾配方", price = 800000, originId = "leafre", sourceRegion = "時間神殿", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory_recipe", description = "記載支配者墜飾製法的圖紙，材料需求與工序完整收存。太初精髓等材料尚未到齊前，這箱紙還只是雄心的開端。", iconRuid = "016121af3b754fbe83edded197a0acac", nativeResourceRuid = "016121af3b754fbe83edded197a0acac", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Dominator Pendant Recipe", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "도미네이터 펜던트 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Dominator_Pendant" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 4.00, rien = 1.00, sky = 3.00, aqua = 0.80, ludus = 2.00, nihal = 2.50, mulung = 1.25, edelstein = 0.50, japan = 0.65 } },
			{ id = "commodity_leafre_351", sourceRow = 351, displayName = "太初精髓", price = 700000, originId = "leafre", sourceRegion = "時間神殿", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "蘊含太初純粹能量的神祕石材，逐塊襯墊裝盒。箱子承載的是礦石，名字指向的卻是比商路更久遠的開始。", iconRuid = "576dceb6a27b4a62a8259e6fcabc412e", nativeResourceRuid = "576dceb6a27b4a62a8259e6fcabc412e", iconType = "sprite", originalItemId = 4021022, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "태초의 정수" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/576dceb6a27b4a62a8259e6fcabc412e" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_leafre_357", sourceRow = 357, displayName = "初級魔法師布料", price = 36000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "初級魔法師使用的布料，整理成便於裁取的布束。外觀樸素，完整布幅與乾淨邊緣比花俏包裝更實在。", iconRuid = "390ae4587fb04b8590f95532f892248a", nativeResourceRuid = "390ae4587fb04b8590f95532f892248a", iconType = "sprite", originalItemId = 4009147, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Basic Magician's Cloth", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "하급 마법사의 옷자락" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_leafre_358", sourceRow = 358, displayName = "中級魔法師布料", price = 42000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "中級魔法師留下的布料，捲束時保留原有織紋。工坊會先攤開檢查，再決定哪些部分適合繼續使用。", iconRuid = "916c31a79d7f43d3b001abbb1d8a058c", nativeResourceRuid = "916c31a79d7f43d3b001abbb1d8a058c", iconType = "sprite", originalItemId = 4009148, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Intermediate Magician's Cloth", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "중급 마법사의 옷자락" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_leafre_359", sourceRow = 359, displayName = "高級魔法師布料", price = 50000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "高級魔法師衣料整理成卷，細部紋樣另以薄紙保護。不能因為裝進貨箱，就把原本值得保留的織工壓成皺團。", iconRuid = "8183666cd8634b2083698a51bd37def2", nativeResourceRuid = "8183666cd8634b2083698a51bd37def2", iconType = "sprite", originalItemId = 4009149, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Advanced Magician's Cloth", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "상급 마법사의 옷자락" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, mulung = 1.50, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_leafre_360", sourceRow = 360, displayName = "冰凍能量", price = 48000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "ice", description = "凝聚著寒冷的能量中，浮現難以辨讀的發光文字。每份各自封存，像把一段冰冷而陌生的訊息装進了箱子。", iconRuid = "3c286d2eb4684d1aa90d0df2915de0f5", nativeResourceRuid = "3c286d2eb4684d1aa90d0df2915de0f5", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Frozen Energy", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "얼어붙은 기운" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.40, rien = 1.00, sky = 1.60, aqua = 1.90, ludus = 1.70, nihal = 2.00, mulung = 1.30, edelstein = 1.80, japan = 1.10 } },
			{ id = "commodity_leafre_361", sourceRow = 361, displayName = "燃燒能量", price = 48000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "fire", description = "燃燒能量分置於耐熱容器，內匣保持彼此隔離。名稱已說明它不適合靠近布料，裝箱時就別讓兩種貨交朋友。", iconRuid = "8fc55336d4044e7fae3bfa2d47fc8a25", nativeResourceRuid = "8fc55336d4044e7fae3bfa2d47fc8a25", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Burning Energy", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "타오르는 불꽃" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.40, rien = 2.00, sky = 1.60, aqua = 1.00, ludus = 1.80, nihal = 1.50, mulung = 1.30, edelstein = 1.90, japan = 1.10 } },
			{ id = "commodity_leafre_362", sourceRow = 362, displayName = "滲透能量", price = 52000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "性質難以判明的滲透能量，按份收存於封閉容器。貨單能寫清名稱，卻不足以替研究者解釋其中的所有疑問。", iconRuid = "f65e7f94ec3d46f5a072fc9c25d60d2f", nativeResourceRuid = "f65e7f94ec3d46f5a072fc9c25d60d2f", iconType = "sprite", originalItemId = 4033933, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Penetrating Energy", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "스며드는 기운" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_leafre_363", sourceRow = 363, displayName = "反魔法石碎片", price = 60000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "蘊含反魔法力量的石片，分袋封存後裝箱。看似尋常碎石，卻屬於不能僅凭外觀判斷用途的特殊材料。", iconRuid = "142650349a714d8aae2a993bcb3c561c", nativeResourceRuid = "142650349a714d8aae2a993bcb3c561c", iconType = "sprite", originalItemId = 4036330, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "반마력석 파편" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/142650349a714d8aae2a993bcb3c561c" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_leafre_364", sourceRow = 364, displayName = "黑色魔法書", price = 70000, originId = "leafre", sourceRegion = "克里提亞斯", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "黑色封面的魔法書冊，書背朝向一致，防潮包裹逐本收好。採購時最好確認內容，而不是只被封面上的神祕感說服。", iconRuid = "1c1685c6965b40699ba6f99540c394bb", nativeResourceRuid = "1c1685c6965b40699ba6f99540c394bb", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Black Magic Book", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "검은 마도서" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, ludus = 1.20, nihal = 1.70, mulung = 1.60, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_edelstein_377", sourceRow = 377, displayName = "巡邏機器人記憶晶片", price = 10000, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "robot", description = "從巡邏機器人取得的記憶晶片，接點保護後逐片入槽。外表只是薄薄零件，裡面是否還有資料得交給專業設備確認。", iconRuid = "04158a8ec046420a9e657169807b0406", nativeResourceRuid = "04158a8ec046420a9e657169807b0406", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Patrol Robot S Memory Chip", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "순찰로봇S의 메모리칩" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.26, ereve = 1.32, rien = 1.20, sky = 1.23, aqua = 1.38, ludus = 1.47, nihal = 1.44, mulung = 1.29, leafre = 1.35, japan = 1.41 } },
			{ id = "commodity_edelstein_378", sourceRow = 378, displayName = "巡邏機器人 S 晶片", price = 14000, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "robot", description = "巡邏機器人 S 使用的晶片，與其他型號分開標記裝箱。字母只差一個，接錯零件時可不會因此比較客氣。", iconRuid = "04158a8ec046420a9e657169807b0406", nativeResourceRuid = "04158a8ec046420a9e657169807b0406", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Patrol Robot S Chip", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "순찰로봇S의 메모리칩" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.20, ereve = 1.40, rien = 1.00, sky = 1.10, aqua = 1.60, ludus = 1.90, nihal = 1.80, mulung = 1.30, leafre = 1.50, japan = 1.70 } },
			{ id = "commodity_edelstein_379", sourceRow = 379, displayName = "偷水賊的水瓶", price = 12000, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "water", description = "偷水賊留下的水瓶，按瓶形分組，以隔板固定。名字交代了它的前任主人，瓶內內容物則需要另外查驗。", iconRuid = "6417bac38f8e4cfa8d5ca6c20cb1e1fb", nativeResourceRuid = "6417bac38f8e4cfa8d5ca6c20cb1e1fb", iconType = "sprite", originalItemId = 4033639, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "잃어버린 물통" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/6417bac38f8e4cfa8d5ca6c20cb1e1fb" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.35, ereve = 1.32, rien = 1.41, sky = 1.38, aqua = 1.20, ludus = 1.44, nihal = 1.50, mulung = 1.29, leafre = 1.26, japan = 1.23 } },
			{ id = "commodity_edelstein_380", sourceRow = 380, displayName = "蛇尾", price = 4000, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "animal", description = "蛇尾沿自然彎度盤收，表面的鱗片盡量保持完整。分件包好後安置在內箱，避免運輸中互相摩擦脫落。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 4000600, verified = false, catalogNameVerified = true, verificationStatus = "original-name-verified/icon-unresolved", proofSource = "lookup-agent-exact-korean-name-and-item-subpath", sourceNameEn = "Serpent Tail", nameVerificationStatus = "official-english-name-and-item-id", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Serpent_Tail", "https://maplestorywiki.net/w/Serpent", "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = "更正為原作 Serpent Tail，item ID 4000600；MapleWiki 說明此 ETC 道具由 Serpent 掉落。MSW sprite topK10 未找到相符 04000600/iconRaw 或同名韓文 tag，因此保留空 icon，不套用相似道具。", demands = { forest = 1.35, ereve = 1.44, rien = 1.32, sky = 1.38, aqua = 1.29, ludus = 1.26, nihal = 1.41, mulung = 1.47, leafre = 1.50, japan = 1.23 } },
			{ id = "commodity_edelstein_381", sourceRow = 381, displayName = "推車熊的推車", price = 13000, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mechanical", description = "推車熊使用的推車，拆下易碰傷的輪組與把手後固定裝箱。重新組起來之前，搬運工具也得先接受別人的搬運。", iconRuid = "2085fa77dd2345f596b9fd4fd550c7fd", nativeResourceRuid = "2085fa77dd2345f596b9fd4fd550c7fd", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Cart Bear's Cart", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "카트베어의 카트" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 1.50, rien = 1.20, sky = 1.60, aqua = 1.80, ludus = 2.00, nihal = 1.90, mulung = 1.30, leafre = 1.10, japan = 1.00 } },
			{ id = "commodity_edelstein_382", sourceRow = 382, displayName = "警備機器人晶片", price = 14800, originId = "edelstein", sourceRegion = "埃德爾斯坦", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "robot", description = "警備機器人的電子晶片，按接點方向整齊排放。修理工坊在意的是型號與狀態，不是箱子裡排得像不像巧克力。", iconRuid = "279d33c826764545932c1ab5bc990d0d", nativeResourceRuid = "279d33c826764545932c1ab5bc990d0d", iconType = "sprite", originalItemId = 4009160, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "감시로봇의 회로칩" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/279d33c826764545932c1ab5bc990d0d" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.20, ereve = 1.40, rien = 1.00, sky = 1.10, aqua = 1.60, ludus = 1.90, nihal = 1.80, mulung = 1.30, leafre = 1.50, japan = 1.70 } },
			{ id = "commodity_edelstein_383", sourceRow = 383, displayName = "機器人燈泡", price = 20000, originId = "edelstein", sourceRegion = "工業區", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "mechanical", description = "機器人使用的燈泡，逐顆置於防震隔格。玻璃外殼看似完整還不夠，燈座與接點也得一併檢查。", iconRuid = "20eac4c012db4e11a9a8d5c46b8e4f31", nativeResourceRuid = "20eac4c012db4e11a9a8d5c46b8e4f31", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Android Bulb", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "안드로이드의 전구" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.40, ereve = 1.50, rien = 1.20, sky = 1.60, aqua = 1.80, ludus = 2.00, nihal = 1.90, mulung = 1.30, leafre = 1.10, japan = 1.00 } },
			{ id = "commodity_edelstein_384", sourceRow = 384, displayName = "保全系統卡片", price = 24000, originId = "edelstein", sourceRegion = "工業區", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "robot", description = "保全系統使用的卡片，卡面與識別區以薄套保護。貨物的用途與權限有關，並不是印得漂亮就能當通行證。", iconRuid = "7a67cf7e4b464903b30a87d9e184dc6d", nativeResourceRuid = "7a67cf7e4b464903b30a87d9e184dc6d", iconType = "sprite", originalItemId = 2384038, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "자동 경비시스템 카드" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/7a67cf7e4b464903b30a87d9e184dc6d" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.20, ereve = 1.40, rien = 1.00, sky = 1.10, aqua = 1.60, ludus = 1.90, nihal = 1.80, mulung = 1.30, leafre = 1.50, japan = 1.70 } },
