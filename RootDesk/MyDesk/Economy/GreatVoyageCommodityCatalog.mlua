			{ id = "commodity_ludus_230", sourceRow = 230, displayName = "老虎印章", price = 28000, originId = "ludus", sourceRegion = "童話村", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "magic", description = "帶著老虎意象的印章，印面逐枚墊好收存。乍看是文房小物，粗獷造型又讓人想起山林裡不太好惹的主人。", iconRuid = "3e44bc38f6d644b08724521021b02ad8", nativeResourceRuid = "3e44bc38f6d644b08724521021b02ad8", iconType = "sprite", originalItemId = 4000170, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Tiger Footprint", nameVerificationStatus = "unresolved", sourceNameKo = { "호랑이 발도장" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Tiger_Footprint" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.80, rien = 1.40, sky = 1.90, aqua = 1.30, nihal = 1.70, mulung = 1.60, leafre = 1.50, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_ludus_231", sourceRow = 231, displayName = "三尾狐尾巴", price = 30000, originId = "ludus", sourceRegion = "童話村", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "三尾狐留下的尾巴，順著毛流成束排放。柔軟外觀很討喜，來源的名字卻替這箱毛料添了一點妖異。", iconRuid = "28d0d4b71fd74f17aaf69d56493bafe4", nativeResourceRuid = "28d0d4b71fd74f17aaf69d56493bafe4", iconType = "sprite", originalItemId = 4000066, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Cloud Foxtail", nameVerificationStatus = "unresolved", sourceNameKo = { "여우 꼬리" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cloud_Foxtail" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, nihal = 1.00, mulung = 1.50, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_ludus_236", sourceRow = 236, displayName = "拉圖斯標誌", price = 500000, originId = "ludus", sourceRegion = "時間塔", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "accessory", description = "來自混沌拉圖斯的眼部飾品，逐件裝盒收妥。它不是拆下來的普通標牌，而是能戴在身上的首領戰利品。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Papulatus Mark", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Papulatus_Mark" }, replacementForName = nil, researchNote = "MapleStory 現代原作有 Papulatus Mark 裝備；本輪英韓精確 MSW 查詢未取到名稱吻合 icon，item ID 未由可靠來源核定。", demands = { forest = 1.25, ereve = 5.00, rien = 1.00, sky = 4.00, aqua = 0.80, nihal = 0.65, mulung = 2.00, leafre = 2.50, edelstein = 0.50, japan = 3.00 } },
			{ id = "commodity_ludus_237", sourceRow = 237, displayName = "黑暗塔奇昂", price = 250000, originId = "ludus", sourceRegion = "時間塔", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "time", description = "與拉圖斯有關的異常物質，分批密封收存。曾有任務要求將它投入熔岩銷毀，如今卻被人列上了商品貨單。", iconRuid = "b74dad60301f46ed85cdbdff8afa344c", nativeResourceRuid = "b74dad60301f46ed85cdbdff8afa344c", iconType = "sprite", originalItemId = 4031196, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Dark Tachion", nameVerificationStatus = "unresolved", sourceNameKo = { "다크타키온" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Dark_Tachion" }, replacementForName = nil, researchNote = nil, demands = { forest = 2.00, ereve = 1.25, rien = 0.50, sky = 3.00, aqua = 0.65, nihal = 4.00, mulung = 0.80, leafre = 1.50, edelstein = 5.00, japan = 1.00 } },
			{ id = "commodity_ludus_238", sourceRow = 238, displayName = "拉圖斯靈魂碎片", price = 400000, originId = "ludus", sourceRegion = "時間塔", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "time_soul", description = "封存著拉圖斯部分靈魂力量的碎片，整齊安置在分格內匣。旁邊的玩具看似同鄉，身價的理由卻完全不同。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Papulatus's Soul Shard (Sealed Cargo)", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Papulatus_Soul_Shard" }, replacementForName = nil, researchNote = "原作 Soul Shard 拾取後直接登錄收藏；封裝貨運為本作規則。", demands = { forest = 2.00, ereve = 1.25, rien = 0.50, sky = 3.00, aqua = 0.65, nihal = 4.00, mulung = 0.80, leafre = 1.50, edelstein = 5.00, japan = 1.00 } },
			{ id = "commodity_ludus_239", sourceRow = 239, displayName = "無限飛鏢配方", price = 130000, originId = "ludus", sourceRegion = "時間塔", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "weapon_recipe", description = "記載無限飛鏢製法的配方，按份平整收存於防潮內匣。這箱賣的是製作方法，不是取之不盡的成品。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 2510260, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Infinite Throwing-Knives Recipe", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = "原作配方存在；舊版道具手冊列 ID 2510260。MSW 英韓精確查詢未取到名稱標籤吻合的配方 sprite；候選無名稱標籤不能採用。", demands = { forest = 1.60, ereve = 1.80, rien = 1.40, sky = 1.30, aqua = 1.00, nihal = 1.70, mulung = 1.90, leafre = 2.00, edelstein = 1.20, japan = 1.10 } },
			{ id = "commodity_ludus_240", sourceRow = 240, displayName = "OMNI-CLN 機械零件", price = 280000, originId = "ludus", sourceRegion = "地球防衛總部", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "robot", description = "與 OMNI-CLN 有關的機械零件，接頭、外殼與細件分區固定。對外行是一箱怪鐵，對研究者則是待解的構造圖。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "OMNI-CLN Component", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/OMNI-CLN" }, replacementForName = nil, researchNote = "MapleWiki 確認 OMNI-CLN 掉落 OMNI-CLN Component；保留原價，列 missingNative。", demands = { forest = 0.80, ereve = 1.25, rien = 0.50, sky = 0.65, aqua = 2.00, nihal = 3.00, mulung = 1.00, leafre = 1.50, edelstein = 5.00, japan = 2.50 } },
			{ id = "commodity_ludus_241", sourceRow = 241, displayName = "OMNI-CLN 吸塵裝置", price = 320000, originId = "ludus", sourceRegion = "地球防衛總部", unit = "件", category = "精品", tradeTier = "boss", isBoss = true, marketRole = "robot", description = "標有 OMNI-CLN 名稱的吸塵裝置，開口與接合處加上護套。特別突出的構造另用支架固定，免得抵港後只剩零件。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "OMNI-CLN Vacuum", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/OMNI-CLN" }, replacementForName = nil, researchNote = "MapleWiki 確認 OMNI-CLN 掉落 OMNI-CLN Vacuum；不要使用 draft 的 device 翻譯，保留原價並列 missingNative。", demands = { forest = 0.80, ereve = 1.25, rien = 0.50, sky = 0.65, aqua = 2.00, nihal = 3.00, mulung = 1.00, leafre = 1.50, edelstein = 5.00, japan = 2.50 } },
			{ id = "commodity_nihal_261", sourceRow = 261, displayName = "仙人掌莖", price = 17400, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "herb", description = "分切整理的仙人掌莖，以墊料隔開收存。厚實外皮仍留著生長痕跡，與一般木材相比，多了幾分沙漠植物的模樣。", iconRuid = "1ec44b0b3abe454fbf486ce57aa9e016", nativeResourceRuid = "1ec44b0b3abe454fbf486ce57aa9e016", iconType = "sprite", originalItemId = 4000930, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Cactus Stem", nameVerificationStatus = "unresolved", sourceNameKo = { "선인장의 줄기" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cactus_Stem" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.41, ereve = 1.29, rien = 1.38, sky = 1.32, aqua = 1.35, ludus = 1.23, mulung = 1.50, leafre = 1.26, edelstein = 1.20, japan = 1.44 } },
			{ id = "commodity_nihal_262", sourceRow = 262, displayName = "仙人掌花", price = 17400, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "herb", description = "從仙人掌取得的花朵，輕放於淺層內盒。乾燥荒地裡的一點鮮色，如今成了最怕擠壓的沙漠貨物。", iconRuid = "2a02777a2e134cc792db8b2c2b626890", nativeResourceRuid = "2a02777a2e134cc792db8b2c2b626890", iconType = "sprite", originalItemId = 4000932, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Cactus Flower", nameVerificationStatus = "unresolved", sourceNameKo = { "카투스의 꽃" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cactus_Flower" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.41, ereve = 1.29, rien = 1.38, sky = 1.32, aqua = 1.35, ludus = 1.23, mulung = 1.50, leafre = 1.26, edelstein = 1.20, japan = 1.44 } },
			{ id = "commodity_nihal_263", sourceRow = 263, displayName = "仙人掌刺", price = 17400, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "herb", description = "挑出完整長刺後分束包好，尖端朝同一方向排列。占不了多少箱內空間，卻值得比大件貨物更多一點小心。", iconRuid = "24d371e7bfaf4ff2a6a49a5e0c4d5082", nativeResourceRuid = "24d371e7bfaf4ff2a6a49a5e0c4d5082", iconType = "sprite", originalItemId = 4000931, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Cactus Thorn", nameVerificationStatus = "unresolved", sourceNameKo = { "선인장의 가시" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Cactus_Thorn" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.41, ereve = 1.29, rien = 1.38, sky = 1.32, aqua = 1.35, ludus = 1.23, mulung = 1.50, leafre = 1.26, edelstein = 1.20, japan = 1.44 } },
			{ id = "commodity_nihal_264", sourceRow = 264, displayName = "迪歐之刺", price = 25000, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "poison", description = "迪歐留下的尖刺，與普通仙人掌刺分開裝盒。賣家不必替它編造功效，只要把來源寫清楚就足夠引人注意。", iconRuid = "8b4aa3db9c6241eaa65d6c6a5c574db2", nativeResourceRuid = "8b4aa3db9c6241eaa65d6c6a5c574db2", iconType = "sprite", originalItemId = 4000160, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Deo's Thorn", nameVerificationStatus = "unresolved", sourceNameKo = { "데우의 가시" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Deo%27s_Thorn" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.00, rien = 1.10, sky = 1.40, aqua = 1.30, ludus = 1.20, mulung = 1.90, leafre = 1.60, edelstein = 1.80, japan = 1.50 } },
			{ id = "commodity_nihal_265", sourceRow = 265, displayName = "沙漠蠍子的刺", price = 18000, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "poison", description = "沙漠蠍子留下的刺部，逐件隔開並護住尖端。外箱標得清清楚楚，免得有人把這批貨當成普通縫針材料。", iconRuid = "02178d88a24a49cf9418513cf11ebeb1", nativeResourceRuid = "02178d88a24a49cf9418513cf11ebeb1", iconType = "sprite", originalItemId = 4000351, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Scorpion's Tail", nameVerificationStatus = "unresolved", sourceNameKo = { "전갈의 꼬리", "전갈의 독침" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.00, rien = 1.10, sky = 1.40, aqua = 1.30, ludus = 1.20, mulung = 1.90, leafre = 1.60, edelstein = 1.80, japan = 1.50 } },
			{ id = "commodity_nihal_266", sourceRow = 266, displayName = "蠍子的尾巴", price = 18000, originId = "nihal", sourceRegion = "阿里安特", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "poison", description = "保留節段外形的蠍尾，順著彎曲形狀固定。比起零散尖刺，整段構造更能讓買家辨认原本的模樣。", iconRuid = "02178d88a24a49cf9418513cf11ebeb1", nativeResourceRuid = "02178d88a24a49cf9418513cf11ebeb1", iconType = "sprite", originalItemId = 4000351, verified = true, catalogNameVerified = true, verificationStatus = "verified-real-item-replacement-native-icon", proofSource = "four-port-corrected-alternative", sourceNameEn = "Scorpion's Tail", nameVerificationStatus = "unresolved", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = "狐獴尾巴", researchNote = nil, demands = { forest = 1.70, ereve = 1.00, rien = 1.10, sky = 1.40, aqua = 1.30, ludus = 1.20, mulung = 1.90, leafre = 1.60, edelstein = 1.80, japan = 1.50 } },
			{ id = "commodity_nihal_267", sourceRow = 267, displayName = "實驗燒杯", price = 22000, originId = "nihal", sourceRegion = "瑪迦提亞", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "glassware", description = "實驗室使用的燒杯，按口徑分組，以軟墊隔開。箱內最重要的不是裝得多滿，而是到港後每只仍有完整杯口。", iconRuid = "233f3b903d79486a9cae96e1b5fc2431", nativeResourceRuid = "233f3b903d79486a9cae96e1b5fc2431", iconType = "sprite", originalItemId = 4009070, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Experimental Beaker", nameVerificationStatus = "unresolved", sourceNameKo = { "실험용 비커" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.30, rien = 1.20, sky = 1.40, aqua = 1.10, ludus = 1.60, mulung = 1.90, leafre = 1.50, edelstein = 1.80, japan = 1.00 } },
			{ id = "commodity_nihal_268", sourceRow = 268, displayName = "五月露水", price = 24000, originId = "nihal", sourceRegion = "瑪迦提亞", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "water", description = "煉製人造生命所需的神祕露水，分瓶密封收存。連研究者也說不清它為何不可少，採購清單卻始終少不了它。", iconRuid = "b9d99f347701432ea0cbb66731327df1", nativeResourceRuid = "b9d99f347701432ea0cbb66731327df1", iconType = "sprite", originalItemId = 4009071, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "May's Dew", nameVerificationStatus = "unresolved", sourceNameKo = { "5월의 이슬" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.40, rien = 1.70, sky = 1.60, aqua = 1.00, ludus = 1.80, mulung = 1.30, leafre = 1.20, edelstein = 1.90, japan = 1.10 } },
			{ id = "commodity_nihal_269", sourceRow = 269, displayName = "紫色液體", price = 26000, originId = "nihal", sourceRegion = "瑪迦提亞", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "alchemy", description = "色澤濃厚的紫色液體，盛在封口瓶中直立裝箱。標籤與批次比香味重要，驗貨並不包含打開來嚐一口。", iconRuid = "60538a9f27134b1c89cad56d3acda17c", nativeResourceRuid = "60538a9f27134b1c89cad56d3acda17c", iconType = "sprite", originalItemId = 4009064, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-and-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Purple Liquid", nameVerificationStatus = "unresolved", sourceNameKo = { "보라색 액체", "보랏빛 액체" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/User%3ARichmond2010/Strings/Etc" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.10, rien = 1.40, sky = 1.30, aqua = 1.60, ludus = 1.50, mulung = 1.90, leafre = 1.70, edelstein = 1.20, japan = 1.00 } },
			{ id = "commodity_nihal_270", sourceRow = 270, displayName = "無限飛鏢配方", price = 130000, originId = "nihal", sourceRegion = "阿里安特", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "weapon_recipe", description = "記載無限飛鏢製法的配方，按份平整收存於防潮內匣。這箱賣的是製作方法，不是取之不盡的成品。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 2510260, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Infinite Throwing-Knives Recipe", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = "原作配方存在；舊版道具手冊列 ID 2510260。MSW 英韓精確查詢未取到名稱標籤吻合的配方 sprite；候選無名稱標籤不能採用。", demands = { forest = 1.60, ereve = 1.80, rien = 1.40, sky = 1.30, aqua = 1.00, ludus = 1.50, mulung = 1.90, leafre = 2.00, edelstein = 1.20, japan = 1.10 } },
			{ id = "commodity_nihal_271", sourceRow = 271, displayName = "特殊迪歐變身藥水配方", price = 100000, originId = "nihal", sourceRegion = "阿里安特", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "alchemy_recipe", description = "用來調製特殊迪歐變身藥水的配方，材料表與步驟完整收存。旅人認得迪歐的名字，煉金師則更在意每一道工序。", iconRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", nativeResourceRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", iconType = "sprite", originalItemId = 2512043, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-shared-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Special Deo Transform Potion Recipe", nameVerificationStatus = "unresolved", sourceNameKo = { "스페셜 데우 변신 포션 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.30, rien = 1.50, sky = 1.40, aqua = 1.20, ludus = 1.00, mulung = 1.90, leafre = 1.70, edelstein = 1.60, japan = 1.10 } },
			{ id = "commodity_nihal_272", sourceRow = 272, displayName = "高級敏捷藥水 I 配方", price = 90000, originId = "nihal", sourceRegion = "瑪迦提亞", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "alchemy_recipe", description = "高級敏捷藥水 I 的煉金配方，按同一版本分類裝箱。名稱後的小小編號，也不能在抄錄時隨手漏掉。", iconRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", nativeResourceRuid = "03d0ed7ffe064fd4b2d5722ba3fb0ee9", iconType = "sprite", originalItemId = 2512099, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-shared-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Advanced Dexterity Potion I Recipe", nameVerificationStatus = "unresolved", sourceNameKo = { "향상된 1단계 민첩의 물약 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.30, rien = 1.50, sky = 1.40, aqua = 1.20, ludus = 1.00, mulung = 1.90, leafre = 1.70, edelstein = 1.60, japan = 1.10 } },
			{ id = "commodity_nihal_273", sourceRow = 273, displayName = "高級洞察藥水配方", price = 150000, originId = "nihal", sourceRegion = "瑪迦提亞", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "alchemy_recipe", description = "記載高級洞察藥水製法的配方，細小註記與材料名稱都保留完整。賣給仔細看字的人，總比賣給只看封面的人安心。", iconRuid = "", nativeResourceRuid = "", iconType = "", originalItemId = 0, verified = false, catalogNameVerified = true, verificationStatus = "name-source-verified-icon-unresolved", proofSource = "four-port-artwork-review", sourceNameEn = "Advanced Insight Potion Recipe", nameVerificationStatus = "original-name-attested-by-linked-page", sourceNameKo = {  }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorywiki.net/w/Recipes" }, replacementForName = nil, researchNote = "精確名稱屬原作製作配方類候選，但本輪未從可靠資料源核定 item ID，也未找到有名稱標籤的 MSW sprite；recipe icon 不臆配。", demands = { forest = 1.80, ereve = 1.30, rien = 1.50, sky = 1.40, aqua = 1.20, ludus = 1.00, mulung = 1.90, leafre = 1.70, edelstein = 1.60, japan = 1.10 } },
			{ id = "commodity_nihal_274", sourceRow = 274, displayName = "天使祝福配方", price = 220000, originId = "nihal", sourceRegion = "阿里安特", unit = "件", category = "精品", tradeTier = "normal", isBoss = false, marketRole = "holy_recipe", description = "天使祝福戒指的製作配方，按份平整裝箱。成品與天使的祝福有關，箱內裝的卻是飾品工匠實實在在的製作方法。", iconRuid = "016121af3b754fbe83edded197a0acac", nativeResourceRuid = "016121af3b754fbe83edded197a0acac", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-shared-native-icon", proofSource = "four-port-verified-items+artwork-review", sourceNameEn = "Angel Blessing Recipe", nameVerificationStatus = "unresolved", sourceNameKo = { "엔젤릭 블레스 제작 레시피" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = { "https://www.scribd.com/document/621480035/GM-Handbook-v138" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.90, ereve = 2.00, rien = 1.40, sky = 1.80, aqua = 1.20, ludus = 1.30, mulung = 1.60, leafre = 1.50, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_mulung_289", sourceRow = 289, displayName = "稻草娃娃", price = 27200, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "toy", description = "紮成形的稻草娃娃，彼此隔開，免得運輸時散成一箱草。緊實的綁結與完整輪廓，是挑選這批貨的基本功。", iconRuid = "102c885100ef4686ad088161b6f3ebfd", nativeResourceRuid = "102c885100ef4686ad088161b6f3ebfd", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Straw Doll", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "볏짚인형" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.60, sky = 1.90, aqua = 1.40, ludus = 2.00, nihal = 1.30, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_mulung_290", sourceRow = 290, displayName = "木頭娃娃", price = 27200, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "toy", description = "木製娃娃分排固定，凸出的部位另加墊料。外表樸實，卻最容易在碰撞後留下難以掩飾的缺角。", iconRuid = "0ac70526dddc4a1c9a9d32062e0cce77", nativeResourceRuid = "0ac70526dddc4a1c9a9d32062e0cce77", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Wooden Doll", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "나무인형" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.50, ereve = 1.80, rien = 1.60, sky = 1.90, aqua = 1.40, ludus = 2.00, nihal = 1.30, leafre = 1.20, edelstein = 1.00, japan = 1.10 } },
			{ id = "commodity_mulung_291", sourceRow = 291, displayName = "橡實", price = 24000, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "food", description = "挑去空殼與碎果的橡實，裝袋後層層碼進木箱。褐色硬殼挨在一起，是山林貨物裡最樸素的一種聲音。", iconRuid = "177f20159e164c9c8595d91f771b5abd", nativeResourceRuid = "177f20159e164c9c8595d91f771b5abd", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Acorn", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "도토리" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.38, ereve = 1.35, rien = 1.50, sky = 1.41, aqua = 1.44, ludus = 1.29, nihal = 1.47, leafre = 1.26, edelstein = 1.23, japan = 1.20 } },
			{ id = "commodity_mulung_292", sourceRow = 292, displayName = "熊掌", price = 27600, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "food", description = "整理過的熊掌分件包裹，保留掌部與爪的外形。外箱不大張旗鼓，攤開驗貨時卻很難認錯來源。", iconRuid = "15da724ab77b4d8dabafe62e03681a22", nativeResourceRuid = "15da724ab77b4d8dabafe62e03681a22", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Bear Foot", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "곰발바닥" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.50, rien = 2.00, sky = 1.70, aqua = 1.80, ludus = 1.30, nihal = 1.90, leafre = 1.20, edelstein = 1.10, japan = 1.00 } },
			{ id = "commodity_mulung_293", sourceRow = 293, displayName = "桔梗", price = 26000, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "herb", description = "根鬚整理成束的桔梗，帶著淡淡泥土氣息。細根需要留出空隙，不能像裝木柴那樣把整箱壓得死緊。", iconRuid = "05778ff5f31441aca4ed76ff6d4822b4", nativeResourceRuid = "05778ff5f31441aca4ed76ff6d4822b4", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Bellflower", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "도라지" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.41, ereve = 1.29, rien = 1.38, sky = 1.32, aqua = 1.35, ludus = 1.23, nihal = 1.47, leafre = 1.26, edelstein = 1.20, japan = 1.44 } },
			{ id = "commodity_mulung_294", sourceRow = 294, displayName = "百年桔梗", price = 27800, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "herb", description = "名為百年桔梗的藥材，逐株包好，保留根部輪廓。買家會仔細看它的形貌，而不只相信箱面上那兩個大字。", iconRuid = "32228e9bff39492cb267c88c649076bc", nativeResourceRuid = "32228e9bff39492cb267c88c649076bc", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "100-Year-Old Bellflower", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "100년 묵은 도라지" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.70, ereve = 1.30, rien = 1.60, sky = 1.40, aqua = 1.50, ludus = 1.10, nihal = 1.90, leafre = 1.20, edelstein = 1.00, japan = 1.80 } },
			{ id = "commodity_mulung_295", sourceRow = 295, displayName = "人蔘濃縮液", price = 29000, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "alchemy", description = "帶著人蔘氣息的濃縮液，分瓶封好並直立固定。液體濃厚，貨箱裡最怕的不是晃動，而是瓶塞失守後黏成一片。", iconRuid = "d6fe40e9f0c04855a94528d316dc4754", nativeResourceRuid = "d6fe40e9f0c04855a94528d316dc4754", iconType = "sprite", originalItemId = 4033968, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon", proofSource = "catalog-artwork-review", sourceNameEn = "Ginseng Concentrate", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "산삼 농축액" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestorydb.com/itemsinfo.php?id=4033968" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.80, ereve = 1.10, rien = 1.40, sky = 1.30, aqua = 1.60, ludus = 1.50, nihal = 2.00, leafre = 1.70, edelstein = 1.20, japan = 1.00 } },
			{ id = "commodity_mulung_296", sourceRow = 296, displayName = "船長帽", price = 28200, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "normal", isBoss = false, marketRole = "textile", description = "成批整理的船長帽，帽內填入支撐物，避免帽簷壓歪。買下一箱不會多出一箱船長，只會多出許多想試戴的人。", iconRuid = "f39a4dab45aa4366bc07de077d2671b5", nativeResourceRuid = "f39a4dab45aa4366bc07de077d2671b5", iconType = "sprite", originalItemId = 4000297, verified = true, catalogNameVerified = true, verificationStatus = "catalog-name-verified/icon-found", proofSource = "catalog-name-id-research", sourceNameEn = nil, nameVerificationStatus = "unresolved", sourceNameKo = { "선장의 모자" }, iconShared = false, iconRuidCandidates = {  }, sourceUrls = { "https://maplestoryworlds-resourcesearch-new.nexon.com/api/v3/resources/tags/f39a4dab45aa4366bc07de077d2671b5" }, replacementForName = nil, researchNote = nil, demands = { forest = 1.60, ereve = 1.70, rien = 2.00, sky = 1.80, aqua = 1.10, ludus = 1.90, nihal = 1.00, leafre = 1.20, edelstein = 1.40, japan = 1.30 } },
			{ id = "commodity_mulung_297", sourceRow = 297, displayName = "桃子種子", price = 25000, originId = "mulung", sourceRegion = "武陵", unit = "箱", category = "量產", tradeTier = "starter", isBoss = false, marketRole = "seed", description = "挑选完整後裝袋的桃子種子，硬殼上留著凹凸紋路。果肉的甜香已不在箱裡，留下的是下一片桃林的可能。", iconRuid = "a4687c1601dd4ad7a4bf49b0a0261768", nativeResourceRuid = "a4687c1601dd4ad7a4bf49b0a0261768", iconType = "sprite", originalItemId = 0, verified = true, catalogNameVerified = true, verificationStatus = "exact-name-native-icon-shared", proofSource = "catalog-artwork-review", sourceNameEn = "Peach Seed", nameVerificationStatus = "exact-official-korean-name", sourceNameKo = { "복숭아 씨앗" }, iconShared = true, iconRuidCandidates = {  }, sourceUrls = {  }, replacementForName = nil, researchNote = nil, demands = { forest = 1.47, ereve = 1.35, rien = 1.41, sky = 1.38, aqua = 1.32, ludus = 1.29, nihal = 1.44, leafre = 1.26, edelstein = 1.20, japan = 1.23 } },
