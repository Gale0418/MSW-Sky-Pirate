@Logic
script GreatVoyagePlayerMarket extends Logic

	property table accounts = {}
	property table profileByUser = {}
	property table clientMarkets = {}
	property number clientServerTime = 0
	property number clientReceivedAt = 0
	property string clientProfileCode = ""

	method number GetNow()
		-- 採 UTC Unix 秒數，讓既有報價與補貨邏輯跨世界重開保持一致。
		return (DateTime.UtcNow.Elapsed - DateTime(1970, 1, 1).Elapsed) / 1000
	end

	method void OnBeginPlay()
		-- 市場快取只服務既有 GetMarket 契約，ProfileStore 是唯一資料寫入者。
		self.accounts = {}
		self.profileByUser = {}
		self.clientMarkets = {}
	end

	method void OnEndPlay()
		-- 清除畫面投影與短期市場快取，不在此建立第二條存檔路徑。
		self.accounts = {}
		self.profileByUser = {}
		self.clientMarkets = {}
	end

	@ExecSpace("ServerOnly")
	method string GetShard(string portId, string goodId)
		-- 保留原 shard 命名，供遷移工具與既有交易呼叫者識別商品分片。
		local good = _GreatVoyageVoyageData:GetGoodById(goodId)
		if good == nil then return "" end
		return "GVMarketV1_" .. portId .. "_" .. tostring(math.floor(good.sourceRow / 24))
	end

	@ExecSpace("ServerOnly")
	method any GetMarket(string playerId, string portId)
		-- 維持原回傳 entries/profileCode 契約，資料改由中央 ProfileCode snapshot 提供。
		if _GreatVoyageProfileStore == nil then return nil end
		local loaded = _GreatVoyageProfileStore:GetProfileForUser(playerId)
		if loaded == nil or loaded.profile.markets[portId] == nil then return nil end
		local profile = loaded.profile
		local profileCode = loaded.profileCode
		self.profileByUser[playerId] = profileCode
		local account = self.accounts[profileCode]
		if account == nil then account = { markets = {} } self.accounts[profileCode] = account end
		local market = account.markets[portId]
		if market ~= nil then return market end
		local entries = {}
		for _, row in ipairs(profile.markets[portId]) do
			entries[row[1]] = { pressure = row[2], at = row[3], cycle = row[4], bought = row[5] }
		end
		market = { entries = entries, ready = true, profileCode = profileCode }
		account.markets[portId] = market
		return market
	end

	@ExecSpace("ServerOnly")
	method void MarkDirty(string playerId, string portId, string goodId)
		-- 同步整港市場到中央帳號並增加 generation；本邏輯不呼叫任何 DataStorage writer。
		local profileCode = self.profileByUser[playerId]
		local account = self.accounts[profileCode or ""]
		local market = account and account.markets[portId] or nil
		if market == nil or market.ready ~= true or _GreatVoyageProfileStore == nil then return end
		_GreatVoyageProfileStore:SyncMarket(playerId, portId, market.entries)
	end

	@ExecSpace("ServerOnly")
	method void PublishMarket(string playerId, string portId)
		-- 將中心 profile 的市場投影同步給本人，維持 UI 與 quote API。
		local market = self:GetMarket(playerId, portId)
		if market == nil then self:ReceiveMarket(portId, "", "", self:GetNow(), playerId) return end
		local payload = next(market.entries) == nil and "{}" or _HttpService:JSONEncode(market.entries)
		self:ReceiveMarket(portId, payload, market.profileCode, self:GetNow(), playerId)
	end

	@ExecSpace("Client")
	method void ReceiveMarket(string portId, string payload, string profileCode, number serverTime)
		-- Client 端只保留市場展示投影，永遠不寫入 DataStorage。
		if payload == "" then self.clientMarkets[portId] = nil return end
		self.clientMarkets[portId] = _HttpService:JSONDecode(payload) or {}
		self.clientProfileCode = profileCode
		self.clientServerTime = serverTime
		self.clientReceivedAt = _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method number GetClientNow()
		-- 以收到的 UTC 時間加本地經過時間，避免客戶端時鐘影響報價。
		return self.clientServerTime + math.max(0, _UtilLogic.ElapsedSeconds - self.clientReceivedAt)
	end

	@ExecSpace("ClientOnly")
	method table GetClientQuote(string portId, string goodId, integer quantity)
		-- 客戶端以 server 投影估價；實際成交仍由伺服器重新計算。
		local entries = self.clientMarkets[portId]
		if entries == nil then return { valid = false, total = 0, unitPrice = 0, nextPrice = 0 } end
		return _GreatVoyageMarketPricing:GetSaleQuote(entries, portId, goodId, quantity, self:GetClientNow())
	end

	@ExecSpace("ClientOnly")
	method table GetClientStock(string portId, string goodId)
		-- BOSS 庫存使用同步市場投影與同一 ProfileCode 的個人配額。
		local entries = self.clientMarkets[portId]
		if entries == nil then return { remaining = 0, restockSeconds = 0, ready = false } end
		local stock = _GreatVoyageMarketPricing:GetBossStock(entries, self.clientProfileCode, goodId, self:GetClientNow())
		stock.ready = true
		return stock
	end
end
