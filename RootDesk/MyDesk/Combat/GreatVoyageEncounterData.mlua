	end

	method string GetMonsterHitAnimationRuid(string packId)
		-- 僅回傳該官方 pack 已核實的原生 hit1 clip；未知或無資料時不以飛行動畫冒充受擊。
		local monster = self:GetMonsterById(packId)
		if monster == nil then return "" end
		return monster.hitAnimationRuid or ""
	end

	method number GetMonsterHitChance(string packId)
		-- 只按現有怪物 packId 點名少數靈活小型飛怪與大型目標；其餘沿用一般命中率。
		if self._T.flexibleMonsterIds == nil then
			self._T.flexibleMonsterIds = {
				["mob/2300100.img"] = true, -- 蝙蝠
				["mob/3000001.img"] = true, -- 蝴蝶精
				["mob/3230101.img"] = true, -- 小幽靈
				["mob/3230200.img"] = true, -- 星光精靈
				["mob/3230300.img"] = true, -- 幼魔精靈
				["mob/3210206.img"] = true, -- 黃色戰鬥機
				["mob/3230303.img"] = true, -- 粉紅色戰鬥機
				["mob/3230304.img"] = true, -- 藍色戰鬥機
				["mob/9500197.img"] = true, -- 幽靈
				["mob/9300064.img"] = true, -- 鬼火
				["mob/4230119.img"] = true, -- 馬堤安
				["mob/4230120.img"] = true, -- 培利堤安
			}
		end
		if self._T.largeMonsterIds == nil then
			self._T.largeMonsterIds = {
				["mob/8150300.img"] = true, -- 赤翼龍
				["mob/8150301.img"] = true, -- 藍翼龍
				["mob/8150302.img"] = true, -- 黑翼龍
				["mob/8180001.img"] = true, -- 格瑞芬多
				["mob/8140200.img"] = true, -- 冥鐘
				["mob/8140300.img"] = true, -- 黑暗冥鐘
				["mob/9300511.img"] = true, -- 噴火龍
			}
		end
		if self._T.flexibleMonsterIds[packId] then return 0.82 end
		if self._T.largeMonsterIds[packId] then return 0.96 end
		return 0.92
	end

	method number GetPlayerHitChance(integer tier, string packId, number accuracyBonus)
		-- 船級炮控最多加 10 個百分點；最終命中率限制在 75%～99%。
		local clampedTier = math.max(0, math.min(5, math.floor(tier or 0)))
		local baseChance = self:GetMonsterHitChance(packId)
		return math.max(0.75, math.min(0.99, baseChance + 0.02 * clampedTier + (accuracyBonus or 0)))
	end

	method table GetMonsterById(string packId)
		-- 建立一次 packId 索引並回傳指定物種；未知 ID 回傳 nil。
		if self._T.monstersById == nil then
			self._T.monstersById = {}
			for _, definition in ipairs(self:GetAllMonsters()) do
				self._T.monstersById[definition.packId] = definition
			end
		end
		return self._T.monstersById[packId]
	end

	method table GetShipTier(integer tier)
		-- 快取 T0～T5 遭遇設定並依船級回傳。
		if self._T.shipTiers == nil then
			self._T.shipTiers = {
			[0] = { tier = 0, maxLevel = 30, weights = { 1, 0, 0 }, chance = 0.18, countMin = 1, countMax = 1, cargoReference = 12000, screenLimit = 2 },
			[1] = { tier = 1, maxLevel = 50, weights = { 1, 0, 0 }, chance = 0.25, countMin = 1, countMax = 2, cargoReference = 50000, screenLimit = 3 },
			[2] = { tier = 2, maxLevel = 80, weights = { 0.75, 0.25, 0 }, chance = 0.35, countMin = 2, countMax = 4, cargoReference = 500000, screenLimit = 4 },
			[3] = { tier = 3, maxLevel = 100, weights = { 0.4, 0.6, 0 }, chance = 0.45, countMin = 4, countMax = 7, cargoReference = 5000000, screenLimit = 5 },
			[4] = { tier = 4, maxLevel = 150, weights = { 0.2, 0.55, 0.25 }, chance = 0.55, countMin = 7, countMax = 11, cargoReference = 200000000, screenLimit = 6 },
			[5] = { tier = 5, maxLevel = 999, weights = { 0.1, 0.35, 0.55 }, chance = 0.65, countMin = 10, countMax = 16, cargoReference = 2147483647, screenLimit = 8 },
			}
		end
		return self._T.shipTiers[tier]
	end

	method table GetCombatProfile(integer tier)
		-- 快取各船級固定戰鬥值，不隨貨值或遭遇卡變動。
		if self._T.combatProfiles == nil then
			self._T.combatProfiles = {
			[0] = { maxHull = 100, maxShield = 20, maxArmor = 40, cannonDamage = 20, cannonInterval = 1 },
			[1] = { maxHull = 120, maxShield = 24, maxArmor = 48, cannonDamage = 40, cannonInterval = 1 },
			[2] = { maxHull = 600, maxShield = 150, maxArmor = 300, cannonDamage = 120, cannonInterval = 0.9 },
			[3] = { maxHull = 2000, maxShield = 500, maxArmor = 1000, cannonDamage = 400, cannonInterval = 0.8 },
			[4] = { maxHull = 8000, maxShield = 2000, maxArmor = 4000, cannonDamage = 1200, cannonInterval = 0.7 },
			[5] = { maxHull = 30000, maxShield = 6000, maxArmor = 12000, cannonDamage = 4000, cannonInterval = 0.6 },
			}
		end
		return self._T.combatProfiles[tier]
	end

	method table Prepare(string areaId, integer tier, number cargoValue, number temptation, table stats, boolean fog)
		-- 依船級、空域、貨值與卡片累積值建立候選權重和遭遇參數。
		local bands = { "low", "mid", "high" }
		local function encounterFactor(sum) return math.max(0.1, 1 + (sum or 0)) end
		local definitions = self:GetAllMonsters()
		local ship = self:GetShipTier(tier)
		if ship == nil then error("船級必須為 T0～T5") end
		if cargoValue == nil or cargoValue ~= cargoValue or cargoValue < 0 or cargoValue > 9007199254740991 or cargoValue ~= math.floor(cargoValue) then error("貨物估值須為非負安全整數") end
		if temptation == nil or temptation ~= temptation or temptation < 0 or temptation > 100 then error("誘惑度須在 0～100") end
		local validArea = areaId == "open_sea" or areaId == "victoria" or areaId == "maple" or areaId == "sky" or areaId == "ludus" or areaId == "nihal" or areaId == "leafre" or areaId == "edelstein" or areaId == "herbtown" or areaId == "ereve" or areaId == "rien" or areaId == "crimson" or areaId == "aqua" or areaId == "temple"
		if not validArea then error("未知空域") end
		stats = stats or {}
		local general = encounterFactor(stats.encounterMultiplier)
		if fog == true then general = general * encounterFactor(stats.fogEncounterMultiplier) end
		local pressure = math.log(1 + cargoValue / ship.cargoReference) / math.log(2)
		local attraction = 1 + temptation / 100
		local shift = 1 + pressure * 0.1 + temptation / 200
		local candidates = {}
		local baseTotal = 0
		local modifiedTotal = 0
		for bandIndex, band in ipairs(bands) do
			local bandWeight = ship.weights[bandIndex] * shift ^ (bandIndex - 1)
			if bandWeight > 0 then
				local localCount = 0
				local sharedCount = 0
				for _, definition in ipairs(definitions) do
					if definition.enabled and definition.level ~= nil and definition.level >= 1 and definition.level <= ship.maxLevel and definition.band == band then
						if definition.area == areaId then localCount = localCount + 1 end
						if definition.area == "__allair" then sharedCount = sharedCount + 1 end
					end
				end
				local localShare = sharedCount > 0 and 0.85 or 1
				local sharedShare = localCount > 0 and 0.15 or 1
				for _, definition in ipairs(definitions) do
					if definition.enabled and definition.level ~= nil and definition.level >= 1 and definition.level <= ship.maxLevel and definition.band == band then
						local share = nil
						if definition.area == areaId then share = localShare / localCount end
						if definition.area == "__allair" then share = sharedShare / sharedCount end
						if share ~= nil then
							local baseWeight = bandWeight * share
							local familyDelta = 0
							if definition.family == "wildlife" then familyDelta = stats.monsterEncounterMultiplier or 0 end
							if definition.family == "magic" then familyDelta = stats.magicEncounterMultiplier or 0 end
							local weight = baseWeight * encounterFactor(familyDelta)
							table.insert(candidates, { definition = definition, weight = weight })
							baseTotal = baseTotal + baseWeight
							modifiedTotal = modifiedTotal + weight
						end
					end
				end
			end
		end
		local familyMean = 1
		if baseTotal > 0 then familyMean = modifiedTotal / baseTotal end
		local cardFactor = general * familyMean
		local hazard = (1 + pressure * 0.35) * attraction * cardFactor
		local chance = 0
		local countMin = 0
		local countMax = 0
		if #candidates > 0 then
			chance = math.min(0.95, 1 - (1 - ship.chance) ^ hazard)
			local countFactor = (1 + pressure * 0.35) * (1 + temptation / 200) * math.sqrt(cardFactor)
			countMin = math.max(1, math.floor(ship.countMin * countFactor))
			countMax = math.max(countMin, math.ceil(ship.countMax * countFactor))
		end
		return { chance = chance, countMin = countMin, countMax = countMax, screenLimit = ship.screenLimit, candidates = candidates, totalWeight = modifiedTotal }
	end

	method table DrawWave(table prepared)
		-- 遇敵已由呼叫端確認；此處只抽數量與可重複的混合怪物隊伍。
		local result = {}
		if prepared == nil or prepared.totalWeight == nil or prepared.totalWeight <= 0 then return result end
		local count = _UtilLogic:RandomIntegerRange(prepared.countMin, prepared.countMax)
		for index = 1, count do
			local roll = _UtilLogic:RandomDouble() * prepared.totalWeight
			local cumulative = 0
			local selected = prepared.candidates[#prepared.candidates].definition
			for _, candidate in ipairs(prepared.candidates) do
				cumulative = cumulative + candidate.weight
				if roll < cumulative then selected = candidate.definition break end
			end
			table.insert(result, selected)
		end
		return result
	end
end
