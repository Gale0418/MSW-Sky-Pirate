@Logic
script Phase0VoyagePrototype extends Logic

	property any keyHandler = nil
	property boolean initialized = false
	property string currentPort = "魔法森林"
	property string currentPortId = "forest"
	property string selectedDestinationId = "sky"
	property integer voyageCount = 0
	property integer money = 120
	property integer cloudCrystal = 0
	property integer hull = 100
	property integer maxHull = 100
	property integer shield = 20
	property integer maxShield = 20
	property integer armor = 40
	property integer maxArmor = 40
	property integer structure = 100
	property integer maxStructure = 100
	property integer hullLevel = 1
	property integer shieldLevel = 1
	property integer selectedGoodIndex = 1
	property integer tradeQuantity = 1
	property integer cargoCapacity = 8
	property integer quantity = 0
	property integer cargoGoodIndex = 0
	property string cargoGoodId = ""
	property integer cargoBuyPrice = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if self.initialized == false then
			self.initialized = true
			self:ResetPrototype()
		end
		log("[VoyageState] ready without legacy global hotkeys")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
	end


	@ExecSpace("ClientOnly")
	method void ResetPrototype()
		self.currentPort = "魔法森林"
		self.currentPortId = "forest"
		self.selectedDestinationId = "sky"
		self.voyageCount = 0
		self.money = 120
		self.cloudCrystal = 0
		self.maxHull = 100
		self.hull = self.maxHull
		self.maxShield = 20
		self.shield = self.maxShield
		self.maxArmor = 40
		self.armor = self.maxArmor
		self.maxStructure = 100
		self.structure = self.maxStructure
		self.hull = self.structure
		self.hullLevel = 1
		self.shieldLevel = 1
		self.selectedGoodIndex = 1
		self.tradeQuantity = 1
		self.quantity = 0
		self.cargoGoodIndex = 0
		self.cargoGoodId = ""
		self.cargoBuyPrice = 0
		self:Notify("Phase 0 已重置：魔法森林起航，按 1 出航；5選商品 6買 7賣。")
		self:LogStatus()
	end

	@ExecSpace("ClientOnly")
	method void ShowHelp()
		self:Notify("楓谷雲海空賊王 P0：1出航 2船體 3護盾 4整備 5換商品 6買 7賣 Q/E數量 R重置")
	end

	@ExecSpace("Client")
	method void DamageShipFromRaid(number amount)
		local result = self:ApplyDamage(amount)
		log("[Phase0] raid damage: " .. result)
	end

	@ExecSpace("ClientOnly")
	method void StartVoyage()
		if self.structure <= 0 or self.hull <= 0 then
			self:Notify("船體結構已破損，先按 4 整備或 R 重置。")
			return
		end
		if self.selectedDestinationId == self.currentPortId then
			self:Notify("請先選擇不同的目的港。")
			return
		end
		if self.money < 8 then
			self:Notify("金幣不足以補給出航，按 R 重置本輪。")
			return
		end

		local origin = self.currentPort
		local destination = self:GetDestination()
		local airspace = self:GetAirspaceName()
		self.money = self.money - 8
		self.voyageCount = self.voyageCount + 1
		self:RecoverShield(4)

		local eventRoll = _UtilLogic:RandomIntegerRange(1, 100)
		local eventText = ""
		local rewardMoney = 0
		local rewardCrystal = 0
		local damageText = "無損傷"

		if eventRoll <= 40 then
			eventText = "順風航行"
		elseif eventRoll <= 65 then
			eventText = "漂流寶箱"
			rewardMoney = 20
			rewardCrystal = 1
		elseif eventRoll <= 90 then
			eventText = "空賊小怪騷擾"
			damageText = self:ApplyDamage(18)
		else
			eventText = "大巴前兆"
			rewardCrystal = 2
			damageText = self:ApplyDamage(34)
		end

		self.money = self.money + rewardMoney
		self.cloudCrystal = self.cloudCrystal + rewardCrystal
		self.currentPortId = self.selectedDestinationId
		self.currentPort = self:GetPortName(self.currentPortId)
		if self.currentPortId == "forest" then
			self.selectedDestinationId = "sky"
		else
			self.selectedDestinationId = "forest"
		end

		local result = "第 " .. tostring(self.voyageCount) .. " 航：" .. origin .. " -> " .. destination .. " / " .. airspace .. " / " .. eventText .. " / 事件+" .. tostring(rewardMoney) .. "G 結晶+" .. tostring(rewardCrystal) .. " / " .. damageText
		self:Notify(result)
		self:LogStatus()
	end

	@ExecSpace("ClientOnly")
	method string ApplyDamage(number damage)
		local shieldLoss = 0
		local armorLoss = 0
		local structureLoss = 0
		if self.shield > 0 then
			shieldLoss = math.min(self.shield, damage)
			self.shield = self.shield - shieldLoss
			damage = damage - shieldLoss
		end
		if damage > 0 and self.armor > 0 then
			armorLoss = math.min(self.armor, damage)
			self.armor = self.armor - armorLoss
			damage = damage - armorLoss
		end
		if damage > 0 then
			structureLoss = damage
			self.structure = math.max(0, self.structure - structureLoss)
			self.hull = self.structure
		end
		return "護盾-" .. tostring(shieldLoss) .. " 裝甲-" .. tostring(armorLoss) .. " 結構-" .. tostring(structureLoss)
	end

	@ExecSpace("ClientOnly")
	method void UpgradeHull()
		local costMoney = 70 + (self.hullLevel * 35)
		local costCrystal = self.hullLevel
		if self.money < costMoney or self.cloudCrystal < costCrystal then
			self:Notify("船體升級不足：需要 " .. tostring(costMoney) .. "G / 結晶" .. tostring(costCrystal))
			return
		end
		self.money = self.money - costMoney
		self.cloudCrystal = self.cloudCrystal - costCrystal
		self.hullLevel = self.hullLevel + 1
		self.maxHull = self.maxHull + 28
		self.maxStructure = self.maxHull
		self.structure = self.maxStructure
		self.hull = self.structure
		self:Notify("船體升級完成：Lv." .. tostring(self.hullLevel) .. " / 結構 " .. tostring(self.maxStructure))
		self:LogStatus()
	end

	@ExecSpace("ClientOnly")
	method void UpgradeShield()
		local costMoney = 60 + (self.shieldLevel * 30)
		local costCrystal = self.shieldLevel
		if self.money < costMoney or self.cloudCrystal < costCrystal then
			self:Notify("護盾升級不足：需要 " .. tostring(costMoney) .. "G / 結晶" .. tostring(costCrystal))
			return
		end
		self.money = self.money - costMoney
		self.cloudCrystal = self.cloudCrystal - costCrystal
		self.shieldLevel = self.shieldLevel + 1
		self.maxShield = self.maxShield + 18
		self.shield = self.maxShield
		self:Notify("護盾升級完成：Lv." .. tostring(self.shieldLevel) .. " / 耐久 " .. tostring(self.maxShield))
		self:LogStatus()
	end

	@ExecSpace("ClientOnly")
	method void RefitShip()
		local armorCost = 8
		local structureCost = 24
		local costMoney = armorCost + structureCost
		if self.money < costMoney then
			self:Notify("港口整備金幣不足：需要 " .. tostring(costMoney) .. "G")
			return
		end
		self.money = self.money - costMoney
		self.armor = math.min(self.maxArmor, self.armor + 35)
		self.structure = math.min(self.maxStructure, self.structure + 25)
		self.hull = self.structure
		self.shield = math.min(self.maxShield, self.shield + 8)
		self:Notify("港口整備完成：裝甲+35 / 結構+25 / 護盾+8")
		self:LogStatus()
	end

	@ExecSpace("ClientOnly")
	method string GetDestination()
		return self:GetPortName(self.selectedDestinationId)
	end

	@ExecSpace("ClientOnly")
	method string GetPortName(string portId)
		if _GreatVoyageVoyageData ~= nil then
			local dataName = _GreatVoyageVoyageData:GetPortName(portId)
			if dataName ~= "未知港口" then return dataName end
		end
		if portId == "forest" then return "魔法森林" end
		return "天空之城"
	end

	@ExecSpace("ClientOnly")
	method void SelectDestination(string portId)
		if portId ~= "forest" and portId ~= "sky" then
			return
		end
		if portId == self.currentPortId then
			self:Notify("目的港不能與目前港口相同。")
			return
		end
		self.selectedDestinationId = portId
		self:Notify("目的港已選擇：" .. self:GetPortName(portId))
	end

	@ExecSpace("ClientOnly")
	method string GetGoodName(integer index)
		if _GreatVoyageVoyageData ~= nil then
			local good = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, index)
			if good ~= nil then return good.displayName end
		end
		return "未知商品"
	end

	@ExecSpace("ClientOnly")
	method string GetCargoGoodName()
		-- M1 貨艙只讀取 Server 私有快照；Phase0 本地欄位不再代表可交易資產。
		if _GreatVoyageVoyageState ~= nil and _GreatVoyageVoyageData ~= nil then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			local goodId = ""
			if snapshot.cargo ~= nil then goodId = snapshot.cargo.id or "" end
			local good = _GreatVoyageVoyageData:GetGoodById(goodId)
			if good ~= nil then return good.displayName end
		end
		return "未知商品"
	end

	@ExecSpace("ClientOnly")
	method integer GetCargoSalePrice()
		-- 價格只作 UI 預覽；結算一律由 Server 依玩家實際所在港重算。
		if _GreatVoyageVoyageData == nil or _GreatVoyageVoyageState == nil then return 0 end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		if snapshot.cargo == nil or snapshot.cargo.quantity <= 0 then return 0 end
		return _GreatVoyageVoyageData:GetSalePrice(self.currentPortId, snapshot.cargo.id)
	end

	@ExecSpace("ClientOnly")
	method integer GetCurrentMarketPrice(integer index)
		if _GreatVoyageVoyageData ~= nil then
			local dataPrice = _GreatVoyageVoyageData:GetGoodPrice(self.currentPortId, index)
			return dataPrice
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void CycleTradeGood(integer delta)
		self.selectedGoodIndex = self.selectedGoodIndex + delta
		if self.selectedGoodIndex > 3 then
			self.selectedGoodIndex = 1
		elseif self.selectedGoodIndex < 1 then
			self.selectedGoodIndex = 3
		end
		self:Notify("商品：" .. self:GetGoodName(self.selectedGoodIndex) .. " / " .. tostring(self:GetCurrentMarketPrice(self.selectedGoodIndex)) .. "G")
	end

	@ExecSpace("ClientOnly")
	method void AdjustTradeQuantity(integer delta)
		self.tradeQuantity = math.max(1, math.min(self.cargoCapacity, self.tradeQuantity + delta))
	end

	@ExecSpace("ClientOnly")
	method void BuySelectedGood()
		-- 客戶端只送出意圖；商品上架、價格、錢包與貨艙由 Server 驗證及提交。
		if _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil then
			self:Notify("伺服器商店尚未就緒，無法交易。")
			return
		end
		local good = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, self.selectedGoodIndex)
		if good == nil then return end
		_GreatVoyageVoyageState:BuyGood(good.id, self.tradeQuantity)
		self:Notify("交易請求已送至伺服器，等待確認。")
	end

	@ExecSpace("ClientOnly")
	method void SellCargo()
		-- 舊入口保留給既有 UI，但不再以 ClientOnly 錢包或貨艙自行結算。
		if _GreatVoyageVoyageState == nil then
			self:Notify("伺服器商店尚未就緒，無法交易。")
			return
		end
		_GreatVoyageVoyageState:SellCargo()
		self:Notify("賣出請求已送至伺服器，等待確認。")
	end

	@ExecSpace("ClientOnly")
	method string GetMarketText()
		return "市場 " .. self:GetPortName(self.currentPortId) .. "｜" .. self:GetGoodName(self.selectedGoodIndex) .. " " .. tostring(self:GetCurrentMarketPrice(self.selectedGoodIndex)) .. "G"
	end

	@ExecSpace("ClientOnly")
	method string GetCargoText()
		if _GreatVoyageVoyageState == nil then return "貨艙等待伺服器同步" end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local quantity = 0
		if snapshot.cargo ~= nil then quantity = snapshot.cargo.quantity or 0 end
		if quantity <= 0 then return "貨艙 0/" .. tostring(self.cargoCapacity) end
		return "貨艙 " .. self:GetCargoGoodName() .. " x" .. tostring(quantity) .. "/" .. tostring(self.cargoCapacity) .. "｜本港收購 " .. tostring(self:GetCargoSalePrice()) .. "G/件"
	end

	@ExecSpace("ClientOnly")
	method void RecoverShield(integer amount)
		self.shield = math.min(self.maxShield, self.shield + amount)
	end

	@ExecSpace("ClientOnly")
	method string GetAirspaceName()
		if self.voyageCount % 3 == 2 then
			return "黑雲帶"
		end
		return "普通雲海"
	end

	@ExecSpace("ClientOnly")
	method void Notify(string message)
		log("[Phase0] " .. message)
		_ScreenMessageLogic:PrivateMsg(message)
	end

	@ExecSpace("ClientOnly")
	method void LogStatus()
		log("[Phase0] 狀態：港口=" .. self.currentPort .. " 金幣=" .. tostring(self.money) .. " 結晶=" .. tostring(self.cloudCrystal) .. " 船體=" .. tostring(self.hull) .. "/" .. tostring(self.maxHull) .. " 護盾=" .. tostring(self.shield) .. "/" .. tostring(self.maxShield) .. " 裝甲=" .. tostring(self.armor) .. "/" .. tostring(self.maxArmor) .. " 結構=" .. tostring(self.structure) .. "/" .. tostring(self.maxStructure) .. " 貨艙=" .. self:GetCargoText() .. " Lv=" .. tostring(self.hullLevel) .. "/" .. tostring(self.shieldLevel))
	end

end
