@Logic
script GreatVoyageDeckRaid extends Logic

	property boolean raidActive = false
	property number elapsed = 0
	property any cloudFarA = nil
	property any cloudFarB = nil
	property any keyHandler = nil
	property number voyageAdvanceElapsed = 0
	property boolean deckCameraActive = false
	property any deckCameraPlayer = nil
	property any deckShipEntity = nil
	property any deckCameraEntity = nil
	property any previousActiveCamera = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 舊甲板戰鬥原型暫時休眠，避免在港口全域傳送玩家或搶走輸入。
		log("[DeckRaid] legacy raid dormant")
	end

	@ExecSpace("Server")
	method void RegisterPlayerAttack(string userId)
		-- 舊甲板攻擊已停用；保留 RPC 簽名相容，但不能再替任何玩家新增組件。
		log("[DeckRaid] legacy attack registration disabled")
	end

	@ExecSpace("ClientOnly")
	method void BeginRaid()
		log("[DeckRaid] legacy raid disabled")
	end

	@ExecSpace("Server")
	method void StartRaid()
		log("[DeckRaid] legacy raid spawn disabled")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:RestoreDeckCamera()
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreDeckCamera()
		-- 離開甲板時切回原鏡頭，再移除本機船身的鏡頭組件。
		if self.deckCameraActive then
			local previousCamera = self.previousActiveCamera
			local player = _UserService.LocalPlayer
			if not isvalid(previousCamera) and isvalid(player) then previousCamera = player.CameraComponent end
			if isvalid(previousCamera) then
				local blendTime = _CameraService.TransitionBlendTime
				_CameraService.TransitionBlendTime = 0
				_CameraService:SwitchCameraTo(previousCamera)
				_CameraService.TransitionBlendTime = blendTime
			end
			if isvalid(self.deckCameraEntity) then self.deckCameraEntity:RemoveComponent("CameraComponent") end
			log("[DeckRaid] ship camera released; restored=" .. tostring(isvalid(previousCamera)))
		end
		self.deckCameraActive = false
		self.deckCameraPlayer = nil
		self.deckShipEntity = nil
		self.deckCameraEntity = nil
		self.previousActiveCamera = nil
		self._T.deckCameraCombatProgress = nil
		self._T.deckCameraCombatActive = nil
		self._T.deckCameraOffset = nil
	end

	@ExecSpace("ClientOnly")
	method void UpdateDeckCamera(number delta)
		-- 船身鏡頭不追蹤人物；戰鬥時以 0.7 秒平順移向螢幕右側。
		local player = _UserService.LocalPlayer
		if not isvalid(player) or player.CurrentMapName ~= "map_airship_deck" or player.CameraComponent == nil then
			self:RestoreDeckCamera()
			return
		end
		if self.deckCameraActive and (self.deckCameraPlayer ~= player or not isvalid(self.deckCameraEntity)) then self:RestoreDeckCamera() end
		if not isvalid(self.deckShipEntity) then self.deckShipEntity = _EntityService:GetEntityByPath("/maps/map_airship_deck/GV_PlayerShip") end
		local ship = self.deckShipEntity
		if not isvalid(ship) then return end
		---@type GVShipVisualClient
		local shipVisual = ship:GetComponent("script.GVShipVisualClient")
		if shipVisual == nil or not isvalid(shipVisual.localHullView) or shipVisual.appliedShipId == "" then return end
		local hullView = shipVisual.localHullView
		if self.deckCameraActive and self.deckCameraEntity ~= hullView then self:RestoreDeckCamera() end
		if self.deckCameraActive == false then
			self.previousActiveCamera = _CameraService:GetCurrentCameraComponent()
			if not isvalid(self.previousActiveCamera) then self.previousActiveCamera = player.CameraComponent end
			if hullView.CameraComponent == nil then hullView:AddComponent("CameraComponent") end
			local camera = hullView.CameraComponent
			if camera == nil then return end
			local original = player.CameraComponent
			camera.ZoomRatioMax = original.ZoomRatioMax
			camera.ZoomRatioMin = original.ZoomRatioMin
			camera.ZoomRatio = _CameraService.currentZoomRatio
			camera.DutchAngle = original.DutchAngle
			camera.IsAllowZoomInOut = original.IsAllowZoomInOut
			camera.ConfineCameraArea = false
			camera.ScreenOffset = Vector2(0.5, 0.5)
			camera.Damping = Vector2(0, 0)
			camera.DeadZone = Vector2(0, 0)
			camera.SoftZone = Vector2(0, 0)
			camera.CameraOffset = Vector2(0, 0)
			self.deckCameraPlayer = player
			self.deckCameraEntity = hullView
			self.deckCameraActive = true
			self._T.deckCameraCombatProgress = 0
			self._T.deckCameraCombatActive = nil
			local blendTime = _CameraService.TransitionBlendTime
			_CameraService.TransitionBlendTime = 0
			_CameraService:SwitchCameraTo(camera)
			_CameraService.TransitionBlendTime = blendTime
			log("[DeckRaid] ship camera activated target=" .. hullView.Name)
		end
		local camera = self.deckCameraEntity.CameraComponent
		local screenY = _UILogic.ScreenHeight * 0.5
		local leftWorld = _UILogic:ScreenToWorldPosition(Vector2(0, screenY))
		local rightWorld = _UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth, screenY))
		local viewportWidth = math.abs(rightWorld.x - leftWorld.x)
		local controller = _GreatVoyageAdventureController
		local combatActive = controller ~= nil and controller.clientAirBattle ~= nil and controller.clientAirBattle.phase == "active"
		if self._T.deckCameraCombatActive ~= combatActive then
			self._T.deckCameraCombatActive = combatActive
			log("[DeckRaid] ship camera combat active=" .. tostring(combatActive))
		end
		local progress = self._T.deckCameraCombatProgress or 0
		local step = math.max(0, delta) / 0.7
		if combatActive then progress = math.min(1, progress + step) else progress = math.max(0, progress - step) end
		self._T.deckCameraCombatProgress = progress
		local smoothProgress = progress * progress * (3 - 2 * progress)
		camera.CameraOffset = Vector2(-viewportWidth * 0.20 * smoothProgress, 0)
		self._T.deckCameraOffset = camera.CameraOffset
	end
	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self:UpdateDeckCamera(delta)
		-- 客戶端只發送節拍請求；Server 依實際經過秒數推進 60 秒航程。
		self.voyageAdvanceElapsed = self.voyageAdvanceElapsed + delta
		if self.voyageAdvanceElapsed >= 1.0 then
			self.voyageAdvanceElapsed = 0
			local player = _UserService.LocalPlayer
			if player ~= nil and player.PlayerComponent ~= nil and _GreatVoyageVoyageState ~= nil
				and _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
				_GreatVoyageVoyageState:AdvanceVoyage(1)
			end
		end
	end
end
