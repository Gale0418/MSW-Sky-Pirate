@Logic
script GreatVoyageDeckRaid extends Logic

	property boolean raidActive = false
	property number elapsed = 0
	property any cloudFarA = nil
	property any cloudFarB = nil
	property any keyHandler = nil
	property number voyageAdvanceElapsed = 0
	property boolean deckCameraActive = false
	property any deckCameraPlayer = nil
	property any deckShipEntity = nil
	property any previousCameraOffset = nil
	property any previousScreenOffset = nil
	property any previousCameraDamping = nil
	property any previousCameraDeadZone = nil
	property any previousCameraSoftZone = nil
	property boolean previousCameraConfine = true

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 舊甲板戰鬥原型暫時休眠，避免在港口全域傳送玩家或搶走輸入。
		log("[DeckRaid] legacy raid dormant")
	end

	@ExecSpace("Server")
	method void RegisterPlayerAttack(string userId)
		-- 舊甲板攻擊已停用；保留 RPC 簽名相容，但不能再替任何玩家新增組件。
		log("[DeckRaid] legacy attack registration disabled")
	end

	@ExecSpace("ClientOnly")
	method void BeginRaid()
		log("[DeckRaid] legacy raid disabled")
	end

	@ExecSpace("Server")
	method void StartRaid()
		log("[DeckRaid] legacy raid spawn disabled")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:RestoreDeckCamera()
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreDeckCamera()
		-- 離開飛船甲板後還原玩家原本的鏡頭追蹤設定。
		if self.deckCameraActive == false then return end
		local player = self.deckCameraPlayer
		local deckOffset = self._T.deckCameraOffset
		local originalOffset = self.previousCameraOffset
		local originalScreenOffset = self.previousScreenOffset
		local originalDamping = self.previousCameraDamping
		local originalDeadZone = self.previousCameraDeadZone
		local originalSoftZone = self.previousCameraSoftZone
		local originalConfine = self.previousCameraConfine
		local restored = false
		if player ~= nil and isvalid(player) and player.CameraComponent ~= nil then
			local camera = player.CameraComponent
			camera.CameraOffset = originalOffset
			camera.ScreenOffset = originalScreenOffset
			camera.Damping = originalDamping
			camera.DeadZone = originalDeadZone
			camera.SoftZone = originalSoftZone
			camera.ConfineCameraArea = originalConfine
			restored = true
		end
		self.deckCameraActive = false
		self.deckCameraPlayer = nil
		self.deckShipEntity = nil
		self.previousCameraOffset = nil
		self.previousScreenOffset = nil
		self.previousCameraDamping = nil
		self.previousCameraDeadZone = nil
		self.previousCameraSoftZone = nil
		self._T.deckCameraOffset = nil
		self._T.deckCameraSettleRemaining = nil
		if deckOffset ~= nil then
			log("[DeckRaid] deck camera restored=" .. tostring(restored) .. "; fixedOffset=(" .. tostring(deckOffset.x) .. "," .. tostring(deckOffset.y) .. ") originalOffset=" .. tostring(originalOffset) .. " screen=" .. tostring(originalScreenOffset) .. " damping=" .. tostring(originalDamping) .. " dead=" .. tostring(originalDeadZone) .. " soft=" .. tostring(originalSoftZone) .. " confine=" .. tostring(originalConfine))
		else
			log("[DeckRaid] deck camera restored=" .. tostring(restored) .. "; fixedOffset=uninitialized originalOffset=" .. tostring(originalOffset) .. " screen=" .. tostring(originalScreenOffset) .. " damping=" .. tostring(originalDamping) .. " dead=" .. tostring(originalDeadZone) .. " soft=" .. tostring(originalSoftZone) .. " confine=" .. tostring(originalConfine))
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateDeckCamera(number delta)
		-- 航行時鏡頭固定在船身，玩家能在甲板上移動但不推動船的畫面位置。
		local player = _UserService.LocalPlayer
		if player == nil or player.CurrentMapName ~= "map_airship_deck" or player.CameraComponent == nil or player.TransformComponent == nil then
			self:RestoreDeckCamera()
			return
		end
		local camera = player.CameraComponent
		if self.deckCameraActive and self.deckCameraPlayer ~= player then self:RestoreDeckCamera() end
		if self.deckShipEntity == nil or not isvalid(self.deckShipEntity) then
			self.deckShipEntity = _EntityService:GetEntityByPath("/maps/map_airship_deck/GV_PlayerShip")
		end
		local ship = self.deckShipEntity
		if ship == nil or ship.TransformComponent == nil then return end
		if self.deckCameraActive == false then
			self.previousCameraOffset = camera.CameraOffset
			self.previousScreenOffset = camera.ScreenOffset
			self.previousCameraDamping = camera.Damping
			self.previousCameraDeadZone = camera.DeadZone
			self.previousCameraSoftZone = camera.SoftZone
			self.previousCameraConfine = camera.ConfineCameraArea
			self.deckCameraPlayer = player
			self.deckCameraActive = true
			camera.ConfineCameraArea = false
			camera.ScreenOffset = Vector2(0.5, 0.5)
			camera.Damping = Vector2(0, 0)
			camera.DeadZone = Vector2(0, 0)
			camera.SoftZone = Vector2(0, 0)
			self._T.deckCameraSettleRemaining = 0.2
		end
		if self._T.deckCameraSettleRemaining ~= nil and self._T.deckCameraSettleRemaining > 0 then
			local shipPosition = ship.TransformComponent.WorldPosition
			local playerPosition = player.TransformComponent.WorldPosition
			-- 短暫沿用船／玩家差值置中，避免沿用港口鏡頭位置直接鎖定。
			local targetOffset = Vector2(shipPosition.x - 0.63 - playerPosition.x, shipPosition.y - 0.49 - playerPosition.y)
			camera.CameraOffset = targetOffset
			self._T.deckCameraSettleRemaining = math.max(0, self._T.deckCameraSettleRemaining - delta)
			if self._T.deckCameraSettleRemaining == 0 then
				self._T.deckCameraOffset = targetOffset
				camera.DeadZone = Vector2(1, 1)
				camera.SoftZone = Vector2(1, 1)
				self._T.deckCameraSettleRemaining = nil
				log("[DeckRaid] deck camera locked; fixedOffset=(" .. tostring(self._T.deckCameraOffset.x) .. "," .. tostring(self._T.deckCameraOffset.y) .. ") dead=(1,1) soft=(1,1) damping=(0,0) screen=(0.5,0.5) confine=false")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self:UpdateDeckCamera(delta)
		-- 客戶端只發送節拍請求；Server 依實際經過秒數推進 60 秒航程。
		self.voyageAdvanceElapsed = self.voyageAdvanceElapsed + delta
		if self.voyageAdvanceElapsed >= 1.0 then
			self.voyageAdvanceElapsed = 0
			local player = _UserService.LocalPlayer
			if player ~= nil and player.PlayerComponent ~= nil and _GreatVoyageVoyageState ~= nil
				and _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
				_GreatVoyageVoyageState:AdvanceVoyage(1)
			end
		end
	end
end
