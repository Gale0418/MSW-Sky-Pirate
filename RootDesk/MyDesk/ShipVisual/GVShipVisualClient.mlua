@Component
script GVShipVisualClient extends Component

	property Entity localHullView = nil
	property Entity localEngineView = nil
	property Entity localForegroundView = nil
	property boolean localViewsActive = false
	property boolean snapshotRequestedForMap = false
	property string appliedShipId = ""
	property number refreshElapsed = 0
	property Entity localBattleEnemy = nil
	property Entity localBattleShot = nil
	property Entity localEnemyShot = nil
	property string appliedBattleId = ""
	property number battleVisualElapsed = 0
	property number shotElapsed = 1
	property number shotFlightSeconds = 0.6
	property integer lastPlayerShotSequence = 0
	property integer lastEnemyShotSequence = 0
	property number enemyHitFlashRemaining = 0
	property number lastEnemyHp = -1
	property number enemyShotElapsed = 1
	-- 兩種官方炮彈素材原生朝左，視覺旋轉需補 180 度對準飛行方向。
	property number cannonSpriteFacingOffset = 180
	property number enemyShotSpriteFacingOffset = 180

	property string impactAnimationRuid = "326fbe9630c34a0ab85b3b026ba92726"
	property string cannonAnimationRuid = "971a992dfd0a446bb4f0efb69fa591d7"

	property string overlayModelId = "gvshipvisualoverlay"
	property string engineAnimationRuid = "0b374aeaf9284ab0ae0b6e6ea1be57c8"
	property string starterFrontRuid = "90ab86820946481da03cf9880f8c216b"
	property string forestFrontRuid = "114e37b9d4ce4c44943cec46abf47a2e"
	property string gearFrontRuid = "4bbf5312bf874748b374af1598be7e5f"
	property string redFrontRuid = "86838173f97140d1911c35bac0cd9b4a"
	property string merchantFrontRuid = "7ee37e4f9ded46799b17416bd1c9867c"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 建立本地船視覺；港口泊位仍由地圖錨點管理。
		_DamageSkinService:PreloadAsync("3271c3e79bf04ecba9a107d55495970d",function(ok) end)
		local map = self.Entity.CurrentMap
		self:RefreshLocalMapState()
		log("[VRF] dock ship host ready map=" .. tostring(map))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self:UpdateBattleDamageNumbers()
		self:UpdateBattleVisuals(delta)
		self.refreshElapsed = self.refreshElapsed + delta
		if self.refreshElapsed < 0.2 then return end
		self.refreshElapsed = 0
		self:RefreshLocalMapState()
		if self.localViewsActive == false then return end
		self:SyncOverlayTransforms()
		self:ApplySelectedShip()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:ReleaseLocalViews()
	end

	@ExecSpace("ClientOnly")
	method void RefreshLocalMapState()
		local player = _UserService.LocalPlayer
		local map = self.Entity.CurrentMap
		local shouldBeActive = player ~= nil and map ~= nil and player.CurrentMap == map
		if shouldBeActive == self.localViewsActive then return end
		if shouldBeActive then
			if self:CreateLocalViews() == false then return end
			self.localViewsActive = true
			self:ApplySelectedShip()
			self:SyncOverlayTransforms()
			log("[GVShipVisual] local views entered map=" .. map.Name)
		else
			self:ReleaseLocalViews()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean CreateLocalViews()
		local map = self.Entity.CurrentMap
		local sourceTransform = self.Entity.TransformComponent
		if map == nil or sourceTransform == nil then return false end
		local spawnPosition = sourceTransform.WorldPosition
		local hullView = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalShipHull", spawnPosition, map)
		local engineView = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalShipEngine", spawnPosition, map)
		local foregroundView = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalShipForeground", spawnPosition, map)
		if hullView == nil or engineView == nil or foregroundView == nil or isvalid(hullView) == false or isvalid(engineView) == false or isvalid(foregroundView) == false then
			if hullView ~= nil and isvalid(hullView) then hullView:Destroy() end
			if engineView ~= nil and isvalid(engineView) then engineView:Destroy() end
			if foregroundView ~= nil and isvalid(foregroundView) then foregroundView:Destroy() end
			log_warning("[GVShipVisual] local overlay spawn failed; will retry")
			return false
		end
		self.localHullView = hullView
		self.localEngineView = engineView
		self.localForegroundView = foregroundView
		local hullTransform = hullView.TransformComponent
		local hullRenderer = hullView.SpriteRendererComponent
		local engineTransform = engineView.TransformComponent
		local engineRenderer = engineView.SpriteRendererComponent
		local foregroundTransform = foregroundView.TransformComponent
		local foregroundRenderer = foregroundView.SpriteRendererComponent
		if hullTransform == nil or hullRenderer == nil or engineTransform == nil or engineRenderer == nil or foregroundTransform == nil or foregroundRenderer == nil then
			self:ReleaseLocalViews()
			log_warning("[GVShipVisual] local overlay components not ready; will retry")
			return false
		end
		hullRenderer.Enable = false
		engineRenderer.Enable = false
		foregroundRenderer.Enable = false
		self.appliedShipId = ""
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean SyncOverlayTransforms()
		local map = self.Entity.CurrentMap
		local mapTransform = nil
		local sourceTransform = self.Entity.TransformComponent
		if map ~= nil then mapTransform = map.TransformComponent end
		if map == nil or sourceTransform == nil then return false end
		local scale = sourceTransform.Scale
		local hostPosition = sourceTransform.WorldPosition
		local hullOffset = self:GetHullVisualOffset(self.appliedShipId)
		local hullWorldPosition = hostPosition + Vector3(hullOffset.x, hullOffset.y, 0)
		local mapPosition = hullWorldPosition
		if mapTransform ~= nil then mapPosition = mapTransform:ToLocalPoint(hullWorldPosition) end
		local sourceRotation = sourceTransform.WorldRotation
		local flipped = self:GetMapFlipX()
		local sortingLayer = self:GetMapSortingLayer()
		local shipId = self.appliedShipId
		local engineOffset = self:GetEngineOffset(shipId)
		local direction = 1
		local engineAngle = -90
		if flipped then
			direction = -1
			engineAngle = 90
		end
		if self.localHullView ~= nil and isvalid(self.localHullView) then
			local hullTransform = self.localHullView.TransformComponent
			local hullRenderer = self.localHullView.SpriteRendererComponent
			if hullTransform ~= nil then
				hullTransform.Position = mapPosition
				hullTransform.Scale = scale
				hullTransform.Rotation = sourceRotation
			else return false end
			if hullRenderer ~= nil then
				hullRenderer.SortingLayer = sortingLayer
				hullRenderer.OrderInLayer = 0
				hullRenderer.FlipX = flipped
			end
		end
		if self.localEngineView ~= nil and isvalid(self.localEngineView) then
			local engineTransform = self.localEngineView.TransformComponent
			local engineRenderer = self.localEngineView.SpriteRendererComponent
			if engineTransform ~= nil then
				local worldEnginePosition = hostPosition + Vector3(hullOffset.x + engineOffset.x * scale.x * direction, hullOffset.y + engineOffset.y * scale.y, 0.01)
				engineTransform.Position = worldEnginePosition
				if mapTransform ~= nil then engineTransform.Position = mapTransform:ToLocalPoint(worldEnginePosition) end
				engineTransform.Scale = scale
				engineTransform.Rotation = Vector3(sourceRotation.x, sourceRotation.y, sourceRotation.z + engineAngle)
			else return false end
			if engineRenderer ~= nil then
				engineRenderer.SortingLayer = sortingLayer
				engineRenderer.OrderInLayer = -1
				engineRenderer.FlipX = false
			end
		end
		if self.localForegroundView ~= nil and isvalid(self.localForegroundView) then
			local foregroundTransform = self.localForegroundView.TransformComponent
			local foregroundRenderer = self.localForegroundView.SpriteRendererComponent
			if foregroundTransform ~= nil then
				-- 甲板前舷不能沿用背景船圖的 Z=999.9，否則仍可能落在人物深度之後。
				local foregroundPosition = hullWorldPosition
				-- 小風帆前景內容比底圖低約 25 px，沿船身局部座標校正，縮放／旋轉時也能對齊。
				if shipId == "small_sampan" and isvalid(self.localHullView) then
					foregroundPosition = self.localHullView.TransformComponent:ToWorldPoint(Vector3(0, 0.25, 0))
				end
				if map.Name == "map_airship_deck" then foregroundPosition = Vector3(foregroundPosition.x, foregroundPosition.y, -0.1) end
				if mapTransform ~= nil then foregroundPosition = mapTransform:ToLocalPoint(foregroundPosition) end
				foregroundTransform.Position = foregroundPosition
				local foregroundScale = scale
				if shipId == "small_sampan" or shipId == "forest" then
					foregroundScale = Vector3(scale.x * 1448 / 1447, scale.y * 1086 / 1087, scale.z)
				end
				foregroundTransform.Scale = foregroundScale
				foregroundTransform.Rotation = sourceRotation
			else return false end
			if foregroundRenderer ~= nil then
				-- 前舷與人物使用同一地圖圖層，以 OrderInLayer 明確排在人物前方。
				foregroundRenderer.SortingLayer = sortingLayer
				foregroundRenderer.OrderInLayer = self:GetMapFrontOrder()
				foregroundRenderer.FlipX = flipped
			end
		end
		if self.appliedShipId ~= "" then
			local hullRenderer = self.localHullView.SpriteRendererComponent
			local engineRenderer = self.localEngineView.SpriteRendererComponent
			local foregroundRenderer = self.localForegroundView.SpriteRendererComponent
			if hullRenderer ~= nil and engineRenderer ~= nil and foregroundRenderer ~= nil then
				hullRenderer.Enable = true
				engineRenderer.Enable = true
				foregroundRenderer.Enable = true
			end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void ApplySelectedShip()
		if self.localHullView == nil or isvalid(self.localHullView) == false then return end
		local state = _GreatVoyageVoyageState
		local data = _GreatVoyageVoyageData
		if state == nil or data == nil then return end
		local ship = state.clientShip
		if ship == nil or ship.id == nil then
			if self.snapshotRequestedForMap == false and state.RequestShipSnapshot ~= nil then
				self.snapshotRequestedForMap = true
				state:RequestShipSnapshot()
				log("[GVShipVisual] requested ship snapshot on map entry")
			end
			return
		end
		local shipId = ship.id
		local definition = data:GetShipById(shipId)
		if definition == nil or definition.spriteRuid == nil or definition.spriteRuid == "" then
			log_warning("[GVShipVisual] catalog entry missing sprite ship=" .. tostring(shipId))
			return
		end
		if shipId == self.appliedShipId then return end
		local hullRenderer = self.localHullView.SpriteRendererComponent
		if hullRenderer == nil then return end
		hullRenderer.SpriteRUID = definition.spriteRuid
		if self.localEngineView ~= nil and isvalid(self.localEngineView) and self.localEngineView.SpriteRendererComponent ~= nil then
			self.localEngineView.SpriteRendererComponent.SpriteRUID = self.engineAnimationRuid
		end
		if self.localForegroundView ~= nil and isvalid(self.localForegroundView) and self.localForegroundView.SpriteRendererComponent ~= nil then
			local foregroundRenderer = self.localForegroundView.SpriteRendererComponent
			foregroundRenderer.SpriteRUID = self:GetForegroundRuid(shipId)
			foregroundRenderer.Enable = false
		end
		self.appliedShipId = shipId
		self:SyncOverlayTransforms()
		log("[GVShipVisual] local ship applied id=" .. shipId .. " engineFrames=11 visualConfirmed=false")
	end

	@ExecSpace("ClientOnly")
	method string GetForegroundRuid(string shipId)
		if shipId == "forest" then return self.forestFrontRuid end
		if shipId == "gear" then return self.gearFrontRuid end
		if shipId == "red" then return self.redFrontRuid end
		if shipId == "merchant" then return self.merchantFrontRuid end
		return self.starterFrontRuid
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetEngineOffset(string shipId)
		-- Initial local sprite-unit offsets (100 px = 1 unit); tune in Maker without moving the foothold.
		if shipId == "forest" then return Vector2(5.1, -1.5) end
		if shipId == "gear" then return Vector2(5.0, -0.6) end
		if shipId == "red" then return Vector2(5.7, -1.0) end
		if shipId == "merchant" then return Vector2(6.0, -1.1) end
		return Vector2(6.0, -1.6)
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetHullVisualOffset(string shipId)
		-- 對齊甲板站立高度；前景資產誤差由前舷自身校正，不移動整艘船補償。
		if shipId == "forest" or shipId == "gear" then return Vector2(0, 0.106) end
		if shipId == "red" then return Vector2(0, 0.266) end
		if shipId == "merchant" then return Vector2(0, -0.134) end
		return Vector2(0, 0.366)
	end

	@ExecSpace("ClientOnly")
	method boolean GetMapFlipX()
		-- 每港泊位的朝向由地圖船錨點設定，讓新港可直接在 Maker 調整。
		local renderer = self.Entity.SpriteRendererComponent
		return renderer ~= nil and renderer.FlipX
	end

	@ExecSpace("ClientOnly")
	method string GetMapSortingLayer()
		-- 船身、引擎與前舷共用各港船錨點的圖層。
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil and renderer.SortingLayer ~= "" then return renderer.SortingLayer end
		return "MapLayer6"
	end

	@ExecSpace("ClientOnly")
	method integer GetMapFrontOrder()
		local map = self.Entity.CurrentMap
		if map ~= nil and map.Name == "map_ludus_port" then return 3 end
		return 10
	end

	@ExecSpace("ClientOnly")
	method void ReleaseLocalViews()
		self:ReleaseBattleVisuals()
		for _,entry in ipairs(self._T.damageNumbers or {}) do if isvalid(entry.entity) then entry.entity:Destroy() end end
		self._T.damageNumbers = {}
		if self.localHullView ~= nil and isvalid(self.localHullView) then self.localHullView:Destroy() end
		if self.localEngineView ~= nil and isvalid(self.localEngineView) then self.localEngineView:Destroy() end
		if self.localForegroundView ~= nil and isvalid(self.localForegroundView) then self.localForegroundView:Destroy() end
		self.localHullView = nil
		self.localEngineView = nil
		self.localForegroundView = nil
		self.appliedShipId = ""
		self.snapshotRequestedForMap = false
		self.localViewsActive = false
		log("[GVShipVisual] local views released")
	end

	@ExecSpace("ClientOnly")
	method string GetBattleAnimationRuid(string enemyId)
		-- 全部採用人工分類表已核實的 MSW 動畫，不再只認五種舊怪。
		local monster = _GreatVoyageEncounterData:GetMonsterById(enemyId)
		if monster == nil then return "" end
		return monster.animationRuid
	end
	@ExecSpace("ClientOnly")
	method Vector3 GetBattleEnemyPosition()
		-- Keep the encounter in the left open sky across viewport sizes and camera zooms.
		local anchor = _UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth * 0.094, _UILogic.ScreenHeight * 0.561))
		return Vector3(anchor.x + math.sin(self.battleVisualElapsed * 1.5) * 0.2, anchor.y + math.sin(self.battleVisualElapsed * 3) * 0.12, 0)
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleMuzzlePosition()
		-- 依各船 PNG 的砲口座標換算世界位置；跟隨船身縮放、旋轉及翻面。
		local point = Vector3(-6.19, 0.43, 0)
		if self.appliedShipId == "forest" then point = Vector3(-6.19, 1.13, 0)
		elseif self.appliedShipId == "gear" then point = Vector3(-5.94, 0.75, 0)
		elseif self.appliedShipId == "red" then point = Vector3(-5.94, 0.53, 0)
		elseif self.appliedShipId == "merchant" then point = Vector3(-6.44, 1.43, 0) end
		if self:GetMapFlipX() then point.x = -point.x end
		if isvalid(self.localHullView) and self.localHullView.TransformComponent ~= nil then
			local world = self.localHullView.TransformComponent:ToWorldPoint(point)
			return Vector3(world.x, world.y, 0)
		end
		return self:GetBattleShipPosition()
	end

	@ExecSpace("ClientOnly")
	method Vector3 BattleWorldToLocal(Vector3 worldPosition)
		-- 特效掛在地圖下，寫 Position 前先由世界座標轉成父層座標。
		local map = self.Entity.CurrentMap
		if map ~= nil and map.TransformComponent ~= nil then return map.TransformComponent:ToLocalPoint(worldPosition) end
		return worldPosition
	end

	@ExecSpace("ClientOnly")
	method void PreloadBattleMonsterHitAnimations(table wave)
		-- 只預載當前 airWave 已上場物種，按 RUID 快取請求與成功結果。
		if wave == nil or wave.enemies == nil then return end
		if self._T.hitAnimationPreloadRequested == nil then self._T.hitAnimationPreloadRequested = {} end
		if self._T.preloadedHitAnimationRuids == nil then self._T.preloadedHitAnimationRuids = {} end
		local requested = self._T.hitAnimationPreloadRequested
		local loaded = self._T.preloadedHitAnimationRuids
		local ruidList = {}
		for _, enemy in ipairs(wave.enemies) do
			local packId = enemy.id or enemy.packId
			if packId ~= nil and packId ~= "" then
				local hitRuid = _GreatVoyageEncounterData:GetMonsterHitAnimationRuid(packId)
				if hitRuid ~= nil and hitRuid ~= "" and requested[hitRuid] ~= true and loaded[hitRuid] ~= true then
					requested[hitRuid] = true
					table.insert(ruidList, hitRuid)
				end
			end
		end
		if #ruidList > 0 then
			_ResourceService:PreloadAsync(ruidList, function(results)
				local succeeded = 0
				for index, ruid in ipairs(ruidList) do
					if results ~= nil and results[index] == PreloadResultStatus.Success then
						loaded[ruid] = true
						succeeded = succeeded+1
					end
				end
				if isvalid(self.Entity) then log("[VRF] wave hit clips preloaded n=" .. tostring(succeeded) .. "/" .. tostring(#ruidList)) end
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void StartBattleHitPose(integer uid, string packId, string originalRuid)
		-- 命中只切換伺服器鎖定 UID；MISS 不會呼叫此方法。
		if uid == nil or packId == nil or packId == "" then return end
		local hitRuid = _GreatVoyageEncounterData:GetMonsterHitAnimationRuid(packId)
		if hitRuid == nil or hitRuid == "" then return end
		local view = self._T.waveViews and self._T.waveViews[uid] or nil
		if not isvalid(view) or view.SpriteRendererComponent == nil or view.TransformComponent == nil then return end
		if self._T.hitPoses == nil then self._T.hitPoses = {} end
		local pose = self._T.hitPoses[uid]
		if pose == nil then
			pose = {packId=packId, hitRuid=hitRuid, originalRuid=originalRuid, remaining=0.3, position=view.TransformComponent.Position}
			self._T.hitPoses[uid] = pose
		else
			pose.packId = packId
			pose.hitRuid = hitRuid
			pose.originalRuid = originalRuid
			pose.remaining = 0.3
			pose.position = view.TransformComponent.Position
		end
		if view.SpriteRendererComponent.SpriteRUID ~= hitRuid then view.SpriteRendererComponent.SpriteRUID = hitRuid end
		log("[VRF] monster hit pose uid=" .. tostring(uid) .. " pack=" .. packId .. " ruid=" .. hitRuid)
	end

	@ExecSpace("ClientOnly")
	method void UpdateBattleHitPoses(number delta, table wave)
		-- 活體在 pose 後還原主 clip；已離開 roster 的死亡 UID 留到 0.3 秒結束再回收。
		local poses = self._T.hitPoses
		if poses == nil or wave == nil or wave.id ~= self.appliedBattleId then return end
		local active = {}
		for _, enemy in ipairs((wave and wave.enemies) or {}) do active[enemy.uid] = enemy end
		for uid, pose in pairs(poses) do
			local enemy = active[uid]
			if enemy == nil and pose.isDead ~= true then
				local view = self._T.waveViews and self._T.waveViews[uid] or nil
				if isvalid(view) and view.TransformComponent ~= nil then pose.position = view.TransformComponent.Position end
			end
			pose.isDead = enemy == nil
			if enemy ~= nil then pose.originalRuid = enemy.animationRuid or pose.originalRuid end
			pose.remaining = math.max(0, (pose.remaining or 0)-delta)
			if pose.remaining <= 0 then
				local view = self._T.waveViews and self._T.waveViews[uid] or nil
				if isvalid(view) then
					if pose.isDead then
						view:Destroy()
						self._T.waveViews[uid] = nil
					else
						local renderer = view.SpriteRendererComponent
						if renderer ~= nil and pose.originalRuid ~= nil and renderer.SpriteRUID ~= pose.originalRuid then renderer.SpriteRUID = pose.originalRuid end
					end
				end
				poses[uid] = nil
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void LoadBattleEnemyCenter(string animationRuid)
		-- 預載完成後快取素材中心；失敗隔秒重試，最多三次，不在每幀同步載入。
		if animationRuid == nil or animationRuid == "" then return end
		if self._T.enemyCenterCache == nil then self._T.enemyCenterCache = {} end
		if self._T.enemyCenterReady == nil then self._T.enemyCenterReady = {} end
		if self._T.enemyMissRadius == nil then self._T.enemyMissRadius = {} end
		if self._T.enemyTopOffsetCache == nil then self._T.enemyTopOffsetCache = {} end
		if self._T.enemyCenterLoads == nil then self._T.enemyCenterLoads = {} end
		if self._T.enemyCenterReady[animationRuid] then return end
		local load = self._T.enemyCenterLoads[animationRuid]
		if load == nil then load = {tries=0, retryAt=0, loading=false} self._T.enemyCenterLoads[animationRuid] = load end
		if load.loading or load.tries >= 3 or _UtilLogic.ElapsedSeconds < load.retryAt then return end
		load.loading = true
		load.tries = load.tries+1
		self._T.enemyCenterCache[animationRuid] = Vector2(0,0)
		_ResourceService:PreloadAsync({animationRuid}, function(results)
			if not isvalid(self.Entity) then load.loading = false return end
			local clip = _ResourceService:LoadAnimationClipAndWait(animationRuid)
			local x,y,count,radius,topOffset = 0,0,0,0,0
			if clip ~= nil and clip.IsLoadComplete then
				for _, frame in ipairs(clip.Frames:ToTable()) do
					local sprite = frame.FrameSprite
					if sprite ~= nil and sprite.IsLoadComplete and sprite.PixelPerUnit > 0 then
						x = x+(sprite.Width*0.5-sprite.PivotPixel.x)/sprite.PixelPerUnit
						y = y+(sprite.Height*0.5-sprite.PivotPixel.y)/sprite.PixelPerUnit
						topOffset = math.max(topOffset,(sprite.Height-sprite.PivotPixel.y)/sprite.PixelPerUnit)
						local rx = math.max(math.abs(sprite.PivotPixel.x), math.abs(sprite.Width-sprite.PivotPixel.x))/sprite.PixelPerUnit
						local ry = math.max(math.abs(sprite.PivotPixel.y), math.abs(sprite.Height-sprite.PivotPixel.y))/sprite.PixelPerUnit
						radius = math.max(radius,math.sqrt(rx*rx+ry*ry))
						count = count+1
					end
				end
			end
			load.loading = false
			if count > 0 then
				self._T.enemyCenterCache[animationRuid] = Vector2(x/count,y/count)
				local ox,oy = x/count,y/count
				self._T.enemyMissRadius[animationRuid] = (radius+math.sqrt(ox*ox+oy*oy))*1.5+0.25
				self._T.enemyTopOffsetCache[animationRuid] = topOffset*1.5
				self._T.enemyCenterReady[animationRuid] = true
				log("[VRF] enemy center ready ruid=" .. animationRuid .. " offset=" .. tostring(self._T.enemyCenterCache[animationRuid]))
			else
				load.retryAt = _UtilLogic.ElapsedSeconds+1
				log_warning("[AirBattleVisual] enemy center load failed ruid=" .. animationRuid .. " attempt=" .. tostring(load.tries))
			end
		end)
	end
	@ExecSpace("ClientOnly")
	method Vector3 GetBattleEnemyCenter(Vector3 enemyPosition, string animationRuid)
		-- 官方敵人朝右翻面，中心 X 偏移也跟著翻面；縮放與實際敵人一致。
		local offset = Vector2(0, 0)
		if self._T.enemyCenterCache ~= nil then offset = self._T.enemyCenterCache[animationRuid] or offset end
		return Vector3(enemyPosition.x - offset.x * 1.5, enemyPosition.y + offset.y * 1.5, 0)
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleShipPosition()
		-- 敵彈瞄準本地船身視覺錨點，不瞄準玩家 Avatar。
		if isvalid(self.localHullView) and self.localHullView.TransformComponent ~= nil then
			return self.localHullView.TransformComponent.WorldPosition
		end
		local transform = self.Entity.TransformComponent
		if transform ~= nil then return transform.WorldPosition end
		return Vector3(-3.5, -0.8, 0)
	end

	@ExecSpace("ClientOnly")
	method number GetProjectileRotation(Vector3 startPosition, Vector3 targetPosition, number spriteFacingOffset)
		-- TransformComponent.Rotation 使用 Euler 度數；資產校正值可在 Maker 依圖檔軸向調整。
		local dx = targetPosition.x - startPosition.x
		local dy = targetPosition.y - startPosition.y
		local angle = 0
		if math.abs(dx) <= 0.0001 then
			angle = dy >= 0 and 90 or -90
		elseif dx < 0 then
			angle = math.atan(dy / dx) * 180 / math.pi + 180
		else
			angle = math.atan(dy / dx) * 180 / math.pi
		end
		return angle + spriteFacingOffset
	end

	@ExecSpace("ClientOnly")
	method void ShowBattleImpact(Vector3 worldPosition)
		-- 官方投射物 endEff 爆炸只播一次；序列命中時觸發，不隨 HP 更新重播。
		local options = {SortingLayer = "MapLayer7", OrderInLayer = 30}
		local serial = _EffectService:PlayEffect(self.impactAnimationRuid, self.Entity.CurrentMap, worldPosition, 0, Vector3(0.8, 0.8, 1), false, options)
		if serial ~= 0 then
			if self._T.impactSerials == nil then self._T.impactSerials = {} end
			table.insert(self._T.impactSerials, serial)
			if #self._T.impactSerials > 8 then table.remove(self._T.impactSerials, 1) end
		end
		log("[AirBattleVisual] impact started seq=" .. tostring(self.lastPlayerShotSequence) .. " serial=" .. tostring(serial) .. " center=" .. tostring(worldPosition))
	end

	@ExecSpace("ClientOnly")

	method void UpdateBattleVisuals(number delta)
		-- UID 獨立飛行；發射前算攔截點，出膛後固定直線與角度，完全不追蹤。
		local player = _UserService.LocalPlayer
		local map = self.Entity.CurrentMap
		local controller = _GreatVoyageAdventureController
		local battle = controller and controller.clientAirBattle or nil
		if battle ~= nil and battle.phase == "won" and self._T.completedBattleId == battle.id then return end
		local renderBattle = battle ~= nil and (battle.phase == "active" or battle.phase == "won")
		if not isvalid(player) or not isvalid(map) or player.CurrentMap ~= map or map.Name ~= "map_airship_deck" or not renderBattle then
			if self.appliedBattleId ~= "" then self:ReleaseBattleVisuals() end
			return
		end
		if self.appliedBattleId ~= battle.id then
			self:ReleaseBattleVisuals()
			local shot = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalCannonShot", self:GetBattleMuzzlePosition(), map)
			local enemyShot = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalEnemyShot", self:GetBattleEnemyPosition(), map)
			self.localBattleShot = shot
			self.localEnemyShot = enemyShot
			if not isvalid(shot) or not isvalid(enemyShot) or shot.SpriteRendererComponent == nil or enemyShot.SpriteRendererComponent == nil or shot.TransformComponent == nil or enemyShot.TransformComponent == nil then
				self:ReleaseBattleVisuals()
				return
			end
			shot.SpriteRendererComponent.SpriteRUID = self.cannonAnimationRuid
			shot.SpriteRendererComponent.SortingLayer = self:GetMapSortingLayer()
			shot.SpriteRendererComponent.OrderInLayer = 21
			shot.SpriteRendererComponent.Color = Color(1, 1, 1, 1)
			shot.SpriteRendererComponent.Enable = false
			shot.TransformComponent.Scale = Vector3(1.4, 1.4, 1)
			enemyShot.SpriteRendererComponent.SpriteRUID = "7543d83767874b968f6871068931bd2e"
			enemyShot.SpriteRendererComponent.SortingLayer = self:GetMapSortingLayer()
			enemyShot.SpriteRendererComponent.OrderInLayer = 21
			enemyShot.SpriteRendererComponent.Color = Color(0.4, 0.8, 1, 1)
			enemyShot.SpriteRendererComponent.Enable = false
			enemyShot.TransformComponent.Scale = Vector3(2, 2, 1)
			_ResourceService:PreloadAsync({self.impactAnimationRuid}, function(results) end)
			self.appliedBattleId = battle.id
			log("[VRF] roaming battle created id=" .. battle.id)
		end
		if not isvalid(self.localBattleShot) or not isvalid(self.localEnemyShot) then self:ReleaseBattleVisuals() return end
		self.battleVisualElapsed = self.battleVisualElapsed + delta
		self.shotElapsed = self.shotElapsed + delta
		self.enemyShotElapsed = self.enemyShotElapsed + delta
		self.enemyHitFlashRemaining = math.max(0, self.enemyHitFlashRemaining-delta)
		local shot = self:GetBattlePlayerShot(battle)
		if shot ~= nil and shot.sequence > self.lastPlayerShotSequence then
			self:LoadBattleEnemyCenter(shot.animationRuid)
			-- 中心尚未預載完成時等待，不能先瞄腳底、再於飛行途中偷偷修正落點。
			if self._T.enemyCenterReady ~= nil and self._T.enemyCenterReady[shot.animationRuid] then
				if self.lastPlayerShotSequence > (self._T.lastImpactSequence or 0) then
					self:CompletePlayerShotVisual(self._T.playerShotEndPosition)
				end
				local wave = controller._T.airWave
				local age = math.max(0, _UtilLogic.ElapsedSeconds-(wave.receivedAt or _UtilLogic.ElapsedSeconds))
				self.lastPlayerShotSequence = shot.sequence
				self.shotElapsed = math.max(0, (shot.elapsed or 0)+age)
				self.shotFlightSeconds = math.max(0.01, shot.flightSeconds or 0.6)
				self._T.playerShotTargetUid = shot.targetUid
				self._T.playerShotTargetRuid = shot.animationRuid
				self._T.playerShotTargetPackId = shot.targetId
				self._T.playerShotStartPosition = self:GetBattleMuzzlePosition()
				self._T.playerShotImpactTime = self.battleVisualElapsed+math.max(0, self.shotFlightSeconds-self.shotElapsed)
				self._T.playerShotHit = shot.hit ~= false
				self._T.playerShotDamage = shot.damage
				self._T.playerShotCritical = shot.critical == true
				self._T.playerShotEndPosition = self:GetBattleTargetCenter(shot.targetUid, shot.animationRuid, self._T.playerShotImpactTime)
				if not self._T.playerShotHit then
					self._T.playerShotEndPosition = self:GetBattleMissEndPosition(self._T.playerShotStartPosition,self._T.playerShotEndPosition,shot.animationRuid,shot.sequence)
				end
				self._T.playerShotRotation = self:GetProjectileRotation(self._T.playerShotStartPosition, self._T.playerShotEndPosition, self.cannonSpriteFacingOffset)
				self._T.battleFinishElapsed = nil
				log("[VRF] cannon launch seq=" .. tostring(shot.sequence) .. " targetUid=" .. tostring(shot.targetUid) .. " muzzle=" .. tostring(self._T.playerShotStartPosition) .. " endpoint=" .. tostring(self._T.playerShotEndPosition) .. " rotation=" .. tostring(self._T.playerShotRotation))
			end
		end
		self:UpdateBattleHitPoses(delta, controller._T.airWave)
		self:UpdateBattleWaveViews(battle, map)
		local wave = controller._T.airWave
		local enemyShot = wave and wave.id == battle.id and wave.enemies.enemyShot or nil
		if enemyShot ~= nil and enemyShot.sequence == (battle.enemyShotSequence or 0) and enemyShot.sequence > self.lastEnemyShotSequence then
			self.lastEnemyShotSequence = enemyShot.sequence
			local age = math.max(0, _UtilLogic.ElapsedSeconds-(wave.receivedAt or _UtilLogic.ElapsedSeconds))
			self.enemyShotElapsed = math.max(0, (enemyShot.elapsed or 0)+age)
			self._T.enemyShotStartPosition = self:GetBattleTargetCenter(enemyShot.sourceUid, enemyShot.animationRuid, self.battleVisualElapsed)
			self._T.enemyShotEndPosition = self:GetBattleShipPosition()
			self._T.enemyShotRotation = self:GetProjectileRotation(self._T.enemyShotStartPosition, self._T.enemyShotEndPosition, self.enemyShotSpriteFacingOffset)
			self._T.enemyShotFlightSeconds = math.max(0.01, enemyShot.flightSeconds or 0.6)
		end
		if self.lastPlayerShotSequence > 0 and self._T.playerShotEndPosition ~= nil then
			local start = self._T.playerShotStartPosition
			local target = self._T.playerShotEndPosition
			local progress = math.min(1, self.shotElapsed/self.shotFlightSeconds)
			local position = Vector3(start.x+(target.x-start.x)*progress, start.y+(target.y-start.y)*progress, 0)
			self.localBattleShot.TransformComponent.Position = self:BattleWorldToLocal(position)
			self.localBattleShot.TransformComponent.Rotation = Vector3(0,0,self._T.playerShotRotation)
			self.localBattleShot.SpriteRendererComponent.Enable = progress < 1
			if progress >= 0.45 and progress < 1 and self._T.midShotSequence ~= self.lastPlayerShotSequence then
				self._T.midShotSequence = self.lastPlayerShotSequence
				log("[VRF] cannon straight mid seq=" .. tostring(self.lastPlayerShotSequence) .. " progress=" .. tostring(progress) .. " position=" .. tostring(position))
			end
			if progress >= 1 then self:CompletePlayerShotVisual(target) end
		end
		if self._T.enemyShotStartPosition ~= nil then
			local start,target = self._T.enemyShotStartPosition,self._T.enemyShotEndPosition
			local progress = math.min(1,self.enemyShotElapsed/(self._T.enemyShotFlightSeconds or 0.6))
			self.localEnemyShot.TransformComponent.Position = self:BattleWorldToLocal(Vector3(start.x+(target.x-start.x)*progress,start.y+(target.y-start.y)*progress,0))
			self.localEnemyShot.TransformComponent.Rotation = Vector3(0,0,self._T.enemyShotRotation)
			local wasVisible = self.localEnemyShot.SpriteRendererComponent.Enable
			self.localEnemyShot.SpriteRendererComponent.Enable = progress < 1
			if wasVisible and progress >= 1 then self:ShowBattleImpact(target) end
		end
		-- 勝利快照先到仍完成最後一發；保留短暫爆炸時間，避免下一幀就刪掉特效。
		if battle.phase == "won" and (battle.playerShotSequence or 0) <= (self._T.lastImpactSequence or 0) then
			self._T.battleFinishElapsed = (self._T.battleFinishElapsed or 0)+delta
			if self._T.battleFinishElapsed >= 0.75 then
				self._T.completedBattleId = battle.id
				self:ReleaseBattleVisuals()
			end
		end
	end
	@ExecSpace("ClientOnly")
	method void ReleaseBattleVisuals()
		-- 離開戰鬥時清理仍在播的單次命中特效。
		if self._T.impactSerials ~= nil then
			for _, serial in ipairs(self._T.impactSerials) do _EffectService:RemoveEffect(serial) end
			self._T.impactSerials = nil
		end
		for _, view in pairs(self._T.waveViews or {}) do if isvalid(view) then view:Destroy() end end
		self._T.waveViews = {}
		self._T.hitPoses = {}
		self._T.appliedEnemyRuid = ""
		self._T.roamBounds = nil
		self._T.playerShotEndPosition = nil
		self._T.playerShotHit = nil
		self._T.playerShotDamage = nil
		self._T.playerShotCritical = nil
		self._T.playerShotImpactTime = nil
		self._T.playerShotRotation = nil
		self._T.enemyShotStartPosition = nil
		self._T.enemyShotEndPosition = nil
		self._T.enemyShotRotation = nil
		self._T.battleFinishElapsed = nil
		self._T.midShotSequence = nil
		if isvalid(self.localBattleShot) then self.localBattleShot:Destroy() end
		if isvalid(self.localEnemyShot) then self.localEnemyShot:Destroy() end
		if self.appliedBattleId ~= "" then log("[AirBattleVisual] destroyed id=" .. self.appliedBattleId) end
		self.localBattleEnemy = nil
		self.localBattleShot = nil
		self.localEnemyShot = nil
		self.appliedBattleId = ""
		self._T.lastImpactSequence = 0
		self._T.playerShotTargetUid = nil
		self._T.playerShotTargetRuid = nil
		self._T.playerShotTargetPackId = nil
		self._T.playerShotStartPosition = nil
		self.shotFlightSeconds = 0.6
		self.battleVisualElapsed = 0
		self.shotElapsed = 1
		self.lastPlayerShotSequence = 0
		self.lastEnemyShotSequence = 0
		self.enemyHitFlashRemaining = 0
		self.lastEnemyHp = -1
		self.enemyShotElapsed = 1
	end
	@ExecSpace("ClientOnly")

	method void UpdateBattleWaveViews(table battle, Entity map)
		-- 每隻怪保留 UID 實體及獨立飛行位置；死亡只刪該隻，不把其他怪搬到主目標槽。
		local wave = _GreatVoyageAdventureController._T.airWave
		if wave == nil or wave.id ~= battle.id then return end
		self:PreloadBattleMonsterHitAnimations(wave)
		if self._T.waveViews == nil then self._T.waveViews = {} end
		local wanted = {}
		for _, enemy in ipairs(wave.enemies) do wanted[enemy.uid] = enemy end
		local shotUid = self._T.playerShotTargetUid
		if self._T.hitPoses == nil then self._T.hitPoses = {} end
		if shotUid ~= nil and self.lastPlayerShotSequence > (self._T.lastImpactSequence or 0) and wanted[shotUid] == nil then
			wanted[shotUid] = {uid=shotUid, animationRuid=self._T.playerShotTargetRuid}
		end
		for uid, pose in pairs(self._T.hitPoses) do
			if wanted[uid] == nil then wanted[uid] = {uid=uid, id=pose.packId, animationRuid=pose.originalRuid} end
		end
		for uid, enemy in pairs(wanted) do
			local pose = self._T.hitPoses[uid]
			local time = self.battleVisualElapsed
			if uid == shotUid and self._T.playerShotHit ~= false and self.lastPlayerShotSequence > (self._T.lastImpactSequence or 0) then
				time = math.min(time, self._T.playerShotImpactTime or time)
			end
			local position = self:GetBattleRoamPosition(uid, time)
			local view = self._T.waveViews[uid]
			if not isvalid(view) then
				view = _SpawnService:SpawnByModelId(self.overlayModelId, "GVLocalWaveEnemy" .. tostring(uid), position, map)
				if isvalid(view) then
					self._T.waveViews[uid] = view
					log("[VRF] roaming enemy created uid=" .. tostring(uid))
				end
			end
			self:LoadBattleEnemyCenter(enemy.animationRuid)
			if isvalid(view) and view.SpriteRendererComponent ~= nil and view.TransformComponent ~= nil then
				if pose ~= nil then
					if view.SpriteRendererComponent.SpriteRUID ~= pose.hitRuid then view.SpriteRendererComponent.SpriteRUID = pose.hitRuid end
					if pose.isDead == true and pose.position ~= nil then view.TransformComponent.Position = pose.position end
				elseif view.SpriteRendererComponent.SpriteRUID ~= enemy.animationRuid then
					view.SpriteRendererComponent.SpriteRUID = enemy.animationRuid
				end
				view.SpriteRendererComponent.SortingLayer = self:GetMapSortingLayer()
				view.SpriteRendererComponent.OrderInLayer = 20
				view.SpriteRendererComponent.FlipX = true
				view.SpriteRendererComponent.Enable = true
				view.TransformComponent.Scale = Vector3(1.5,1.5,1)
				if pose == nil or pose.isDead ~= true then view.TransformComponent.Position = self:BattleWorldToLocal(position) end
			end
		end
		for uid, view in pairs(self._T.waveViews) do
			if wanted[uid] == nil then
				if isvalid(view) then view:Destroy() end
				self._T.waveViews[uid] = nil
			end
		end
		local primary = wave.enemies[1]
		self.localBattleEnemy = primary and self._T.waveViews[primary.uid] or nil
	end	@ExecSpace("ClientOnly")

	method table GetBattlePlayerShot(table battle)
		-- 混編雙快照不同幀到達時等待正確序列；不能用最新主目標猜舊炮彈的目標。
		local controller = _GreatVoyageAdventureController
		local wave = controller and controller._T.airWave or nil
		if wave ~= nil and wave.id == battle.id then
			local shot = wave.enemies and wave.enemies.playerShot or nil
			if shot == nil or shot.sequence ~= (battle.playerShotSequence or 0) then return nil end
			return shot
		end
		return nil
	end
	@ExecSpace("ClientOnly")

	method void CompletePlayerShotVisual(Vector3 targetPosition)
		-- 固定終點只命中一次，保留數值證據；伺服器仍是唯一扣血與發賞來源。
		local sequence = self.lastPlayerShotSequence
		if sequence <= (self._T.lastImpactSequence or 0) then return end
		local uid = self._T.playerShotTargetUid
		local view = uid and self._T.waveViews and self._T.waveViews[uid] or nil
		if self._T.playerShotHit ~= false and isvalid(view) then
			local position = self:GetBattleRoamPosition(uid, self._T.playerShotImpactTime or self.battleVisualElapsed)
			view.TransformComponent.Position = self:BattleWorldToLocal(position)
			self:StartBattleHitPose(uid, self._T.playerShotTargetPackId or "", self._T.playerShotTargetRuid or "")
		end
		self._T.lastImpactSequence = sequence
		if isvalid(self.localBattleShot) then
			self.localBattleShot.TransformComponent.Position = self:BattleWorldToLocal(targetPosition)
			self.localBattleShot.SpriteRendererComponent.Enable = false
		end
		if self._T.playerShotHit ~= false then self:ShowBattleImpact(targetPosition) end
		local center = self:GetBattleTargetCenter(uid or 1, self._T.playerShotTargetRuid or "", self._T.playerShotImpactTime or self.battleVisualElapsed)
		local numberPosition = targetPosition
		if self._T.playerShotHit == false then
			numberPosition = self:GetBattleMissTextPosition(uid or 1, self._T.playerShotTargetRuid or "", self._T.playerShotImpactTime or self.battleVisualElapsed)
		end
		self:ShowBattleDamageNumber(numberPosition)
		local dx,dy = targetPosition.x-center.x, targetPosition.y-center.y
		local result = "impact"
		if self._T.playerShotHit == false then result = "miss" end
		log("[VRF] cannon " .. result .. " seq=" .. tostring(sequence) .. " targetUid=" .. tostring(uid) .. " endpoint=" .. tostring(targetPosition) .. " bodyCenter=" .. tostring(center) .. " error=" .. tostring(math.sqrt(dx*dx+dy*dy)))
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleRoamPosition(integer uid, number elapsed)
		-- 固定 UID 各走不同平滑路線；世界邊界在交戰開始鎖定，不因主目標或鏡頭改變而瞬移。
		if self._T.roamBounds == nil then
			local low = _UILogic:ScreenToWorldPosition(Vector2(0, 0))
			local high = _UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
			self._T.roamBounds = {x=low.x, y=low.y, width=high.x-low.x, height=high.y-low.y}
		end
		local bounds = self._T.roamBounds
		local phase = uid or 1
		local x = 0.24 + math.sin(elapsed * (0.48 + (phase % 5) * 0.06) + phase * 2.399) * 0.10
			+ math.sin(elapsed * 1.13 + phase * 0.71) * 0.035
		local y = 0.50 + math.sin(elapsed * (0.37 + (phase % 7) * 0.04) + phase * 1.618) * 0.17
			+ math.sin(elapsed * 0.91 + phase * 0.37) * 0.055
		return Vector3(bounds.x + bounds.width * x, bounds.y + bounds.height * y, 0)
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleTargetCenter(integer uid, string animationRuid, number elapsed)
		-- 所有怪物以相同比例渲染，預判落點與實際 UID 身體中心共用同一條路線。
		return self:GetBattleEnemyCenter(self:GetBattleRoamPosition(uid, elapsed), animationRuid)
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleMissTextPosition(integer uid, string animationRuid, number elapsed)
		-- MISS 原生文字錨在指定 UID 頭頂；有效 view 取實際位置，否則重用該 RUID 的最高 top cache。
		local position = nil
		local view = uid and self._T.waveViews and self._T.waveViews[uid] or nil
		if isvalid(view) and view.TransformComponent ~= nil then
			position = view.TransformComponent.WorldPosition
		else
			position = self:GetBattleRoamPosition(uid or 1, elapsed)
		end
		local bodyCenter = self:GetBattleEnemyCenter(position, animationRuid)
		local topOffset = 0
		if self._T.enemyTopOffsetCache ~= nil then topOffset = self._T.enemyTopOffsetCache[animationRuid] or 0 end
		return Vector3(bodyCenter.x, position.y+topOffset+0.15, position.z)
	end

	@ExecSpace("ClientOnly")
	method Vector3 GetBattleMissEndPosition(Vector3 start, Vector3 center, string animationRuid, integer sequence)
		-- 落空時在出膛前偏離素材外緣；整段仍固定直線，不貼怪物播爆炸。
		local dx,dy = center.x-start.x,center.y-start.y
		local distance = math.sqrt(dx*dx+dy*dy)
		local nx,ny = 0,1
		if distance > 0.000001 then nx,ny = -dy/distance,dx/distance end
		local radius = self._T.enemyMissRadius and self._T.enemyMissRadius[animationRuid] or 1.5
		local side = 1
		if sequence % 2 == 0 then side = -1 end
		return Vector3(center.x+nx*radius*side,center.y+ny*radius*side,0)
	end

	@ExecSpace("ClientOnly")
	method void UpdateBattleDamageNumbers()
		-- 傷害字固定在命中地點，怪物死亡或換目標不會帶走數字；離圖與逾時回收。
		local map = self.Entity.CurrentMap
		local player = _UserService.LocalPlayer
		local active = isvalid(player) and player.CurrentMap == map
		for index = #(self._T.damageNumbers or {}),1,-1 do
			local entry = self._T.damageNumbers[index]
			if not active or not isvalid(entry.entity) or _UtilLogic.ElapsedSeconds >= entry.expiresAt then
				if isvalid(entry.entity) then entry.entity:Destroy() end
				table.remove(self._T.damageNumbers,index)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowBattleDamageNumber(Vector3 position)
		-- 數字與爆擊只讀伺服器該發炮擊結果；MISS 用原生文字皮膚，不假扣血。
		local hit = self._T.playerShotHit ~= false
		local damage = self._T.playerShotDamage or 0
		if hit and damage <= 0 then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.damageNumberSequence = (self._T.damageNumberSequence or 0)+1
		local anchor = _SpawnService:SpawnByModelId(self.overlayModelId,"GVLocalDamage" .. tostring(self._T.damageNumberSequence),self:BattleWorldToLocal(position),map)
		if not isvalid(anchor) then return end
		if anchor.SpriteRendererComponent ~= nil then anchor.SpriteRendererComponent.Enable = false end
		if anchor.DamageSkinComponent == nil then anchor:AddComponent("DamageSkinComponent") end
		if self._T.damageNumbers == nil then self._T.damageNumbers = {} end
		-- 同屏限制8隻，傷害字另留最多16個錨點，結束後仍能播完1.2秒。
		if #self._T.damageNumbers >= 16 then
			local oldest = table.remove(self._T.damageNumbers,1)
			if isvalid(oldest.entity) then oldest.entity:Destroy() end
		end
		table.insert(self._T.damageNumbers,{entity=anchor,expiresAt=_UtilLogic.ElapsedSeconds+1.2})
		if hit then
			_DamageSkinService:Play(anchor,"3271c3e79bf04ecba9a107d55495970d",0,{damage},DamageSkinTweenType.Default,self._T.playerShotCritical == true,Vector2(0,0.4),Vector2(1,1),1,1,LitMode.Default)
		else
			_DamageSkinService:PlayTextDamage(anchor,"3271c3e79bf04ecba9a107d55495970d",DamageSkinTextType.Miss,DamageSkinTweenType.Default,Vector2(0,0),Vector2(1,1),1,1,LitMode.Default)
		end
		log("[VRF] damage number seq=" .. tostring(self.lastPlayerShotSequence) .. " damage=" .. tostring(damage) .. " critical=" .. tostring(self._T.playerShotCritical == true) .. " hit=" .. tostring(hit))
	end

end
