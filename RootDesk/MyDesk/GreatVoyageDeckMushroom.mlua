@Component
script GreatVoyageDeckMushroom extends Component

	property integer hp = 15
	property number attackElapsed = 0
	property boolean dead = false
	property string ownerPlayerId = ""
	property string encounterId = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		log("[DeckMushroom] spawned")
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		if self.dead or self.ownerPlayerId == "" or event.AttackerEntity == nil then return end
		local attacker = event.AttackerEntity.PlayerComponent
		if attacker == nil or attacker.UserId ~= self.ownerPlayerId then return end
		local damage = event.TotalDamage
		if damage <= 0 then return end
		self.hp = self.hp - damage
		if self.hp <= 0 then
			self.dead = true
			if _GreatVoyageVoyageState ~= nil then _GreatVoyageVoyageState:MarkRaidEnemyRemoved(self.ownerPlayerId, self.encounterId) end
			log("[DeckMushroom] defeated")
			self.Entity:Destroy(0.3)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.dead then
			return
		end
		self.attackElapsed = self.attackElapsed + delta
		if self.attackElapsed >= 3 then
			self.attackElapsed = 0
			if _GreatVoyageVoyageState ~= nil then _GreatVoyageVoyageState:ApplyRaidDamage(self.ownerPlayerId, self.encounterId) end
		end
	end
end
