	method string GetCardSlotRuid()
		-- 三個通用槽與卡面共用直式比例。
		return "4e145218d5e3404586496c969504f3df"
	end

	method integer GetRepairQuote(any ship)
		if ship == nil then return 0 end
		local missing = math.max(0, (ship.maxHull or 0) - (ship.hull or 0))
		missing = missing + math.max(0, (ship.maxShield or 0) - (ship.shield or 0))
		missing = missing + math.max(0, (ship.maxArmor or 0) - (ship.armor or 0))
		if ship.id == "small_sampan" then return 0 end
		local multiplier = 1
		if ship.stats ~= nil and ship.stats.repairCostMultiplier ~= nil then multiplier = ship.stats.repairCostMultiplier end
		return math.ceil(missing * 0.5 * math.max(0, multiplier) * self:GetEconomyScale())
	end

	method any GetShipUpgradeCardById(string cardId)
		-- 僅接受目前 catalog 內的卡片 ID。
		for _, card in ipairs(self:GetShipUpgradeCards()) do
			if card.id == cardId then return card end
		end
		return nil
	end

	method string GetPortName(string portId)
		local port = self:GetPort(portId)
		if port == nil then return "未知港口" end
		return port.displayName
	end

	method any GetRoute(string originId, string destinationId)
		local normalizedOrigin = self:NormalizePortId(originId)
		local normalizedDestination = self:NormalizePortId(destinationId)
		if self:GetPort(normalizedOrigin) == nil or self:GetPort(normalizedDestination) == nil then return nil end
		if normalizedOrigin == normalizedDestination then return nil end
		local routeId = normalizedOrigin .. "_to_" .. normalizedDestination
		return {
			id = routeId,
			routeId = routeId,
			originId = normalizedOrigin,
			destinationId = normalizedDestination,
			returnRouteId = normalizedDestination .. "_to_" .. normalizedOrigin,
			boardingRequired = true,
			boardingCondition = "near_ship_and_interaction",
			relayMapName = "map_airship_deck"
		}
	end

	method string GetGoodName(integer index)
		local good = self:GetLocalGood("forest", index)
		if good ~= nil then return good.displayName end
		return "未知商品"
	end

	method any GetLocalGood(string portId, integer index)
		local port = self:GetPort(portId)
		if port == nil or index < 1 or index > #port.goods then return nil end
		return port.goods[index]
	end

	method any GetGoodById(string goodId)
		-- 交易使用唯一來源 ID，未核實商品不可買賣。
		if _GreatVoyageCommodityCatalog == nil then return nil end
		local good = _GreatVoyageCommodityCatalog:GetById(goodId)
		if good ~= nil and good.verified then return good end
		return nil
	end

	method integer GetGoodPrice(string portId, integer index)
		local good = self:GetLocalGood(portId, index)
		if good == nil then return 0 end
		return good.price
	end

	method integer GetSalePrice(string portId, string goodId)
		-- 本港折價回收；外港依草案需求計價，行情基準固定為 1。
		local destination = self:GetPort(portId)
		local good = self:GetGoodById(goodId)
		if destination == nil or good == nil then return 0 end
		if destination.id == good.originId then return math.floor(good.price * 0.8) end
		local demand = (good.demands or {})[destination.id] or 1
		return math.floor(good.price * demand + 0.5)
	end

