@Logic
script GreatVoyageVoyageData extends Logic

	-- M1 資料契約：座標一律為官方 640:472 地圖的 0..1 比例座標。
	property number mapPixelWidth = 640
	property number mapPixelHeight = 472
	property number geometryEpsilon = 0.000001

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		log("[VoyageData] ready map=640:472 normalized=0..1")
	end

	method string NormalizePortId(string portId)
		-- `sky` 是天空之城港的 canonical portId；`victoria` 僅保留為舊存檔相容 alias。
		if portId == "victoria" then return "sky" end
		return portId
	end

	method any GetPort(string portId)
		-- 四個已開放港口沿用既有座標，貨架改由原作商品圖鑑提供。
		local id = self:NormalizePortId(portId)
		local ports = {
			forest = { id = "forest", displayName = "魔法森林", position = { x = 0.13, y = 0.66 }, mapName = "map_forest_port" },
			sky = { id = "sky", displayName = "天空之城", position = { x = 0.49, y = 0.67 }, mapName = "map_orbis_port" },
			ludus = { id = "ludus", displayName = "玩具城", position = { x = 0.42, y = 0.40 }, mapName = "map_ludus_port" },
			nihal = { id = "nihal", displayName = "納希沙漠", position = { x = 0.60, y = 0.16 }, mapName = "map_nihal_port" }
		}
		local port = ports[id]
		if port == nil then return nil end
		port.goods = {}
		if _GreatVoyageCommodityCatalog ~= nil then port.goods = _GreatVoyageCommodityCatalog:GetForPort(id) end
		return port
	end

	method any GetShipCatalog()
		-- 唯一的船型定義來源；Client 可用來顯示商店，Server 也用來驗證價格與能力。
		local baseHull = 120
		local baseShield = 24
		local baseArmor = 48
		local baseCargo = 8
		return {
			{ id = "small_sampan", name = "小風帆", tier = 0, price = 0, spriteRuid = "6db8a51bb2024f14b3f22fe5a890a979", description = "新手船；可在四港免費維修。", maxHull = 100, maxShield = 20, maxArmor = 40, cargoCapacity = baseCargo, hullMultiplier = 1, cannonMultiplier = 1, durationMultiplier = 1 },
			{ id = "forest", name = "森芽號", tier = 1, price = 50000, spriteRuid = "9d3adbd593454f9dbd0fffa1f5eda00e", description = "T1 基礎船體上限 +20%。", maxHull = math.floor(baseHull * 1.2), maxShield = baseShield, maxArmor = baseArmor, cargoCapacity = baseCargo, hullMultiplier = 1.2, cannonMultiplier = 1, durationMultiplier = 1 },
			{ id = "red", name = "赤帆號", tier = 1, price = 50000, spriteRuid = "55c74934367840d39687eb4b66ae2310", description = "炮擊傷害 +10%。", maxHull = baseHull, maxShield = baseShield, maxArmor = baseArmor, cargoCapacity = baseCargo, hullMultiplier = 1, cannonMultiplier = 1.1, durationMultiplier = 1 },
			{ id = "gear", name = "齒輪號", tier = 1, price = 50000, spriteRuid = "2e64df1c16764058b235658a8f379b71", description = "航程時間縮短 10%。", maxHull = baseHull, maxShield = baseShield, maxArmor = baseArmor, cargoCapacity = baseCargo, hullMultiplier = 1, cannonMultiplier = 1, durationMultiplier = 0.9 },
			{ id = "merchant", name = "行商號", tier = 1, price = 50000, spriteRuid = "5884e53005c44038b0ddd3587591b55d", description = "貨艙容量 +25%，航程時間 +10%。", maxHull = baseHull, maxShield = baseShield, maxArmor = baseArmor, cargoCapacity = math.floor(baseCargo * 1.25), hullMultiplier = 1, cannonMultiplier = 1, durationMultiplier = 1.1 }
		}
	end

	method any GetShipById(string shipId)
		-- 只從 catalog 回傳合法船型，避免客戶端自帶價格或能力值。
		for _, ship in ipairs(self:GetShipCatalog()) do
			if ship.id == shipId then return ship end
		end
		return nil
	end

