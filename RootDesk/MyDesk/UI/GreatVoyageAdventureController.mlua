	@ExecSpace("ClientOnly")
	method void OnCardMarketShipMerchantClick(ButtonClickEvent event)
		-- 從改裝頁切換至既有船舶買賣目錄。
		if self.modalType ~= "card_market" or self.cardMarketMode ~= "install" or _GreatVoyageVoyageState == nil then return end
		if isvalid(self.cardMarketPanel) then self.cardMarketPanel.Enable = false end
		if isvalid(self.shipModal) then self.shipModal.Enable = true end
		if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = true end
		self.shipShopReturnToFitting = true
		self.modalType = "ship_shop"
		self.pendingShipShopRevision = -1
		self.selectedShipCatalogIndex = 1
		_GreatVoyageVoyageState:RequestShipSnapshot()
		self:RefreshShipShop()
	end

	@ExecSpace("ClientOnly")
	method void SelectCardMarketCard(integer tileIndex)
		local list = self:GetCardMarketList()
		local index = (self.cardMarketPage - 1) * 6 + tileIndex
		local card = list[index]
		if card == nil then return end
		self.cardMarketSelectedIndex = index
		self.cardMarketSelectedCardId = card.id
		self.cardMarketFeedback = ""
		self:RefreshCardMarket()
	end

	@ExecSpace("ClientOnly")
	method any GetCardMarketList()
		-- 購買列顯示圖鑑；出售與配裝只列未安裝庫存。
		local cards = _GreatVoyageVoyageData:GetShipUpgradeCards()
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local inventory = snapshot.cardInventory or {}
		local list = {}
		for _, card in ipairs(cards) do
			if self.cardMarketMode == "buy" or (inventory[card.id] or 0) > 0 then
				table.insert(list, card)
			end
		end
		return list
	end

	@ExecSpace("ClientOnly")
	method void RefreshCardMarket()
		-- 依商店或配裝模式同步卡片庫存、槽位與狀態。
		if _GreatVoyageVoyageData == nil or _GreatVoyageVoyageState == nil or not isvalid(self.cardMarketPanel) then return end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local list = self:GetCardMarketList()
		local inventory = snapshot.cardInventory or {}
		local responseRevision = 0
		local responseMessage = ""
		if snapshot.ship ~= nil then
			responseRevision = snapshot.ship.revision or 0
			responseMessage = snapshot.ship.message or ""
		end
		if snapshot.ship ~= nil and self.pendingShipShopRevision >= 0 and responseRevision > self.pendingShipShopRevision then
			self.pendingShipShopRevision = -1
		end
		if self.cardMarketRequestPending and self.cardMarketPendingRevision >= 0 and responseRevision > self.cardMarketPendingRevision then
			self.cardMarketRequestPending = false
			self.cardMarketFeedback = responseMessage
		end
		local pageCount = math.max(1, math.ceil(#list / 6))
		self.cardMarketPage = math.min(math.max(1, self.cardMarketPage), pageCount)
		local isFitting = self.cardMarketMode == "install"
		local detailTransform = nil
		local messageTransform = nil
		local actionTransform = nil
		local backTransform = nil
		local prevTransform = nil
		local nextTransform = nil
		local pageTransform = nil
		local minusTransform = nil
		local plusTransform = nil
		local quantityTransform = nil
		if isvalid(self.cardMarketDetailText) then detailTransform = self.cardMarketDetailText.Entity.UITransformComponent end
		if isvalid(self.cardMarketMessageText) then messageTransform = self.cardMarketMessageText.Entity.UITransformComponent end
		if isvalid(self.cardMarketActionButton) then actionTransform = self.cardMarketActionButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketBackButton) then backTransform = self.cardMarketBackButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketPagePrevButton) then prevTransform = self.cardMarketPagePrevButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketPageNextButton) then nextTransform = self.cardMarketPageNextButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketPageText) then pageTransform = self.cardMarketPageText.Entity.UITransformComponent end
		if isvalid(self.cardMarketMinusButton) then minusTransform = self.cardMarketMinusButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketPlusButton) then plusTransform = self.cardMarketPlusButton.Entity.UITransformComponent end
		if isvalid(self.cardMarketQuantityText) then quantityTransform = self.cardMarketQuantityText.Entity.UITransformComponent end
		if isvalid(detailTransform) then
			detailTransform.anchoredPosition = Vector2(0, -325)
			detailTransform.RectSize = Vector2(1240, 60)
			if isFitting then detailTransform.anchoredPosition = Vector2(397, -347); detailTransform.RectSize = Vector2(390, 86) end
		end
		if isvalid(messageTransform) then
			messageTransform.anchoredPosition = Vector2(0, -360)
			messageTransform.RectSize = Vector2(1240, 28)
			if isFitting then messageTransform.anchoredPosition = Vector2(-225, -378); messageTransform.RectSize = Vector2(670, 36) end
		end
		if isvalid(actionTransform) then actionTransform.anchoredPosition = Vector2(70, -390); actionTransform.RectSize = Vector2(220, 64) end
		if isvalid(backTransform) then backTransform.anchoredPosition = Vector2(-575, -390); backTransform.RectSize = Vector2(150, 64) end
		if isvalid(prevTransform) then prevTransform.anchoredPosition = Vector2(390, -390); prevTransform.RectSize = Vector2(64, 64) end
		if isvalid(pageTransform) then pageTransform.anchoredPosition = Vector2(480, -390); pageTransform.RectSize = Vector2(110, 64) end
		if isvalid(nextTransform) then nextTransform.anchoredPosition = Vector2(570, -390); nextTransform.RectSize = Vector2(64, 64) end
		if isvalid(minusTransform) then minusTransform.anchoredPosition = Vector2(-340, -420); minusTransform.RectSize = Vector2(72, 64) end
		if isvalid(quantityTransform) then quantityTransform.anchoredPosition = Vector2(-240, -420); quantityTransform.RectSize = Vector2(120, 52) end
		if isvalid(plusTransform) then plusTransform.anchoredPosition = Vector2(-130, -420); plusTransform.RectSize = Vector2(72, 64) end
		if isFitting then
			if isvalid(actionTransform) then actionTransform.anchoredPosition = Vector2(397, -435); actionTransform.RectSize = Vector2(370, 66) end
			if isvalid(backTransform) then backTransform.anchoredPosition = Vector2(-435, -429); backTransform.RectSize = Vector2(190, 66) end
			if isvalid(prevTransform) then prevTransform.anchoredPosition = Vector2(310, 290); prevTransform.RectSize = Vector2(42, 28) end
			if isvalid(pageTransform) then pageTransform.anchoredPosition = Vector2(397, 290); pageTransform.RectSize = Vector2(100, 28) end
			if isvalid(nextTransform) then nextTransform.anchoredPosition = Vector2(484, 290); nextTransform.RectSize = Vector2(42, 28) end
		end
		-- Runtime geometry uses center anchors; keep serialized offsets consistent with the same rect.
		for _, transform in ipairs({ detailTransform, messageTransform, actionTransform, backTransform, prevTransform, nextTransform, pageTransform, minusTransform, plusTransform, quantityTransform }) do
			if isvalid(transform) then
				transform.AnchorsMin = Vector2(0.5, 0.5); transform.AnchorsMax = Vector2(0.5, 0.5); transform.Pivot = Vector2(0.5, 0.5)
				local p = transform.anchoredPosition; local s = transform.RectSize
				transform.OffsetMin = Vector2(p.x - s.x * 0.5, p.y - s.y * 0.5)
				transform.OffsetMax = Vector2(p.x + s.x * 0.5, p.y + s.y * 0.5)
			end
		end
		self:FitCardMarketButtonVisual("/ui/GreatVoyageAdventure/CardMarket/Window/Prev", prevTransform, isFitting)
		self:FitCardMarketButtonVisual("/ui/GreatVoyageAdventure/CardMarket/Window/Next", nextTransform, isFitting)
		self:FitCardMarketButtonVisual("/ui/GreatVoyageAdventure/CardMarket/Window/Minus", minusTransform, isFitting)
		self:FitCardMarketButtonVisual("/ui/GreatVoyageAdventure/CardMarket/Window/Plus", plusTransform, isFitting)
		if isvalid(self.cardMarketFitInventoryTitle) then
			self.cardMarketFitInventoryTitle.Text = "未安裝庫存"
			if isFitting and #list == 0 then self.cardMarketFitInventoryTitle.Text = "未安裝庫存（空）" end
			self.cardMarketFitInventoryTitle.Entity.Enable = isFitting
		end

		local fittingName = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/CardMarket/Window/FitShipName")
		local fittingInstruction = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/CardMarket/Window/FitInstruction")
		if isvalid(fittingName) then fittingName.Enable = isFitting end
		if isvalid(fittingInstruction) then fittingInstruction.Enable = false end
		if isvalid(self.cardMarketFitLeftPanelEntity) then self.cardMarketFitLeftPanelEntity.Enable = isFitting end
		if isvalid(self.cardMarketFitRightPanelEntity) then self.cardMarketFitRightPanelEntity.Enable = isFitting end
		if self.cardMarketTitleText ~= nil then
			self.cardMarketTitleText.Text = "雲海商會"
			if isFitting then self.cardMarketTitleText.Text = "船舶改裝" end
		end
		if self.cardMarketWalletText ~= nil then
			self.cardMarketWalletText.Text = "持有 " .. self:FormatMoney(snapshot.money or 0)
			self.cardMarketWalletText.Entity.Enable = not isFitting
			local walletBag = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/CardMarket/Window/Wallet/CoinBag")
			local walletCoin = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/CardMarket/Window/Wallet/CurrencyCoin")
			if isvalid(walletBag) then walletBag.Enable = not isFitting end
			if isvalid(walletCoin) then walletCoin.Enable = not isFitting end
		end
		if self.cardMarketPageText ~= nil then self.cardMarketPageText.Text = tostring(self.cardMarketPage) .. " / " .. tostring(pageCount) end
		if self.cardMarketQuantityText ~= nil then self.cardMarketQuantityText.Text = "數量 ×" .. tostring(self.cardMarketQuantity) end
		local showTradeTabs = not isFitting and not self.cardMarketRequestPending
		if self.cardMarketTabBuyButton ~= nil then self.cardMarketTabBuyButton.Entity.Enable = showTradeTabs end
		if self.cardMarketTabSellButton ~= nil then self.cardMarketTabSellButton.Entity.Enable = showTradeTabs end
		if isvalid(self.cardMarketBackButton) then
			local backText = self.cardMarketBackButton.Entity.TextGUIRendererComponent
			backText.Text = "商品"
			if isFitting then backText.Text = "返回" end
			backText.FontColor = Color(1, 0.91, 0.69, 1)
		end
		if isvalid(self.cardMarketMinusButton) then
			self.cardMarketMinusButton.Entity.Enable = showTradeTabs
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/CardMarket/Window/Minus", self.cardMarketMinusButton, showTradeTabs)
		end
		if isvalid(self.cardMarketPlusButton) then
			self.cardMarketPlusButton.Entity.Enable = showTradeTabs
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/CardMarket/Window/Plus", self.cardMarketPlusButton, showTradeTabs)
		end
		if isvalid(self.cardMarketQuantityText) then self.cardMarketQuantityText.Entity.Enable = showTradeTabs end
		if isvalid(self.cardMarketShipPreview) then self.cardMarketShipPreview.Entity.Enable = isFitting end
		if isvalid(self.cardMarketShipStats) then self.cardMarketShipStats.Entity.Enable = isFitting; self.cardMarketShipStats.FontColor = Color(0.29, 0.19, 0.13, 1) end
		if isvalid(self.cardMarketShipMerchantButton) then self.cardMarketShipMerchantButton.Entity.Enable = isFitting end
		if isvalid(self.cardMarketCardsTabButton) then self.cardMarketCardsTabButton.Entity.Enable = not isFitting end
		if isvalid(self.cardMarketPagePrevButton) then self.cardMarketPagePrevButton.Entity.Enable = pageCount > 1 end
		if isvalid(self.cardMarketPageNextButton) then self.cardMarketPageNextButton.Entity.Enable = pageCount > 1 end
		if isvalid(self.cardMarketPageText) then self.cardMarketPageText.Entity.Enable = pageCount > 1 end
		if isvalid(self.cardMarketActionButton) then self.cardMarketActionButton.Entity.Enable = true end
		if isvalid(self.cardMarketBackButton) then self.cardMarketBackButton.Entity.Enable = true end
		if isvalid(self.cardMarketMinusButton) then self.cardMarketMinusButton.Entity.Enable = showTradeTabs end
		if isvalid(self.cardMarketPlusButton) then self.cardMarketPlusButton.Entity.Enable = showTradeTabs end
		local activeShip = snapshot.ship
		local fittingShipDefinition = nil
		local ownedActiveShip = false
		if isFitting and activeShip ~= nil and _GreatVoyageVoyageData ~= nil then
			self.cardMarketShipId = activeShip.id
			fittingShipDefinition = _GreatVoyageVoyageData:GetShipById(activeShip.id)
			ownedActiveShip = snapshot.ownedShips ~= nil and snapshot.ownedShips[activeShip.id] ~= nil
			if fittingShipDefinition ~= nil and isvalid(self.cardMarketShipPreview) then
				self.cardMarketShipPreview.ImageRUID = DataRef(fittingShipDefinition.spriteRuid or "")
				self.cardMarketShipPreview.PreserveSprite = PreserveSpriteType.AspectOnly
				self.cardMarketShipPreview.Color = Color(1, 1, 1, 1)
				-- 新手船的高桅杆要留在船名下方；切回 T1 時還原大圖區。
				local previewTransform = self.cardMarketShipPreview.Entity.UITransformComponent
				if isvalid(previewTransform) then
					local previewY = 114
					local previewHeight = 350
					local previewWidth = 660
					if fittingShipDefinition.tier == 0 then previewY = 95; previewHeight = 280; previewWidth = 500 end
					previewTransform.anchoredPosition = Vector2(-225, previewY)
					previewTransform.RectSize = Vector2(previewWidth, previewHeight)
					previewTransform.OffsetMin = Vector2(-225 - previewWidth * 0.5, previewY - previewHeight * 0.5)
					previewTransform.OffsetMax = Vector2(-225 + previewWidth * 0.5, previewY + previewHeight * 0.5)
				end
			end
			local stats = activeShip.stats or {}
			local speed = stats.speedMultiplier or 1
			local speedPercent = math.floor((speed - 1) * 100 + 0.5)
			local speedText = "航速基準"
			if speedPercent > 0 then speedText = "航速 +" .. tostring(speedPercent) .. "%"
			elseif speedPercent < 0 then speedText = "航速 -" .. tostring(math.abs(speedPercent)) .. "%" end
			local cannonPercent = math.floor(((activeShip.cannonMultiplier or 1) - 1) * 100 + 0.5)
			local cannonText = "炮擊基準"
			if cannonPercent > 0 then cannonText = "炮擊 +" .. tostring(cannonPercent) .. "%" end
			if isvalid(self.cardMarketShipStats) then
				local tierText = "T0"
				if fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1 then tierText = "T1" end
				local isTierOne = fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1
				if isvalid(fittingName) then fittingName.TextGUIRendererComponent.Text = tostring(activeShip.name or "飛空船") .. " · " .. tierText end
				local statsText = "船體 " .. tostring(activeShip.maxHull or 0) .. "　護盾 " .. tostring(activeShip.maxShield or 0) .. "　裝甲 " .. tostring(activeShip.maxArmor or 0) .. "\n" .. speedText .. "　" .. cannonText .. "　貨艙 " .. tostring(activeShip.cargoCapacity or 0) .. " 格"
				if not isTierOne then statsText = statsText .. "　（T0 無改裝槽）" end
				self.cardMarketShipStats.Text = statsText
				self.cardMarketShipStats.FontSize = 26
			end
		end
		local fittingSlotButtons = { self.cardMarketFitSlot1Button, self.cardMarketFitSlot2Button, self.cardMarketFitSlot3Button }
		local fittingSlotLabels = { self.cardMarketFitSlot1Label, self.cardMarketFitSlot2Label, self.cardMarketFitSlot3Label }
		local installedSlots = { "", "", "" }
		if activeShip ~= nil and activeShip.slots ~= nil then
			installedSlots = { activeShip.slots.slot1 or activeShip.slots[1] or "", activeShip.slots.slot2 or activeShip.slots[2] or "", activeShip.slots.slot3 or activeShip.slots[3] or "" }
		end
		for slotIndex = 1, 3 do
			local button = fittingSlotButtons[slotIndex]
			local label = fittingSlotLabels[slotIndex]
			if isvalid(button) then
				local isTierOne = fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1 and ownedActiveShip
				button.Entity.Enable = isFitting and isTierOne
				button.Enable = isFitting and isTierOne and self:IsNearPortMerchant() and snapshot.status ~= "sailing" and self.pendingShipShopRevision < 0
				local cardId = installedSlots[slotIndex]
				local slotName = "空槽"
				local slotArt = _GreatVoyageVoyageData:GetCardSlotRuid()
				if slotArt == nil or slotArt == "" then slotArt = "4e145218d5e3404586496c969504f3df" end
				if cardId ~= "" then
					local installedCard = _GreatVoyageVoyageData:GetShipUpgradeCardById(cardId)
					if installedCard ~= nil then slotName = installedCard.name; if installedCard.artRuid ~= nil and installedCard.artRuid ~= "" then slotArt = installedCard.artRuid end end
				end
				button.Entity.SpriteGUIRendererComponent.ImageRUID = DataRef(slotArt)
				button.Entity.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
				button.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				if isvalid(label) then
					label.Entity.Enable = isFitting and isTierOne
					local marker = ""
					if slotIndex == self.selectedShipSlotIndex then marker = "◆ " end
					label.Text = marker .. tostring(slotIndex) .. " · " .. slotName
					label.FontColor = Color(1, 0.93, 0.75, 1)
				end
			end
		end
		local buttons = { self.cardMarketCard1Button, self.cardMarketCard2Button, self.cardMarketCard3Button, self.cardMarketCard4Button, self.cardMarketCard5Button, self.cardMarketCard6Button }
		local labels = { self.cardMarketCard1Label, self.cardMarketCard2Label, self.cardMarketCard3Label, self.cardMarketCard4Label, self.cardMarketCard5Label, self.cardMarketCard6Label }
		local selectedCard = nil
		for i = 1, 6 do
			local button = buttons[i]
			local label = labels[i]
			local card = list[(self.cardMarketPage - 1) * 6 + i]
			if isvalid(button) then
				local column = (i - 1) % 3
				local row = math.floor((i - 1) / 3)
				local cardWidth = 220
				local cardHeight = 260
				local cardX = -420 + column * 420
				local cardY = 130 - row * 295
				local labelWidth = 138
				local labelY = -81
				local labelHeight = 48
				if isFitting then
					column = (i - 1) % 2
					row = math.floor((i - 1) / 2)
					cardWidth = 174
					cardHeight = 180
					cardX = 292 + column * 210
					cardY = 185 - row * 195
					labelWidth = 145
					labelY = -54
					labelHeight = 58
				end
				local isRegenCaption = isFitting and card ~= nil and card.name == "修復奈米蜂群"
				if isRegenCaption then labelHeight = 58 end
				local cardTransform = button.Entity.UITransformComponent
				if isvalid(cardTransform) then
					cardTransform.AnchorsMin = Vector2(0.5, 0.5); cardTransform.AnchorsMax = Vector2(0.5, 0.5); cardTransform.Pivot = Vector2(0.5, 0.5)
					cardTransform.RectSize = Vector2(cardWidth, cardHeight); cardTransform.anchoredPosition = Vector2(cardX, cardY)
					cardTransform.OffsetMin = Vector2(cardX - cardWidth * 0.5, cardY - cardHeight * 0.5); cardTransform.OffsetMax = Vector2(cardX + cardWidth * 0.5, cardY + cardHeight * 0.5)
				end
				button.Enable = card ~= nil
				button.Entity.Enable = card ~= nil
				if isvalid(label) then
					label.Entity.Enable = card ~= nil
					local labelTransform = label.Entity.UITransformComponent
					if isvalid(labelTransform) then
						labelTransform.AnchorsMin = Vector2(0.5, 0.5); labelTransform.AnchorsMax = Vector2(0.5, 0.5); labelTransform.Pivot = Vector2(0.5, 0.5)
						labelTransform.RectSize = Vector2(labelWidth, labelHeight); labelTransform.anchoredPosition = Vector2(0, labelY)
						labelTransform.OffsetMin = Vector2(-labelWidth * 0.5, labelY - labelHeight * 0.5); labelTransform.OffsetMax = Vector2(labelWidth * 0.5, labelY + labelHeight * 0.5)
					end
					label.FontSize = 16
					label.MaxSize = 16
					label.MinSize = 16
					label.BestFit = false
					if isFitting then label.FontSize = 18; label.MaxSize = 18; label.MinSize = 18 end
					if isRegenCaption then label.FontSize = 18; label.MaxSize = 18; label.MinSize = 18 end
					label.FontColor = Color(0.29, 0.19, 0.13, 1)
					if isvalid(label.Entity.SpriteGUIRendererComponent) then label.Entity.SpriteGUIRendererComponent.Enable = false end
				end
				if card ~= nil then
					local count = inventory[card.id] or 0

					local stockLine = tostring(card.price or 0) .. "G·庫" .. tostring(count)
					if self.cardMarketMode == "sell" then stockLine = "出售 " .. tostring(card.sellPrice or 0) .. "G·庫" .. tostring(count) end
					if isFitting then stockLine = "×" .. tostring(count) end
					if card.available == false then stockLine = stockLine .. " ·未解鎖" end
					if isvalid(label) then
						if isRegenCaption then label.Text = card.name .. "\n×" .. tostring(count)
						elseif isFitting then label.Text = card.name .. "\n持有 " .. tostring(count)
						else label.Text = card.name .. "\n" .. stockLine end
					end
					button.Entity.SpriteGUIRendererComponent.Outline = card.id == self.cardMarketSelectedCardId
					button.Entity.SpriteGUIRendererComponent.OutlineColor = Color(0.98, 0.74, 0.28, 1)
					button.Entity.SpriteGUIRendererComponent.OutlineWidth = 3
					button.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
					local cardArtRuid = card.artRuid
					if cardArtRuid == nil or cardArtRuid == "" then cardArtRuid = "2860136c06ab075439721c027de365af" end
					button.Entity.SpriteGUIRendererComponent.ImageRUID = DataRef(cardArtRuid)
					button.Entity.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
					if card.id == self.cardMarketSelectedCardId then selectedCard = card end
				end
			end
		end
		if self.cardMarketSelectedIndex > #list or (selectedCard == nil and self.cardMarketSelectedCardId ~= "") then
			self.cardMarketSelectedCardId = ""
			self.cardMarketSelectedIndex = 0
			selectedCard = nil
		end
		if self.cardMarketDetailText ~= nil then
			self.cardMarketDetailText.FontSize = 22
			self.cardMarketDetailText.Padding = RectOffset(0, 0, 0, 0)
			if isFitting then
				self.cardMarketDetailText.FontSize = 22
				self.cardMarketDetailText.Padding = RectOffset(18, 18, 3, 3)
			end
			if selectedCard == nil then
				self.cardMarketDetailText.Text = "點選卡片看效果與售價，鎖定卡會提示解鎖條件！"
				if isFitting then
					self.cardMarketDetailText.Text = "挑選卡片安裝到槽位，換下的舊卡會回倉庫！"
					if fittingShipDefinition ~= nil and fittingShipDefinition.tier ~= 1 then
						self.cardMarketDetailText.Text = "小風帆沒有改裝槽，先留著等換 T1 船裝備吧！"
					end
				end
			else
				self.cardMarketDetailText.Text = selectedCard.name .. "｜" .. selectedCard.description
				if isFitting then self.cardMarketDetailText.Text = selectedCard.name .. "\n" .. selectedCard.description end
			end
			-- UTF-8 長效果文預留三行；原生文字尺寸會晚一幀更新，不能在此同步量字。
			if isFitting and selectedCard ~= nil and #(selectedCard.description or "") > 60 then
				self.cardMarketDetailText.FontSize = 18
			end
		end
		local marketHint = ""
		if #list == 0 then marketHint = "倉庫裡目前沒有未安裝的改裝卡喔！"
		elseif self.cardMarketMode == "install" then marketHint = "選取庫存卡片後安裝至船槽 " .. tostring(self.selectedShipSlotIndex) .. "；換下的卡會退回倉庫。"
		elseif self.cardMarketMode == "sell" then marketHint = "只能賣掉沒裝在船上的倉庫卡片喔！"
		else marketHint = "買進放入未裝庫存（上限 99 張，含已裝）；安裝請點 T1 船槽！" end
		if isFitting and fittingShipDefinition ~= nil and fittingShipDefinition.tier ~= 1 then marketHint = "現在開的船沒有改裝槽，切換成 T1 船才能裝配喔！" end
		local canAct = selectedCard ~= nil and self:IsNearPortMerchant() and snapshot.status ~= "sailing" and not self.cardMarketRequestPending and self.pendingShipShopRevision < 0
		local selectedSlotCardId = installedSlots[self.selectedShipSlotIndex] or ""
		if selectedCard ~= nil then
			if self.cardMarketMode == "buy" then
				local price = (selectedCard.price or 0) * self.cardMarketQuantity
				if selectedCard.available == false then
					marketHint = "鎖定卡片｜解鎖條件：" .. tostring(selectedCard.requirement or "尚未開放")
				elseif (snapshot.money or 0) < price then
					marketHint = "金幣不夠啦，買入需要 " .. tostring(price) .. " G。"
				end
				canAct = canAct and selectedCard.available ~= false and (snapshot.money or 0) >= price
			elseif self.cardMarketMode == "sell" then
				if (inventory[selectedCard.id] or 0) < self.cardMarketQuantity then marketHint = "數量不夠喔，目前只有 ×" .. tostring(inventory[selectedCard.id] or 0) .. "。" end
				canAct = canAct and (inventory[selectedCard.id] or 0) >= self.cardMarketQuantity
			else
				local isTierOne = fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1
				canAct = canAct and isTierOne and ownedActiveShip and (inventory[selectedCard.id] or 0) > 0 and activeShip ~= nil
				if not isTierOne then marketHint = "現在開的船沒有改裝槽，切換成 T1 船才能裝配喔！" end
				if selectedSlotCardId == selectedCard.id then
					marketHint = "這張卡已經裝在這個槽位囉！"
					canAct = false
				end
			end
		end
		if isFitting and selectedCard == nil and selectedSlotCardId ~= "" then
			local isTierOne = fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1
			canAct = isTierOne and ownedActiveShip and self:IsNearPortMerchant() and snapshot.status ~= "sailing" and not self.cardMarketRequestPending and self.pendingShipShopRevision < 0
			marketHint = "拆卸後卡片會放回未裝倉庫！"
		end
		if self.cardMarketRequestPending or self.cardMarketFeedback ~= "" then marketHint = self.cardMarketFeedback end
		if self.cardMarketMessageText ~= nil then
			if isFitting then self.cardMarketMessageText.FontSize = 20 end
			self.cardMarketMessageText.Text = marketHint
		end
		if self.cardMarketActionButton ~= nil then
			self.cardMarketActionButton.Enable = canAct
			local isTierOneOwned = fittingShipDefinition ~= nil and fittingShipDefinition.tier == 1 and ownedActiveShip
			self.cardMarketActionButton.Entity.Enable = not isFitting or (isTierOneOwned and (selectedCard ~= nil or selectedSlotCardId ~= ""))
			local action = "選擇卡片"
			if self.cardMarketMode == "buy" then action = "買入 ×" .. tostring(self.cardMarketQuantity)
			elseif self.cardMarketMode == "sell" then action = "出售 ×" .. tostring(self.cardMarketQuantity)
			elseif isFitting and selectedCard == nil and selectedSlotCardId ~= "" then action = "拆下槽位 " .. tostring(self.selectedShipSlotIndex)
			else action = "安裝到槽位 " .. tostring(self.selectedShipSlotIndex) end
			self.cardMarketActionButton.Entity.TextGUIRendererComponent.Text = action
		end
		if self.cardMarketPagePrevButton ~= nil then
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/CardMarket/Window/Prev", self.cardMarketPagePrevButton, self.cardMarketPage > 1)
		end
		if self.cardMarketPageNextButton ~= nil then
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/CardMarket/Window/Next", self.cardMarketPageNextButton, self.cardMarketPage < pageCount)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCardMarketActionClick(ButtonClickEvent event)
		if _GreatVoyageVoyageState == nil or self.cardMarketActionButton == nil or not self.cardMarketActionButton.Enable then return end
		if self.cardMarketMode ~= "install" and self.cardMarketSelectedCardId == "" then return end
		if self.cardMarketMode == "buy" then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			self.cardMarketPendingRevision = 0
			if snapshot.ship ~= nil then self.cardMarketPendingRevision = snapshot.ship.revision or 0 end
			_GreatVoyageVoyageState:BuyUpgradeCard(self.cardMarketSelectedCardId, self.cardMarketQuantity)
			self.cardMarketFeedback = "已送出買進請求，等待確認中…"
		elseif self.cardMarketMode == "sell" then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			self.cardMarketPendingRevision = 0
			if snapshot.ship ~= nil then self.cardMarketPendingRevision = snapshot.ship.revision or 0 end
			_GreatVoyageVoyageState:SellUpgradeCard(self.cardMarketSelectedCardId, self.cardMarketQuantity)
			self.cardMarketFeedback = "已送出賣出請求，等待確認中…"
		else
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			if snapshot.ship == nil then return end
			self.cardMarketPendingRevision = 0
			if snapshot.ship ~= nil then self.cardMarketPendingRevision = snapshot.ship.revision or 0 end
			self:ConfigureSelectedShipSlotById(snapshot.ship.id, self.selectedShipSlotIndex, self.cardMarketSelectedCardId)
			if self.cardMarketSelectedCardId == "" then self.cardMarketFeedback = "已送出拆下請求，卡片會退回倉庫！"
			else self.cardMarketFeedback = "已送出安裝請求，換下卡片退回倉庫！" end
		end
		self.cardMarketRequestPending = true
		self.cardMarketPendingElapsed = 0
		self:RefreshCardMarket()
	end

	@ExecSpace("ClientOnly")
	method void ConfigureSelectedShipSlotById(string shipId, integer slotIndex, string cardId)
		if self.modalType ~= "card_market" or self.pendingShipShopRevision >= 0 or not self:IsNearPortMerchant() or _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil then return end
		local definition = _GreatVoyageVoyageData:GetShipById(shipId)
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		if snapshot.ship == nil or definition == nil or definition.tier ~= 1 or snapshot.ownedShips == nil or snapshot.ownedShips[shipId] == nil or slotIndex < 1 or slotIndex > 3 then return end
		self.pendingShipShopRevision = snapshot.ship.revision
		_GreatVoyageVoyageState:ConfigureShipSlot(shipId, slotIndex, cardId)
	end

	@ExecSpace("ClientOnly")
	method void RefreshShipShop()
		-- 從伺服器快照和目錄更新船卡、槽位與按鈕狀態。
		if _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil or not isvalid(self.shipShopDetailText) then return end
		if isvalid(self.shipCabinContentEntity) then self.shipCabinContentEntity.Enable = false end
		if isvalid(self.shipStatusText) then self.shipStatusText.Entity.Enable = false end
		if isvalid(self.shipShopGoldText) then self.shipShopGoldText.Entity.Enable = false end
		if isvalid(self.shipHeaderTitleText) then
			self.shipHeaderTitleText.Text = "船舶買賣"
			self.shipHeaderTitleText.Entity.Enable = true
		end
		if isvalid(self.shipShopTitleText) then self.shipShopTitleText.Entity.Enable = false end
		local catalog = _GreatVoyageVoyageData:GetShipCatalog()
		local upgradeCards = _GreatVoyageVoyageData:GetShipUpgradeCards()
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local activeShip = snapshot.ship
		if activeShip == nil or snapshot.ownedShips == nil then
			self.shipShopDetailText.Text = "飛船資料讀取中…"
			self.shipShopActionButton.Enable = false
			return
		end
		local shipActionUpdated = self.pendingShipShopRevision >= 0 and activeShip.revision > self.pendingShipShopRevision
		if shipActionUpdated then self.pendingShipShopRevision = -1 end
		local cardButtons = { self.shipShopCard1Button, self.shipShopCard2Button, self.shipShopCard3Button, self.shipShopCard4Button, self.shipShopCard5Button }
		local cardIcons = { self.shipShopCard1Icon, self.shipShopCard2Icon, self.shipShopCard3Icon, self.shipShopCard4Icon, self.shipShopCard5Icon }
		local cardTexts = { self.shipShopCard1Text, self.shipShopCard2Text, self.shipShopCard3Text, self.shipShopCard4Text, self.shipShopCard5Text }
		for i = 1, 5 do
			local button = cardButtons[i]
			local shipInfo = catalog[i]
			local icon = cardIcons[i]
			local label = cardTexts[i]
			local priceLabel = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/ShipModal/Window/ShipShop/Card" .. tostring(i) .. "/Price")
			local priceIcon = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/ShipModal/Window/ShipShop/Card" .. tostring(i) .. "/Price/CoinBag")
			if isvalid(button) then
				button.Entity.Enable = shipInfo ~= nil
				if isvalid(priceLabel) then priceLabel.Enable = shipInfo ~= nil end
				if isvalid(priceIcon) then priceIcon.Enable = shipInfo ~= nil and (shipInfo.price or 0) > 0 end
				local priceCoin = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/ShipModal/Window/ShipShop/Card" .. tostring(i) .. "/Price/CurrencyCoin")
				if isvalid(priceCoin) then priceCoin.Enable = shipInfo ~= nil and (shipInfo.price or 0) > 0 end
				if shipInfo ~= nil then
					local ownedShip = snapshot.ownedShips[shipInfo.id]
					local marker = "未擁有"
					if shipInfo.id == activeShip.id then marker = "目前使用"
					elseif ownedShip ~= nil then marker = "已擁有" end
					local selection = ""
					if i == self.selectedShipCatalogIndex then selection = "◆ " end
					if isvalid(label) then label.Text = selection .. shipInfo.name .. "\n" .. marker end
					if isvalid(priceLabel) then
						local price = shipInfo.price or 0
						priceLabel.TextGUIRendererComponent.Text = price > 0 and self:FormatMoney(price) or "免費"
					end
					button.Entity.SpriteGUIRendererComponent.Outline = i == self.selectedShipCatalogIndex
					button.Entity.SpriteGUIRendererComponent.OutlineColor = Color(1, 0.82, 0.2, 1)
					button.Entity.SpriteGUIRendererComponent.OutlineWidth = 3
					if isvalid(icon) and shipInfo.spriteRuid ~= nil then
						icon.ImageRUID = DataRef(shipInfo.spriteRuid)
						icon.PreserveSprite = PreserveSpriteType.AspectOnly
						icon.Color = Color(1, 1, 1, 1)
					end
				end
			end
		end
		local selected = catalog[self.selectedShipCatalogIndex]
		if selected == nil then
			self.shipShopDetailText.Text = "飛船型錄讀取中…"
			self.shipShopActionButton.Enable = false
			return
		end
		self.selectedShipId = selected.id
		if isvalid(self.shipShopPreviewImage) then
			self.shipShopPreviewImage.ImageRUID = DataRef(selected.spriteRuid or "")
			self.shipShopPreviewImage.PreserveSprite = PreserveSpriteType.AspectOnly
			self.shipShopPreviewImage.Color = Color(1, 1, 1, 1)
		end
		local owned = snapshot.ownedShips[selected.id]
		local status = "尚未擁有"
		if selected.id == activeShip.id then status = "目前使用中"
		elseif owned ~= nil then status = "已擁有，可切換" end
		local isTierOne = selected.tier == 1
		local ownedDetail = owned
		if ownedDetail == nil and selected.id == activeShip.id then ownedDetail = activeShip end
		local maxHull = selected.maxHull
		local maxShield = selected.maxShield
		local maxArmor = selected.maxArmor
		local cargoCapacity = selected.cargoCapacity
		local cannonMultiplier = selected.cannonMultiplier
		local durationMultiplier = selected.durationMultiplier
		if ownedDetail ~= nil then
			maxHull = ownedDetail.maxHull
			maxShield = ownedDetail.maxShield
			maxArmor = ownedDetail.maxArmor
			cargoCapacity = ownedDetail.cargoCapacity
			cannonMultiplier = ownedDetail.cannonMultiplier
			durationMultiplier = ownedDetail.durationMultiplier
		end
		local durationPercent = math.floor((durationMultiplier - 1) * 100 + 0.5)
		local durationEffect = "航程時間維持基準"
		if durationPercent < 0 then durationEffect = "航程時間 -" .. tostring(math.abs(durationPercent)) .. "%"
		elseif durationPercent > 0 then durationEffect = "航程時間 +" .. tostring(durationPercent) .. "%" end
		local preview = ""
		if cannonMultiplier > 1 then preview = "炮擊傷害 +" .. tostring(math.floor((cannonMultiplier - 1) * 100 + 0.5)) .. "%" end
		local effectText = durationEffect
		if preview ~= "" then effectText = durationEffect .. "・" .. preview end
		local slotGuidance = ""
		if isTierOne then slotGuidance = "\nT1：到「船舶改裝」可裝配三個通用槽！" end
		self.shipShopDetailText.Text = "<size=40>" .. selected.name .. "</size>\n<size=22>" .. status .. "</size>\n<size=24>" .. selected.description .. "</size>\n船體 " .. tostring(maxHull) .. "　護盾 " .. tostring(maxShield) .. "\n裝甲 " .. tostring(maxArmor) .. "　貨艙 " .. tostring(cargoCapacity) .. " 格\n<size=24>" .. (isTierOne and "三個通用改裝槽" or "T0 無改裝槽") .. "</size>\n<size=20>" .. effectText .. "</size>"
		if isvalid(self.shipWalletText) then
			self.shipWalletText.Text = self:FormatMoney(snapshot.money or 0)
			self.shipWalletText.Entity.Enable = true
		end
		if isvalid(self.shipShopGoldText) then self.shipShopGoldText.Text = "" end
		if isvalid(self.shipShopMessageText) then
			self.shipShopMessageText.Text = "挑選飛船查看性能，確認後即可購買或換開！"
			if shipActionUpdated and activeShip.message ~= "" then self.shipShopMessageText.Text = activeShip.message end
		end
		local slotButtons = { self.shipShopSlot1Button, self.shipShopSlot2Button, self.shipShopSlot3Button }
		local slotLabels = { self.shipShopSlot1Label, self.shipShopSlot2Label, self.shipShopSlot3Label }
		local slotValues = { "", "", "" }
		if ownedDetail ~= nil and ownedDetail.slots ~= nil then
			slotValues = { ownedDetail.slots.slot1, ownedDetail.slots.slot2, ownedDetail.slots.slot3 }
		end
		for i = 1, 3 do
			if isvalid(slotButtons[i]) then slotButtons[i].Entity.Enable = false; slotButtons[i].Enable = false end
			if isvalid(slotLabels[i]) then slotLabels[i].Entity.Enable = false end
		end
		local upgradeButtons = { self.shipShopUpgrade1Button, self.shipShopUpgrade2Button, self.shipShopUpgrade3Button }
		local canConfigure = isTierOne and ownedDetail ~= nil and self:IsNearPortMerchant() and _GreatVoyageVoyageState.clientSnapshotStatus ~= "sailing" and self.pendingShipShopRevision < 0
		for i = 1, 3 do if isvalid(upgradeButtons[i]) then upgradeButtons[i].Enable = false; upgradeButtons[i].Entity.Enable = false end end
		if isvalid(self.shipShopUpgradeClearButton) then
			self.shipShopUpgradeClearButton.Enable = false
		end
		local canTrade = self:IsNearPortMerchant() and _GreatVoyageVoyageState.clientSnapshotStatus ~= "sailing" and self.pendingShipShopRevision < 0
		self.shipShopActionButton.Enable = canTrade and selected.id ~= activeShip.id
		if self.pendingShipShopRevision >= 0 then
			self.shipShopActionButton.Entity.TextGUIRendererComponent.Text = "處理中…"
		elseif selected.id == activeShip.id then
			self.shipShopActionButton.Entity.TextGUIRendererComponent.Text = "目前使用中"
		elseif owned ~= nil then
			self.shipShopActionButton.Entity.TextGUIRendererComponent.Text = "切換為這艘船"
		else
			-- 價格已在所選船卡獨立顯示，操作鈕只保留動作文字。
			self.shipShopActionButton.Entity.TextGUIRendererComponent.Text = "購買"
		end
		if not canTrade then
			if not self:IsNearPortMerchant() then
				self.shipStatusText.Text = "請靠近港口商人進行船舶買換！"
			elseif _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
				self.shipStatusText.Text = "航行中不能買船或換船喔！"
			end
		elseif activeShip.message ~= "" then
			self.shipStatusText.Text = activeShip.message
		end
	end

	@ExecSpace("ClientOnly")
	method void OnShipRepairClick(ButtonClickEvent event)
		if self.modalType ~= "ship" or _GreatVoyageVoyageState == nil or self.pendingShipRepairRevision >= 0 then return end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local ship = snapshot.ship
		if ship == nil or ship.hull == nil or _GreatVoyageVoyageData == nil then return end
		local definition = _GreatVoyageVoyageData:GetShipById(ship.id)
		local isT1 = definition ~= nil and definition.tier == 1
		if _GreatVoyageVoyageState:GetPortIdFromMap(self.currentMapName) == "" or snapshot.status == "sailing" then return end
		if isT1 and not self:IsNearPortMerchant() then
			self.shipStatusText.Text = "T1 船隻維修請靠近港口商人！"
			return
		end
		self.pendingShipRepairRevision = ship.revision
		if isT1 then _GreatVoyageVoyageState:RepairShip()
		else _GreatVoyageVoyageState:RepairStarterShip() end
		self:RefreshShipPanel()
	end

	@ExecSpace("ClientOnly")
	method void OnShipCargoGridPrevClick(ButtonClickEvent event)
		-- 向前切換貨艙格位頁。
		self.shipCargoGridPage = math.max(1, self.shipCargoGridPage - 1)
		self:RefreshShipPanel()
	end

	@ExecSpace("ClientOnly")
	method void OnShipCargoGridNextClick(ButtonClickEvent event)
		-- 向後切換貨艙格位頁。
		local pageCount = 1
		if _GreatVoyageVoyageState ~= nil then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			if snapshot.ship ~= nil then pageCount = self:GetShipCargoGridPageCount(snapshot.ship.cargoCapacity or 0) end
		end
		self.shipCargoGridPage = math.min(pageCount, self.shipCargoGridPage + 1)
		self:RefreshShipPanel()
	end

	@ExecSpace("ClientOnly")
	method integer GetShipCargoGridPageCount(integer capacity)
		local pageSize = math.max(1, self.shipCargoGridPageSize)
		return math.max(1, math.ceil(math.max(0, capacity) / pageSize))
	end

	@ExecSpace("ClientOnly")
	method string FormatMoney(integer amount)
		-- 用固定千分位顯示整數金額，與作業系統語系無關。
		local digits = tostring(math.max(0, amount))
		local groups = {}
		while #digits > 3 do
			table.insert(groups, 1, string.sub(digits, -3))
			digits = string.sub(digits, 1, -4)
		end
		table.insert(groups, 1, digits)
		return table.concat(groups, ",")
	end

	@ExecSpace("ClientOnly")
	method string GetSaveLoadMessage()
		-- 載入失敗時顯示可理解的狀態，不用初始金額假裝已讀到存檔。
		local status = "loading"
		if _GreatVoyageProfileStore ~= nil then status = _GreatVoyageProfileStore.clientLoadStatus end
		if status == "blocked" then return "存檔暫時無法讀取，資產已保護；請聯絡管理員。" end
		if status == "retry" then return "存檔連線暫時忙碌，稍後自動重試…" end
		return "正在讀取飛船與資產存檔…"
	end

	@ExecSpace("ClientOnly")
	method void HandleTransactionFeedback(string kind, string subjectId, integer revision)
		-- 只接收伺服器成功成交的回執，拒絕同一種類的重複或過期版本。
		local moneyTrade = kind == "goods_buy" or kind == "goods_sell" or kind == "card_buy" or kind == "card_sell"
		if not moneyTrade and kind ~= "ship_buy" then return end
		if revision < 0 then return end
		self._T.feedbackRevisions = self._T.feedbackRevisions or {}
		if revision <= (self._T.feedbackRevisions[kind] or -1) then return end
		if kind == "ship_buy" then
			if _GreatVoyageVoyageData == nil or _GreatVoyageVoyageData:GetShipById(subjectId) == nil then return end
		end
		self._T.feedbackRevisions[kind] = revision
		if moneyTrade then
			_SoundService:PlaySound(self.coinSoundRuid, 0.65)
			log("[VRF] trade feedback kind=" .. kind .. " revision=" .. tostring(revision))
			return
		end
		self._T.acquiredQueue = self._T.acquiredQueue or {}
		-- 新船數量受船隻目錄限制，佇列避免連續購船的長音效互相蓋過。
		table.insert(self._T.acquiredQueue, subjectId)
		if self.acquiredElapsed < 0 then self:ShowNextShipAcquired() end
	end

	@ExecSpace("ClientOnly")
	method void ShowNextShipAcquired()
		-- 用目錄中的實際船圖與名稱呈現登場，不把文字烤進透明素材。
		local queue = self._T.acquiredQueue or {}
		if #queue == 0 then return end
		local shipId = table.remove(queue, 1)
		local definition = _GreatVoyageVoyageData:GetShipById(shipId)
		if definition == nil then return end
		_SoundService:PlaySound(self.acquiredSoundRuid, 0.7)
		if not isvalid(self.acquiredGroup) or not isvalid(self.acquiredPresentation) then return end
		if isvalid(self.acquiredShipName) then self.acquiredShipName.Text = definition.name end
		if isvalid(self.acquiredShipImage) then
			self.acquiredShipImage.ImageRUID = DataRef(definition.spriteRuid or "")
			self.acquiredShipImage.Type = ImageType.Simple
			self.acquiredShipImage.PreserveSprite = PreserveSpriteType.AspectOnly
			self.acquiredShipImage.Color = Color(1, 1, 1, 1)
		end
		self.acquiredElapsed = 0
		self.acquiredPresentation.UIScale = Vector3(0.72, 0.72, 1)
		self.acquiredGroup.CanvasGroupComponent.GroupAlpha = 0
		self.acquiredGroup.Enable = true
		log("[VRF] ship acquired show id=" .. shipId)
	end

	@ExecSpace("ClientOnly")
	method void UpdateShipAcquired(number delta)
		-- 0.28 秒彈出、停留、最後 0.45 秒淡出，整段不攔截操作。
		if self.acquiredElapsed < 0 then return end
		if not isvalid(self.acquiredGroup) or not isvalid(self.acquiredPresentation) then
			self.acquiredElapsed = -1
			self._T.acquiredQueue = {}
			return
		end
		self.acquiredElapsed = self.acquiredElapsed + math.max(0, delta)
		local elapsed = self.acquiredElapsed
		if elapsed >= 3.4 then
			self.acquiredGroup.Enable = false
			self.acquiredElapsed = -1
			log("[VRF] ship acquired hide")
			self:ShowNextShipAcquired()
			return
		end
		local pop = math.min(1, elapsed / 0.28)
		local scale = 0.72 + 0.28 * (1 - (1 - pop) ^ 3)
		self.acquiredPresentation.UIScale = Vector3(scale, scale, 1)
		local alpha = math.min(1, elapsed / 0.12)
		if elapsed > 2.95 then alpha = math.max(0, (3.4 - elapsed) / 0.45) end
		self.acquiredGroup.CanvasGroupComponent.GroupAlpha = alpha
	end

	@ExecSpace("ClientOnly")
	method void RefreshShipPanel()
		-- 依伺服器船況更新船圖、貨艙格與已裝卡。
		if _GreatVoyageVoyageState == nil or not isvalid(self.shipConditionText) then return end
		local showingShipShop = isvalid(self.shipShopPanel) and self.shipShopPanel.Enable
		if isvalid(self.shipCabinContentEntity) then self.shipCabinContentEntity.Enable = not showingShipShop end
		if isvalid(self.shipCargoContentEntity) then self.shipCargoContentEntity.Enable = not showingShipShop end
		if isvalid(self.shipInstalledContentEntity) then self.shipInstalledContentEntity.Enable = not showingShipShop end
		if isvalid(self.shipStatusText) then self.shipStatusText.Entity.Enable = not showingShipShop end
		if isvalid(self.shipFooterHintEntity) then self.shipFooterHintEntity.Enable = not showingShipShop end
		if isvalid(self.shipRepairButton) then self.shipRepairButton.Entity.Enable = not showingShipShop end
		if isvalid(self.shipNameText) then self.shipNameText.Entity.Enable = not showingShipShop end
		if isvalid(self.shipBadgeText) then self.shipBadgeText.Entity.Enable = false end
		if isvalid(self.shipPreviewImage) then self.shipPreviewImage.Entity.Enable = not showingShipShop end
		if isvalid(self.shipCargoHintText) then self.shipCargoHintText.Entity.Enable = not showingShipShop end
		if isvalid(self.shipHeaderTitleText) then
			self.shipHeaderTitleText.Text = showingShipShop and "船舶買賣" or "船艙管理"
			self.shipHeaderTitleText.Entity.Enable = true
		end
		local ship = _GreatVoyageVoyageState.clientShip
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		if ship.hull == nil or snapshot.playerId == "" then
			if isvalid(self.shipNameText) then self.shipNameText.Text = "船舶同步中…" end
			if isvalid(self.shipBadgeText) then self.shipBadgeText.Text = "正在取得船型資料" end
			if isvalid(self.shipModsText) then self.shipModsText.Text = "" end
			self.shipConditionText.Text = "船況同步中…"
			self.shipWalletText.Text = "—"
			self.shipCapacityText.Text = "貨艙同步中…"
			self.shipCargoText.Text = "等待港口資料"
			self.shipCargoIcon.Entity.Enable = false
			local cargoCells = { self.shipCargoGridCell1, self.shipCargoGridCell2, self.shipCargoGridCell3, self.shipCargoGridCell4, self.shipCargoGridCell5, self.shipCargoGridCell6, self.shipCargoGridCell7, self.shipCargoGridCell8, self.shipCargoGridCell9, self.shipCargoGridCell10, self.shipCargoGridCell11, self.shipCargoGridCell12, self.shipCargoGridCell13, self.shipCargoGridCell14, self.shipCargoGridCell15, self.shipCargoGridCell16, self.shipCargoGridCell17, self.shipCargoGridCell18 }
			for i = 1, 18 do if isvalid(cargoCells[i]) then cargoCells[i].Enable = false end end
			self.shipRepairButton.Enable = false
			self.shipStatusText.Text = self:GetSaveLoadMessage()
			return
		end
		if self.pendingShipRepairRevision >= 0 and ship.revision > self.pendingShipRepairRevision then self.pendingShipRepairRevision = -1 end
		if self.pendingShipShopRevision >= 0 and ship.revision > self.pendingShipShopRevision then self.pendingShipShopRevision = -1 end
		-- 顯示目前啟用船的伺服器投影；航行中亦可唯讀查看改裝。
		local definition = nil
		if _GreatVoyageVoyageData ~= nil then definition = _GreatVoyageVoyageData:GetShipById(ship.id) end
		local isT1 = definition ~= nil and definition.tier == 1
		if isvalid(self.shipPreviewImage) then
			self.shipPreviewImage.Entity.Enable = not showingShipShop and definition ~= nil and definition.spriteRuid ~= nil and definition.spriteRuid ~= ""
			if definition ~= nil and definition.spriteRuid ~= nil then
				self.shipPreviewImage.ImageRUID = DataRef(definition.spriteRuid)
				self.shipPreviewImage.PreserveSprite = PreserveSpriteType.AspectOnly
				self.shipPreviewImage.Color = Color(1, 1, 1, 1)
			end
		end
		if isvalid(self.shipNameText) then
			self.shipNameText.Entity.Enable = not showingShipShop
			local tierText = "T0"
			if isT1 then tierText = "T1" end
			self.shipNameText.Text = (ship.name or "飛空船") .. " · " .. tierText
		end
		if isvalid(self.shipBadgeText) then
			self.shipBadgeText.Entity.Enable = false
			self.shipBadgeText.Text = "新手好夥伴 · 四港免費維修"
			if isT1 then self.shipBadgeText.Text = "T1 進階船 · 3 個通用改裝槽" end
		end
		if isvalid(self.shipModsText) then self.shipModsText.Text = "" end
		self.shipConditionText.FontSize = 28
		self.shipConditionText.FontColor = Color(0.29, 0.19, 0.13, 1)
		local modSlotButtons = { self.shipModSlot1Button, self.shipModSlot2Button, self.shipModSlot3Button }
		local modSlotLabels = { self.shipModSlot1Label, self.shipModSlot2Label, self.shipModSlot3Label }
		local cardIds = { "", "", "" }
		if ship.slots ~= nil then cardIds = { ship.slots.slot1 or "", ship.slots.slot2 or "", ship.slots.slot3 or "" } end
		local atPort = _GreatVoyageVoyageState:GetPortIdFromMap(self.currentMapName) ~= "" and snapshot.status ~= "sailing"
		for slotIndex = 1, 3 do
			local slotButton = modSlotButtons[slotIndex]
			local slotLabel = modSlotLabels[slotIndex]
			if isvalid(slotButton) then
				local card = _GreatVoyageVoyageData:GetShipUpgradeCardById(cardIds[slotIndex])
				local artRuid = "2860136c06ab075439721c027de365af"
				local slotRuid = _GreatVoyageVoyageData:GetCardSlotRuid()
				if slotRuid ~= nil and slotRuid ~= "" then artRuid = slotRuid end
				local name = "空槽  ＋"
				if card ~= nil then
					name = card.name
					if card.artRuid ~= nil and card.artRuid ~= "" then artRuid = card.artRuid end
				end
				slotButton.Entity.SpriteGUIRendererComponent.ImageRUID = DataRef(artRuid)
				slotButton.Entity.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
				slotButton.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				if isvalid(slotLabel) then
					slotLabel.Text = tostring(slotIndex) .. " · " .. name
					slotLabel.FontColor = Color(1, 0.93, 0.75, 1)
					slotLabel.FontSize = 20
				end
				local ownedShip = snapshot.ownedShips ~= nil and snapshot.ownedShips[ship.id] ~= nil
				slotButton.Entity.Enable = isT1 and ownedShip
				slotButton.Enable = isT1 and ownedShip and atPort and self:IsNearPortMerchant() and self.pendingShipShopRevision < 0
			end
		end
		if isvalid(self.shipCargoHintText) then self.shipCargoHintText.Text = "每格裝一件貨物，看好圖示與剩餘空位！" end
		local repairQuote = _GreatVoyageVoyageData:GetRepairQuote(ship)
		if isvalid(self.shipRepairButton) then
			self.shipRepairButton.Entity.TextGUIRendererComponent.Text = "免費維修 · 0 G"
			if isT1 then self.shipRepairButton.Entity.TextGUIRendererComponent.Text = "T1 維修 · " .. self:FormatMoney(repairQuote) .. " G" end
		end
		self.shipConditionText.Text = "護盾\n裝甲\n船體"
		local currentConditions = { ship.shield or 0, ship.armor or 0, ship.hull or 0 }
		local maximumConditions = { ship.maxShield or 0, ship.maxArmor or 0, ship.maxHull or 0 }
		local conditionFills = { self.shipShieldBarFillTransform, self.shipArmorBarFillTransform, self.shipHullBarFillTransform }
		local conditionValues = { self.shipShieldValueText, self.shipArmorValueText, self.shipHullValueText }
		for i = 1, 3 do
			local maximum = maximumConditions[i]
			local current = currentConditions[i]
			local ratio = 0
			if maximum > 0 then ratio = math.max(0, math.min(1, current / maximum)) end
			if isvalid(conditionFills[i]) then
				conditionFills[i].RectSize = Vector2(255 * ratio, 13)
				conditionFills[i].Entity.Enable = ratio > 0
			end
			if isvalid(conditionValues[i]) then
				conditionValues[i].Text = tostring(current) .. " / " .. tostring(maximum)
				conditionValues[i].FontSize = 27
				conditionValues[i].FontColor = Color(0.29, 0.19, 0.13, 1)
			end
		end
		self.shipWalletText.Text = self:FormatMoney(snapshot.money or 0)
		local cargo = _GreatVoyageVoyageData:CopyCargo(snapshot.cargo)
		local quantity = cargo.quantity or 0
		local capacity = math.max(0, ship.cargoCapacity or 0)
		self.shipCapacityText.Text = tostring(quantity) .. " / " .. tostring(ship.cargoCapacity) .. "　·　空位 " .. tostring(math.max(0, ship.cargoCapacity - quantity))
		local cargoItems = {}
		for _, lot in ipairs(cargo.lots) do
			local good = _GreatVoyageVoyageData:GetGoodById(lot.id)
			for itemIndex = 1, lot.quantity do table.insert(cargoItems, good or false) end
		end
		local gridCells = { self.shipCargoGridCell1, self.shipCargoGridCell2, self.shipCargoGridCell3, self.shipCargoGridCell4, self.shipCargoGridCell5, self.shipCargoGridCell6, self.shipCargoGridCell7, self.shipCargoGridCell8, self.shipCargoGridCell9, self.shipCargoGridCell10, self.shipCargoGridCell11, self.shipCargoGridCell12, self.shipCargoGridCell13, self.shipCargoGridCell14, self.shipCargoGridCell15, self.shipCargoGridCell16, self.shipCargoGridCell17, self.shipCargoGridCell18 }
		local gridIcons = { self.shipCargoGridIcon1, self.shipCargoGridIcon2, self.shipCargoGridIcon3, self.shipCargoGridIcon4, self.shipCargoGridIcon5, self.shipCargoGridIcon6, self.shipCargoGridIcon7, self.shipCargoGridIcon8, self.shipCargoGridIcon9, self.shipCargoGridIcon10, self.shipCargoGridIcon11, self.shipCargoGridIcon12, self.shipCargoGridIcon13, self.shipCargoGridIcon14, self.shipCargoGridIcon15, self.shipCargoGridIcon16, self.shipCargoGridIcon17, self.shipCargoGridIcon18 }
		local gridLabels = { self.shipCargoGridLabel1, self.shipCargoGridLabel2, self.shipCargoGridLabel3, self.shipCargoGridLabel4, self.shipCargoGridLabel5, self.shipCargoGridLabel6, self.shipCargoGridLabel7, self.shipCargoGridLabel8, self.shipCargoGridLabel9, self.shipCargoGridLabel10, self.shipCargoGridLabel11, self.shipCargoGridLabel12, self.shipCargoGridLabel13, self.shipCargoGridLabel14, self.shipCargoGridLabel15, self.shipCargoGridLabel16, self.shipCargoGridLabel17, self.shipCargoGridLabel18 }
		local cargoGridPageSize = self.shipCargoGridPageSize
		local cargoGridPageCount = self:GetShipCargoGridPageCount(capacity)
		-- 每頁為 UIBuilder 靜態 4×3 格位；第 13 至 18 格作為備用頁面位置。
		for i = 13, 18 do
			if isvalid(gridCells[i]) then gridCells[i].Enable = false end
			if isvalid(gridIcons[i]) then gridIcons[i].Entity.Enable = false end
			if isvalid(gridLabels[i]) then gridLabels[i].Entity.Enable = false end
		end
		self.shipCargoGridPage = math.min(math.max(1, self.shipCargoGridPage), cargoGridPageCount)
		local cargoGridOffset = (self.shipCargoGridPage - 1) * cargoGridPageSize
		local occupiedCount = math.min(capacity, math.max(0, quantity))
		for i = 1, cargoGridPageSize do
			local cargoIndex = cargoGridOffset + i
			local isCapacityCell = cargoIndex <= capacity
			local isOccupied = isCapacityCell and cargoIndex <= occupiedCount
			local good = cargoItems[cargoIndex] or nil
			if isvalid(gridCells[i]) then gridCells[i].Enable = isCapacityCell end
			if isvalid(gridIcons[i]) then
				gridIcons[i].Entity.Enable = isOccupied and good ~= nil
				gridIcons[i].Color = Color(1, 1, 1, 1)
				gridIcons[i].Type = ImageType.Simple
				if isOccupied and good ~= nil then
					gridIcons[i].ImageRUID = DataRef("thumbnail://" .. good.iconRuid)
					gridIcons[i].PreserveSprite = PreserveSpriteType.AspectOnly
				end
			end
			if isvalid(gridLabels[i]) then
				gridLabels[i].Entity.Enable = isCapacityCell
				gridLabels[i].Text = "空位"
				gridLabels[i].FontSize = 20
				gridLabels[i].FontColor = Color(1, 0.94, 0.78, 1)
				if isOccupied then
					gridLabels[i].Text = "×1"
					gridLabels[i].FontColor = Color(1, 0.94, 0.78, 1)
					if good == nil then gridLabels[i].Text = "同步中" end
				end
			end
		end
		if isvalid(self.shipCargoHintText) then self.shipCargoHintText.Entity.Enable = false end
		if isvalid(self.shipCargoGridPageText) then
			self.shipCargoGridPageText.Text = tostring(self.shipCargoGridPage) .. " / " .. tostring(cargoGridPageCount)
			self.shipCargoGridPageText.Entity.Enable = cargoGridPageCount > 1
		end
		if isvalid(self.shipCargoGridPrevButton) then
			self.shipCargoGridPrevButton.Entity.Enable = cargoGridPageCount > 1
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShipModal/Window/Cargo/Prev", self.shipCargoGridPrevButton, self.shipCargoGridPage > 1)
		end
		if isvalid(self.shipCargoGridNextButton) then
			self.shipCargoGridNextButton.Entity.Enable = cargoGridPageCount > 1
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShipModal/Window/Cargo/Next", self.shipCargoGridNextButton, self.shipCargoGridPage < cargoGridPageCount)
		end
		self.shipCargoIcon.Entity.Enable = false
		local cargoGoods = _GreatVoyageVoyageData:GetCargoGoods(cargo)
		if #cargoGoods > 0 then
			local names = {}
			for index, entry in ipairs(cargoGoods) do
				local good = _GreatVoyageVoyageData:GetGoodById(entry.id)
				if index <= 2 and good ~= nil then table.insert(names, good.displayName .. " ×" .. tostring(entry.quantity)) end
			end
			self.shipCargoText.Text = table.concat(names, "　·　")
			if #cargoGoods > 2 then self.shipCargoText.Text = self.shipCargoText.Text .. "　等 " .. tostring(#cargoGoods) .. " 種" end
			self.shipCargoText.Text = self.shipCargoText.Text .. "\n每件占一格 · 進貨成本依批次保留"
		else
			self.shipCargoText.Text = "貨艙空蕩蕩的，找港口商人挑些特產吧！"
		end
		local damaged = ship.hull < ship.maxHull or ship.shield < ship.maxShield or ship.armor < ship.maxArmor
		local repairAllowed = atPort and (not isT1 or self:IsNearPortMerchant())
		self.shipRepairButton.Entity.Enable = not showingShipShop
		self.shipRepairButton.Enable = not showingShipShop and repairAllowed and damaged and self.pendingShipRepairRevision < 0
		if self.shipRepairButton.Enable then
			self.shipRepairButton.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		else
			self.shipRepairButton.Entity.SpriteGUIRendererComponent.Color = Color(0.6, 0.6, 0.6, 1)
		end
		if self.pendingShipRepairRevision >= 0 then
			self.shipStatusText.Text = "維修請求已送出，等待確認中…"
		elseif not atPort then
			self.shipStatusText.Text = "航行中能隨時看船況，回港才能修理喔！"
		elseif isT1 and not self:IsNearPortMerchant() then
			self.shipStatusText.Text = "T1 維修需靠近港口商人。"
		elseif not damaged then
			self.shipStatusText.Text = "船況一級棒，隨時都能起航囉！"
		else
			self.shipStatusText.Text = ship.message or "船身受傷啦，回港支付金幣就能修好！"
		end
	end

	@ExecSpace("ClientOnly")
	method void OnForestClick(ButtonClickEvent event)
		self:SelectDestination("forest")
	end

	@ExecSpace("ClientOnly")
	method void OnSkyClick(ButtonClickEvent event)
		self:SelectDestination("sky")
	end

	@ExecSpace("ClientOnly")
	method void OnLudusClick(ButtonClickEvent event)
		self:SelectDestination("ludus")
	end

	@ExecSpace("ClientOnly")
	method void OnNihalClick(ButtonClickEvent event)
		self:SelectDestination("nihal")
	end

	@ExecSpace("ClientOnly")
	method void SelectDestination(string portId)
		if portId == self.currentPortId then
			self.messageText.Text = "這裡就是現在的港口，換個想去的新目的地吧！"
			return
		end
		self.selectedDestinationId = portId
		self:RefreshSelectionText()
		log("[Adventure] destination selected=" .. portId)
	end

	@ExecSpace("ClientOnly")
	method void CycleDestination(integer delta)
		local ports = { "forest", "sky", "ludus", "nihal" }
		local index = 1
		for i = 1, #ports do
			if ports[i] == self.selectedDestinationId then index = i break end
		end
		for _ = 1, #ports do
			index = index + delta
			if index < 1 then index = #ports elseif index > #ports then index = 1 end
			if ports[index] ~= self.currentPortId then
				self:SelectDestination(ports[index])
				return
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSelectionText()
		-- 目的港名稱與徽章選取狀態同步，讓航線端點不用靠記憶辨認。
		self.selectedText.Entity.Enable = false
		self:RefreshPortSelection()
		self:RefreshRoutePreview()
	end

	@ExecSpace("ClientOnly")
	method void RefreshPortSelection()
		-- 選中的港口保持亮色與括號標記；目前港口稍暗，其他港口維持可選。
		local portIds = { "forest", "sky", "ludus", "nihal" }
		local buttons = { self.forestButton, self.skyButton, self.ludusButton, self.nihalButton }
		local labels = { self.forestPortLabel, self.skyPortLabel, self.ludusPortLabel, self.nihalPortLabel }
		for index, portId in ipairs(portIds) do
			local selected = portId == self.selectedDestinationId
			local button = buttons[index]
			if isvalid(button) and button.Entity.SpriteGUIRendererComponent ~= nil then
				button.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				button.Entity.SpriteGUIRendererComponent.Outline = selected
				button.Entity.SpriteGUIRendererComponent.OutlineColor = Color(1, 0.82, 0.2, 1)
				button.Entity.SpriteGUIRendererComponent.OutlineWidth = 3
			end
			local label = labels[index]
			if isvalid(label) then
				local name = self:GetPortName(portId)
				if selected then
					label.Text = "〔" .. name .. "〕"
					label.FontColor = Color(0.48, 0.23, 0.04, 1)
				else
					label.Text = name
					label.FontColor = Color(0.29, 0.18, 0.09, 1)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method any GetPortPosition(string portId)
		-- 港口與箭頭共用航線資料座標，避免 UI 複本漂移。
		if _GreatVoyageVoyageData == nil then return nil end
		local port = _GreatVoyageVoyageData:GetPort(portId)
		if port == nil then return nil end
		return port.position
	end

	@ExecSpace("ClientOnly")
	method void PlaceWorldMapPin(UITransformComponent pinTransform, any portPosition)
		-- 依 MapArt 實際尺寸定位圖釘，讓針尖對準資料中的港口座標。
		if not isvalid(pinTransform) or not isvalid(self.mapArtTransform) or portPosition == nil then return end
		local mapPosition = self.mapArtTransform.anchoredPosition
		local mapSize = self.mapArtTransform.RectSize
		-- 圖釘尖端位於來源圖 y=0.795；中心上移讓尖端落在港口座標。
		local tipOffsetY = pinTransform.RectSize.y * 0.295
		pinTransform.anchoredPosition = Vector2(
			mapPosition.x + (portPosition.x - 0.5) * mapSize.x,
			mapPosition.y + (portPosition.y - 0.5) * mapSize.y + tipOffsetY)
	end

	@ExecSpace("ClientOnly")
	method void RefreshWorldMapPins()
		-- 每次更新航線預覽時同步四港圖釘的位置。
		self:PlaceWorldMapPin(self.forestMapPinTransform, self:GetPortPosition("forest"))
		self:PlaceWorldMapPin(self.skyMapPinTransform, self:GetPortPosition("sky"))
		self:PlaceWorldMapPin(self.ludusMapPinTransform, self:GetPortPosition("ludus"))
		self:PlaceWorldMapPin(self.nihalMapPinTransform, self:GetPortPosition("nihal"))
	end

	@ExecSpace("ClientOnly")
	method string GetRiskLevel(number risk)
		if risk >= 0.35 then return "極高" end
		if risk >= 0.25 then return "高" end
		if risk >= 0.15 then return "中" end
		return "低"
	end

	@ExecSpace("ClientOnly")
	method void RefreshRoutePreview()
		-- 地圖箭頭和空域文字都以相同的航線快照更新。
		self:RefreshWorldMapPins()
		if not isvalid(self.routeTransform) or not isvalid(self.routeArrowTransform) or not isvalid(self.mapArtTransform) then return end
		local preview = nil
		if _GreatVoyageVoyageState ~= nil then
			preview = _GreatVoyageVoyageState:PreviewDirectRoute(self.currentPortId, self.selectedDestinationId)
		elseif _GreatVoyageVoyageData ~= nil then
			preview = _GreatVoyageVoyageData:PreviewDirectRoute(self.currentPortId, self.selectedDestinationId)
		end
		if preview == nil then return end
		local journey = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/WorldMapModal/Window/JourneyText")
		if isvalid(journey) then journey.TextGUIRendererComponent.Text = "目前：" .. self:GetPortName(self.currentPortId) .. "　→　目的地：" .. self:GetPortName(self.selectedDestinationId) end
		local origin = self:GetPortPosition(self.currentPortId)
		local destination = self:GetPortPosition(self.selectedDestinationId)
		if origin == nil or destination == nil or preview.accepted ~= true then
			self.routeTransform.Enable = false
			self.routeArrowTransform.Enable = false
			if isvalid(self.previewSummaryText) then self.previewSummaryText.Text = "這條航線暫時無法通行\n" .. tostring(preview.reason) end
			if isvalid(self.airspaceOrderText) then self.airspaceOrderText.Text = "空域順序：—" end
			if isvalid(self.segmentDetailsText) then self.segmentDetailsText.Text = "請挑選其他目的港！" end
			return
		end
		local mapPosition = self.mapArtTransform.anchoredPosition
		local mapSize = self.mapArtTransform.RectSize
		local mapX = mapPosition.x
		local mapY = mapPosition.y
		local mapWidth = mapSize.x
		local mapHeight = mapSize.y
		local dx = (destination.x - origin.x) * mapWidth
		local dy = (destination.y - origin.y) * mapHeight
		local lineLength = math.sqrt(dx * dx + dy * dy)
		local angle = 0
		if math.abs(dx) <= 0.001 then
			angle = 90
		elseif dx < 0 then
			angle = math.atan(dy / dx) * 180 / math.pi + 180
		else
			angle = math.atan(dy / dx) * 180 / math.pi
		end
		self.routeTransform.Enable = true
		self.routeArrowTransform.Enable = true
		self.routeTransform.RectSize = Vector2(lineLength, 8)
		self.routeTransform.anchoredPosition = Vector2(mapX + (origin.x + destination.x - 1) * mapWidth * 0.5, mapY + (origin.y + destination.y - 1) * mapHeight * 0.5)
		self.routeTransform:Rotate(angle - self.routeAngle)
		local arrowRetreat = math.min(self.routeArrowTransform.RectSize.x * 0.455, lineLength * 0.35)
		local angleRadians = angle * math.pi / 180
		self.routeArrowTransform.anchoredPosition = Vector2(
			mapX + (destination.x - 0.5) * mapWidth - math.cos(angleRadians) * arrowRetreat,
			mapY + (destination.y - 0.5) * mapHeight - math.sin(angleRadians) * arrowRetreat)
		-- 箭頭圖片沿航線角度正向旋轉，讓箭尖朝向目的港。
		self.routeArrowTransform:Rotate(angle - self.routeArrowAngle)
		self.routeAngle = angle
		self.routeArrowAngle = angle
		log("[MapRoute] " .. self.currentPortId .. "->" .. self.selectedDestinationId .. " start=" .. tostring(origin.x) .. "," .. tostring(origin.y) .. " end=" .. tostring(destination.x) .. "," .. tostring(destination.y))
		if isvalid(self.previewSummaryText) then
			local distance = math.floor(preview.distance + 0.5)
			self.previewSummaryText.Text = "航線距離 " .. tostring(distance)
		end
		local details = ""
		local accumulatedDistance = 0
		local shownDistance = 0
		local shownShare = 0
		for index, segment in ipairs(preview.segments) do
			if index > 1 then details = details .. "\n" end
			local shortName = segment.shortName or segment.displayName
			accumulatedDistance = accumulatedDistance + segment.length
			-- 逐段獨立四捨五入會讓總和差 1；以累計值取整，顯示值仍能加回總距離與 100%。
			local roundedDistance = math.floor(accumulatedDistance + 0.5)
			local distance = roundedDistance - shownDistance
			shownDistance = roundedDistance
			local roundedShare = 0
			if preview.distance > 0 then roundedShare = math.min(100, math.floor(accumulatedDistance / preview.distance * 100 + 0.5)) end
			local share = roundedShare - shownShare
			shownShare = roundedShare
			details = details .. shortName .. "  " .. tostring(distance) .. "／" .. tostring(share) .. "%"
		end
		if isvalid(self.airspaceOrderText) then self.airspaceOrderText.Text = "空域順序（距離／占比）" end
		if isvalid(self.segmentDetailsText) then self.segmentDetailsText.Text = details end
		log("[Adventure] route preview " .. self.currentPortId .. "->" .. self.selectedDestinationId .. " distance=" .. tostring(preview.distance))
	end

	@ExecSpace("ClientOnly")
	method void OnSailClick(ButtonClickEvent event)
		self:BeginVoyage()
	end

	@ExecSpace("ClientOnly")
	method void StartVoyage(string destinationId)
		if _GreatVoyageVoyageState ~= nil then
			-- UI 只送目的地；Server 以 senderUserId 鎖定請求者。
			_GreatVoyageVoyageState:StartVoyage(destinationId)
		end
	end

	@ExecSpace("ClientOnly")
	method void StartVoyageWithReceipt(string destinationId, integer requestSequence)
		if _GreatVoyageVoyageState ~= nil then
			_GreatVoyageVoyageState:StartVoyageWithReceipt(destinationId, requestSequence)
		end
	end

	@ExecSpace("ClientOnly")
	method void BeginVoyage()
		if self._T.pendingVoyageStart == true then
			self.messageText.Text = "出航請求確認中，請稍等船長回覆喔！"
			return
		end
		if self.selectedDestinationId == self.currentPortId then
			self.messageText.Text = "目的地不能選現在這座港口喔！"
			return
		end
		self.pendingDestinationId = self.selectedDestinationId
		if _GreatVoyageVoyageState ~= nil then
			-- 以本地遞增序號配對伺服器回執，避免舊快照或重複點擊誤判。
			self._T.departureRequestSequence = (self._T.departureRequestSequence or 0) + 1
			self._T.pendingVoyageStart = true
			self._T.pendingVoyageStartSequence = self._T.departureRequestSequence
			self:StartVoyageWithReceipt(self.pendingDestinationId, self._T.pendingVoyageStartSequence)
			self.messageText.Text = "出航請求已送出，等船長確認中…"
			log("[Adventure] state voyage requested destination=" .. self.pendingDestinationId)
			return
		elseif _Phase0VoyagePrototype ~= nil then
			_Phase0VoyagePrototype:SelectDestination(self.pendingDestinationId)
			_Phase0VoyagePrototype:StartVoyage()
		else
			return
		end
		self:CloseWorldMap()
		self.messageText.Text = "離港啟程！開始航行！"
	end

	@ExecSpace("ClientOnly")
	method void HandleDepartureResult(integer requestSequence, boolean accepted, string reason)
		if self._T.pendingVoyageStart ~= true or requestSequence ~= self._T.pendingVoyageStartSequence then return end
		self._T.pendingVoyageStart = false
		self._T.pendingVoyageStartSequence = nil
		if accepted == true then
			self:CloseWorldMap()
			self.messageText.Text = "離港啟程！開始航行！"
		else
			self.messageText.Text = reason
			if self.messageText.Text == nil or self.messageText.Text == "" then self.messageText.Text = "出航未完成，請確認船隻狀態後再試一次。" end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCloseMapClick(ButtonClickEvent event)
		self:CloseWorldMap()
	end

	@ExecSpace("ClientOnly")
	method void ArriveAtDestination()
		-- 航程僅由伺服器倒數抵港，舊舵輪入口不能提前傳送或結算。
		if isvalid(self.messageText) then self.messageText.Text = "航行倒數結束後就會自動抵港喔！" end
	end

	@ExecSpace("ClientOnly")
	method string GetCommodityDescription(any good)
		-- 直接顯示逐項撰寫的商品描述，保留卡片等其他商品的既有說明。
		if good == nil then return "" end
		return good.description or ""
	end

	@ExecSpace("ClientOnly")
	method void RefreshShop()
		-- 共用六格貨架與交易區；只顯示產地、商品簡介及本港售價。
		if _GreatVoyageVoyageData == nil or _GreatVoyageVoyageState == nil then return end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local entries = self:GetShopEntries()
		if #entries == 0 then
			self.shopSelectedIndex = 0
			self.shopPage = 1
		else
			self.shopSelectedIndex = math.max(1, math.min(self.shopSelectedIndex, #entries))
		end
		if self.shopTab == "goods" and #entries > 0 and _Phase0VoyagePrototype ~= nil then _Phase0VoyagePrototype.selectedGoodIndex = self.shopSelectedIndex end
		local pageCount = math.max(1, math.ceil(#entries / 6))
		self.shopPage = math.max(1, math.min(self.shopPage, pageCount))
		local root = "/ui/GreatVoyageAdventure/ShopModal/Window/"
		local titles = { goods = "港口貨架", cards = "改裝卡貨架", inventory = "未安裝庫存", sell = "出售貨物" }
		self:SetMerchantText(root .. "Goods/Title", titles[self.shopTab] or titles.goods)
		local fullCards = self.shopTab == "cards" or self.shopTab == "inventory"
		local pagedCards = fullCards and pageCount > 1
		local shelf = _EntityService:GetEntityByPath(root .. "Goods")
		local shelfTitle = _EntityService:GetEntityByPath(root .. "Goods/Title")
		-- 羊皮紙素材上下有透明邊，584 才與右側木框的可見邊緣同高。
		if isvalid(shelf) then shelf.UITransformComponent.RectSize = Vector2(660, 584) end
		if isvalid(shelfTitle) then shelfTitle.UITransformComponent.anchoredPosition = Vector2(0, fullCards and 226 or 199) end
		local portName = self:GetPortName(self.currentPortId)
		local merchantName = portName .. "商人"
		local merchantSpriteRuid = ""
		if isvalid(self.npcTarget) and isvalid(self.npcTarget.NameTagComponent) and self.npcTarget.NameTagComponent.Name ~= "" then
			merchantName = self.npcTarget.NameTagComponent.Name
		end
		if isvalid(self.npcTarget) and isvalid(self.npcTarget.SpriteRendererComponent) then
			merchantSpriteRuid = self.npcTarget.SpriteRendererComponent.SpriteRUID
		end
		local merchantIdentity = self.currentPortId .. "|" .. merchantName .. "|" .. merchantSpriteRuid
		if self.lastShopMerchantIdentity ~= merchantIdentity then
			self.shopHeaderTitleText.Text = string.gsub(portName, "港$", "") .. "商會"
			self.shopNpcNameText.Text = merchantName
			self.shopMerchantPortrait.Enable = merchantSpriteRuid ~= ""
			if merchantSpriteRuid ~= "" then self.shopMerchantPortrait.ImageRUID = DataRef(merchantSpriteRuid) end
			self.lastShopMerchantIdentity = merchantIdentity
			log("[Adventure] merchant identity port=" .. self.currentPortId .. " name=" .. merchantName .. " sprite=" .. merchantSpriteRuid)
		end
		self.shopDialogText.Text = "航線由你決定！挑好特產、整頓愛船，出發尋找各港好行情！"
		if self.shopTab == "cards" then self.shopDialogText.Text = "這裡有六張特色改裝卡，挑選最適合你飛船的強化吧！" end
		if self.shopTab == "sell" then self.shopDialogText.Text = "賣得越多，本港需求越低；報價已包含逐件降價，離線也會恢復喔！" end
		self.shopGoldText.Text = "持有 " .. self:FormatMoney(snapshot.money or 0)
		if snapshot.playerId == "" then self.shopGoldText.Text = "持有 -- G（同步中）" end
		if snapshot.economyRevision ~= self.lastShopEconomyRevision then
			self.lastShopEconomyRevision = snapshot.economyRevision
			if snapshot.economyMessage ~= "" then self.shopStatusMessage = snapshot.economyMessage end
		end
		if snapshot.ship ~= nil and (snapshot.ship.revision or 0) ~= (self._T.merchantShipRevision or -1) then
			self._T.merchantShipRevision = snapshot.ship.revision or 0
			if self.shopTab ~= "goods" and (snapshot.ship.message or "") ~= "" then self.shopStatusMessage = snapshot.ship.message end
		end
		for tile = 1, 6 do
			local index = (self.shopPage - 1) * 6 + tile
			local item = entries[index]
			local entity = _EntityService:GetEntityByPath(root .. "Goods/Good" .. tostring(tile))
			if isvalid(entity) then
				entity.Enable = item ~= nil
				if item ~= nil then
					local tileY = tile <= 3 and 79 or -122
					if fullCards then tileY = tile <= 3 and 85 or -153 end
					if pagedCards then tileY = tile <= 3 and 95 or -110 end
					entity.UITransformComponent.anchoredPosition = Vector2((tile - 1) % 3 * 204 - 204, tileY)
					entity.UITransformComponent.RectSize = fullCards and Vector2(180, 226) or Vector2(194, 192)
					if pagedCards then entity.UITransformComponent.RectSize = Vector2(180, 210) end
					entity.SpriteGUIRendererComponent.ImageRUID = DataRef(fullCards and item.artRuid or "4dec9e34d3bc422a9d2157f6fa321ba4")
					entity.SpriteGUIRendererComponent.Type = ImageType.Simple
					entity.SpriteGUIRendererComponent.PreserveSprite = fullCards and PreserveSpriteType.AspectOnly or PreserveSpriteType.None
					self:SetMerchantText(entity.Path .. "/Name", item.displayName or item.name or "商品")
					local itemPrice = item.price or 0
					self:SetMerchantText(entity.Path .. "/Price", itemPrice > 0 and self:FormatMoney(itemPrice) or "免費")
					local showCurrency = (self.shopTab == "goods" or self.shopTab == "cards") and itemPrice > 0
					local currencyIcon = _EntityService:GetEntityByPath(entity.Path .. "/Price/CoinBag")
					local currencyUnitIcon = _EntityService:GetEntityByPath(entity.Path .. "/Price/CurrencyCoin")
					if isvalid(currencyIcon) then currencyIcon.Enable = showCurrency end
					if isvalid(currencyUnitIcon) then currencyUnitIcon.Enable = showCurrency end
					-- 改裝卡的實際畫面比商品底框窄，幣飾同步收進卡面內。
					if isvalid(currencyIcon) then
						currencyIcon.UITransformComponent.anchoredPosition = Vector2(fullCards and -55 or -76, 0)
						currencyIcon.UITransformComponent.RectSize = fullCards and Vector2(28, 28) or Vector2(38, 38)
					end
					if isvalid(currencyUnitIcon) then
						currencyUnitIcon.UITransformComponent.anchoredPosition = Vector2(fullCards and 55 or 76, 0)
						currencyUnitIcon.UITransformComponent.RectSize = fullCards and Vector2(20, 20) or Vector2(28, 28)
					end
					if self.shopTab == "inventory" then self:SetMerchantText(entity.Path .. "/Price", "持有 " .. tostring((snapshot.cardInventory or {})[item.id] or 0) .. " 張") end
					if self.shopTab == "sell" then
						local cargoQuantity = _GreatVoyageVoyageData:GetCargoGoodQuantity(snapshot.cargo or {}, item.id)
						local saleUnitPrice = _GreatVoyagePlayerMarket:GetClientQuote(self.currentPortId, item.id, 1).unitPrice
						local unit = item.unit or "箱"
						self:SetMerchantText(entity.Path .. "/Price", tostring(cargoQuantity) .. unit .. " · " .. self:FormatMoney(saleUnitPrice) .. "G/" .. unit)
					end
					local nameLabel = _EntityService:GetEntityByPath(entity.Path .. "/Name")
					local priceLabel = _EntityService:GetEntityByPath(entity.Path .. "/Price")
					if isvalid(nameLabel) then
						nameLabel.UITransformComponent.anchoredPosition = Vector2(0, fullCards and -58 or -21)
						if pagedCards then nameLabel.UITransformComponent.anchoredPosition = Vector2(0, -58) end
						nameLabel.UITransformComponent.RectSize = Vector2(fullCards and 156 or 144, fullCards and 26 or 44)
						nameLabel.TextGUIRendererComponent.BestFit = true
						nameLabel.TextGUIRendererComponent.Overflow = fullCards and TextOverflowMode.Overflow or TextOverflowMode.Ellipsis
						nameLabel.TextGUIRendererComponent.MinSize = fullCards and 17 or 14
						nameLabel.TextGUIRendererComponent.FontSize = fullCards and 18 or 21
						nameLabel.TextGUIRendererComponent.MaxSize = fullCards and 18 or 21
					end
					if isvalid(priceLabel) then
						local moneyPrice = self.shopTab == "goods" or self.shopTab == "cards"
						priceLabel.UITransformComponent.anchoredPosition = Vector2(0, fullCards and -78 or -55)
						if pagedCards then priceLabel.UITransformComponent.anchoredPosition = Vector2(0, -78) end
						priceLabel.UITransformComponent.RectSize = Vector2(moneyPrice and (fullCards and 78 or 112) or (fullCards and 154 or 176), self.shopTab == "sell" and 38 or (fullCards and 22 or 24))
						if moneyPrice then
							priceLabel.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Right
							priceLabel.TextGUIRendererComponent.FontColor = Color(1, 0.91, 0.63, 1)
							priceLabel.TextGUIRendererComponent.ColorGradient = true
							priceLabel.TextGUIRendererComponent.GradientMode = GradientModes.Vertical
							priceLabel.TextGUIRendererComponent.TopLeftColor = Color(1, 0.98, 0.82, 1)
							priceLabel.TextGUIRendererComponent.TopRightColor = Color(1, 0.98, 0.82, 1)
							priceLabel.TextGUIRendererComponent.BottomLeftColor = Color(0.82, 0.45, 0.08, 1)
							priceLabel.TextGUIRendererComponent.BottomRightColor = Color(0.82, 0.45, 0.08, 1)
							priceLabel.TextGUIRendererComponent.Underlay = true
							priceLabel.TextGUIRendererComponent.UnderlayColor = Color(0.14, 0.06, 0.015, 0.95)
							priceLabel.TextGUIRendererComponent.FontSize = fullCards and 18 or 21
							priceLabel.TextGUIRendererComponent.MinSize = fullCards and 15 or 16
							priceLabel.TextGUIRendererComponent.MaxSize = fullCards and 18 or 21
							priceLabel.TextGUIRendererComponent.BestFit = true
						elseif self.shopTab == "sell" then
							priceLabel.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Center
							priceLabel.TextGUIRendererComponent.FontColor = Color(0.29, 0.16, 0.08, 1)
							priceLabel.TextGUIRendererComponent.ColorGradient = false
							priceLabel.TextGUIRendererComponent.Underlay = false
							priceLabel.TextGUIRendererComponent.FontSize = 18
							priceLabel.TextGUIRendererComponent.MinSize = 15
							priceLabel.TextGUIRendererComponent.MaxSize = 18
							priceLabel.TextGUIRendererComponent.BestFit = true
						else
							priceLabel.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Center
							priceLabel.TextGUIRendererComponent.FontColor = Color(0.29, 0.16, 0.08, 1)
							priceLabel.TextGUIRendererComponent.ColorGradient = false
							priceLabel.TextGUIRendererComponent.Underlay = false
							priceLabel.TextGUIRendererComponent.FontSize = fullCards and 18 or 21
							priceLabel.TextGUIRendererComponent.MaxSize = fullCards and 18 or 21
						end
					end
					local icon = _EntityService:GetEntityByPath(entity.Path .. "/Icon")
					local ruid = item.iconRuid or item.artRuid or ""
					if isvalid(icon) then
						icon.Enable = ruid ~= "" and not fullCards
						-- 原生掉落物 pivot 可能在左下或畫格外；縮圖以中心定位且保留完整圖示。
						if ruid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = DataRef("thumbnail://" .. ruid) end
						icon.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
					end
					entity.SpriteGUIRendererComponent.Outline = index == self.shopSelectedIndex
					entity.SpriteGUIRendererComponent.OutlineColor = Color(1, 0.82, 0.2, 1)
					entity.SpriteGUIRendererComponent.OutlineWidth = 3
				end
			end
		end
		self:SetMerchantText(root .. "Goods/Page", tostring(self.shopPage) .. " / " .. tostring(pageCount))
		for _, key in ipairs({ "Prev", "Next", "Page" }) do
			local entity = _EntityService:GetEntityByPath(root .. "Goods/" .. key)
			if isvalid(entity) then
				entity.Enable = pageCount > 1
				local pagerX = key == "Prev" and -210 or (key == "Next" and 210 or 0)
				entity.UITransformComponent.anchoredPosition = Vector2(pagerX, fullCards and -227 or -242)
			end
		end
		local selected = entries[self.shopSelectedIndex]
		local emptyTitles = { goods = "這座港口目前沒有特產", cards = "這座港口目前沒有改裝卡", inventory = "倉庫沒有未安裝的卡片", sell = "貨艙裡目前沒有可賣的貨物" }
		local emptyDescriptions = { goods = "這座港口目前沒有能買的特產喔！", cards = "這座港口目前沒有賣改裝卡喔！", inventory = "身上還沒有可以安裝的改裝卡呢！", sell = "貨艙空空如也，沒有能賣的特產喔！" }
		self.shopSelectedText.Text = emptyTitles[self.shopTab] or "目前沒有特產"
		self.shopQuoteText.Text = emptyDescriptions[self.shopTab] or "目前沒有可以顯示的項目喔！"
		local detailDescription = ""
		if selected ~= nil then
			self.shopSelectedText.Text = selected.displayName or selected.name
			detailDescription = self:GetCommodityDescription(selected)
			local sourcePortName = nil
			if selected.originId ~= nil and selected.originId ~= "" then
				sourcePortName = _GreatVoyageVoyageData:GetPortName(selected.originId)
				if sourcePortName == "未知港口" then sourcePortName = nil end
			end
			local sourceRegion = selected.sourceRegion or ""
			local sourceLine = ""
			if sourcePortName ~= nil and sourceRegion ~= "" then sourceLine = "來源：" .. sourcePortName .. "港｜" .. sourceRegion
			elseif sourcePortName ~= nil then sourceLine = "來源：" .. sourcePortName .. "港"
			elseif sourceRegion ~= "" then sourceLine = "來源：" .. sourceRegion end
			if sourceLine ~= "" then detailDescription = sourceLine .. "\n" .. detailDescription end
			self.shopQuoteText.Text = detailDescription
		end
		-- 特產頁容納完整商品描述；出售頁另顯示來源、單價及本次收入。
		local extendedDescription = self.shopTab == "sell"
		local insightHeight = extendedDescription and 148 or (self.shopTab == "goods" and 148 or 96)
		local insightPositionY = extendedDescription and 77 or 79
		local quoteHeight = extendedDescription and 130 or (self.shopTab == "goods" and 122 or 84)
		local insight = _EntityService:GetEntityByPath(root .. "Trade/MarketInsight")
		if isvalid(insight) then
			insight.UITransformComponent.RectSize = Vector2(404, insightHeight)
			insight.UITransformComponent.anchoredPosition = Vector2(0, insightPositionY)
		end
		local insightMaterial = _EntityService:GetEntityByPath(root .. "Trade/MarketInsight/Material")
		if isvalid(insightMaterial) then
			insightMaterial.UITransformComponent.RectSize = Vector2(423, insightHeight + 55)
			insightMaterial.UITransformComponent.anchoredPosition = Vector2(0, -1)
		end
		local quoteTransform = self.shopQuoteText.Entity.UITransformComponent
		quoteTransform.RectSize = Vector2(382, quoteHeight)
		quoteTransform.anchoredPosition = Vector2(0, 0)
		self.shopQuoteText.BestFit = true
		self.shopQuoteText.MinSize = extendedDescription and 14 or 19
		self.shopQuoteText.MaxSize = extendedDescription and 14 or 23
		self.shopQuoteText.FontSize = extendedDescription and 14 or 23
		self.shopQuoteText.VerticalAlignment = extendedDescription and TextVerticalAlignmentOption.Top or TextVerticalAlignmentOption.Middle
		if extendedDescription then
			self.shopQuoteText.Padding = RectOffset(12, 12, 12, 12)
		else
			self.shopQuoteText.Padding = RectOffset(0, 0, 0, 0)
		end
		local icon = _EntityService:GetEntityByPath(root .. "Trade/SelectedIcon")
		local ruid = ""
		if selected ~= nil then ruid = selected.iconRuid or selected.artRuid or "" end
		if isvalid(icon) then
			icon.Enable = ruid ~= ""
			if ruid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = DataRef("thumbnail://" .. ruid) end
			icon.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.AspectOnly
		end
		local quantity = 1
		if _Phase0VoyagePrototype ~= nil then quantity = _Phase0VoyagePrototype.tradeQuantity end
		local cargo = snapshot.cargo or {}
		local capacity = 0
		if snapshot.ship ~= nil then capacity = snapshot.ship.cargoCapacity or 0 end
		if self.shopTab == "goods" or self.shopTab == "sell" then
			self.shopCargoText.Text = "剩餘空位：" .. tostring(math.max(0, capacity - (cargo.quantity or 0)))
		else
			self.shopCargoText.Text = "貨艙 " .. tostring(cargo.quantity or 0) .. "/" .. tostring(capacity)
		end
		if self.shopTab == "cards" or self.shopTab == "inventory" then
			local owned = 0
			if selected ~= nil then owned = (snapshot.cardInventory or {})[selected.id] or 0 end
			self.shopCargoText.Text = "未安裝持有 " .. tostring(owned) .. " 張"
		end
		local sellingCargo = self.shopTab == "sell"
		local cargoQuantity = selected ~= nil and _GreatVoyageVoyageData:GetCargoGoodQuantity(cargo, selected.id) or 0
		local freeSlots = math.max(0, capacity - (cargo.quantity or 0))
		if self.shopTab == "goods" then
			quantity = math.max(1, math.min(quantity, freeSlots))
			if _Phase0VoyagePrototype ~= nil then _Phase0VoyagePrototype.tradeQuantity = quantity end
		end
		if sellingCargo then
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.tradeQuantity = cargoQuantity > 0 and math.max(1, math.min(cargoQuantity, quantity)) or 1
				quantity = _Phase0VoyagePrototype.tradeQuantity
			end
			self.shopQuantityText.Text = "數量　" .. tostring(quantity) .. "\n身上　" .. tostring(cargoQuantity)
			self.shopQuantityText.FontSize = 24
			self.shopQuantityText.MinSize = 24
			self.shopQuantityText.MaxSize = 24
			self.shopQuantityText.BestFit = false
			self.shopQuantityText.VerticalAlignment = TextVerticalAlignmentOption.Middle
			local quantityTransform = self.shopQuantityText.Entity.UITransformComponent
			quantityTransform.RectSize = Vector2(185, 64)
			quantityTransform.anchoredPosition = Vector2(0, -20)
		else
			self.shopQuantityText.Text = "數量　" .. tostring(quantity)
			self.shopQuantityText.FontSize = 29
			self.shopQuantityText.MinSize = 20
			self.shopQuantityText.MaxSize = 24
			self.shopQuantityText.BestFit = false
			self.shopQuantityText.VerticalAlignment = TextVerticalAlignmentOption.Middle
		end
		local canAdjustCargoQuantity = sellingCargo and cargoQuantity > 0 or (not sellingCargo and (self.shopTab ~= "goods" or freeSlots > 0))
		self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Minus", self.shopMinusButton, canAdjustCargoQuantity)
		self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Plus", self.shopPlusButton, canAdjustCargoQuantity)
		local remainingCardCapacity = 99
		if selected ~= nil and self.shopTab == "cards" then remainingCardCapacity = self:GetRemainingCardCapacity(snapshot, selected.id) end
		if remainingCardCapacity > 0 and self.shopTab == "cards" and _Phase0VoyagePrototype ~= nil then
			_Phase0VoyagePrototype.tradeQuantity = math.min(quantity, remainingCardCapacity)
			quantity = _Phase0VoyagePrototype.tradeQuantity
			self.shopQuantityText.Text = "數量　" .. tostring(quantity)
		end
		local stockAllowsBuy = true
		if self.shopTab == "goods" and selected ~= nil then
			local stock = _GreatVoyagePlayerMarket:GetClientStock(self.currentPortId, selected.id)
			stockAllowsBuy = stock.ready == true and (stock.remaining < 0 or quantity <= stock.remaining)
			if selected.isBoss == true then
				self.shopCargoText.Text = "BOSS 庫存：" .. tostring(stock.remaining) .. " 件 · 補貨 " .. tostring(math.ceil((stock.restockSeconds or 0) / 60)) .. " 分"
			end
		end
		local canAfford = selected ~= nil and (snapshot.money or 0) >= (selected.price or 0) * quantity
		self.shopBuyButton.Enable = not sellingCargo and selected ~= nil and self.shopTab ~= "inventory" and snapshot.playerId ~= "" and remainingCardCapacity > 0 and canAfford and stockAllowsBuy and (self.shopTab ~= "goods" or quantity <= freeSlots)
		local saleUnitPrice = 0
		if sellingCargo and selected ~= nil and cargoQuantity > 0 then
			saleUnitPrice = _GreatVoyagePlayerMarket:GetClientQuote(self.currentPortId, selected.id, 1).unitPrice
		end
		if sellingCargo and selected ~= nil then
			self.shopSelectedText.Text = (selected.displayName or selected.name or "貨物") .. " ×" .. tostring(cargoQuantity)
			local unit = selected.unit or "箱"
			local quote = _GreatVoyagePlayerMarket:GetClientQuote(self.currentPortId, selected.id, quantity)
			self.shopQuoteText.Text = detailDescription .. "\n首件 " .. tostring(quote.unitPrice) .. "G/" .. unit .. " · 本次 " .. tostring(quote.total) .. "G"
			self.shopCargoText.Text = ""
		end
		local canSell = self.shopTab == "goods" and (cargo.quantity or 0) > 0 or (sellingCargo and cargoQuantity > 0 and saleUnitPrice > 0)
		if sellingCargo then canSell = selected ~= nil and canSell end
		if self.shopTab ~= "goods" and not sellingCargo then canSell = selected ~= nil and (selected.sellPrice or 0) > 0 and ((snapshot.cardInventory or {})[selected.id] or 0) >= quantity end
		local sellButtonText = self.shopSellButton.Entity.TextGUIRendererComponent
		local sellText = sellingCargo and "出售貨物" or (self.shopTab == "goods" and "出售貨物" or "賣出")
		if isvalid(sellButtonText) then sellButtonText.Text = sellText end
		local sellVisual = self._T.reskinVisuals["/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Sell"]
		if sellVisual ~= nil and isvalid(sellVisual.label) then sellVisual.label.Text = sellText end
		self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Sell", self.shopSellButton, snapshot.playerId ~= "" and canSell)
		for _, tab in ipairs({ { "MarketGoodsTab", "goods" }, { "MarketCardsTab", "cards" }, { "CatalogTab", "sell" }, { "MarketInventoryTab", "inventory" } }) do
			local entity = _EntityService:GetEntityByPath(root .. tab[1])
			if isvalid(entity) then
				local active = self.shopTab == tab[2]
				entity.SpriteGUIRendererComponent.ImageRUID = DataRef(active and "e17a958c47984b66ae042fe461461c49" or "ce825ba2880b43f2a43c5ac011ffeb99")
				entity.TextGUIRendererComponent.FontColor = active and Color(0.27, 0.13, 0.04, 1) or Color(1, 0.95, 0.78, 1)
			end
		end
		self.shopStatusText.Text = self.shopStatusMessage
	end

	@ExecSpace("ClientOnly")
	method string GetPlannedTradeDestinationId()
		-- 舊目的港若等於目前港口，回退到第一個不同的已開放港。
		if _GreatVoyageVoyageData ~= nil and self.selectedDestinationId ~= self.currentPortId then
			if _GreatVoyageVoyageData:GetPort(self.selectedDestinationId) ~= nil then return self.selectedDestinationId end
		end
		if self.currentPortId ~= "forest" then return "forest" end
		return "sky"
	end

	@ExecSpace("ClientOnly")
	method void CycleGood(integer delta)
		-- 使用共用貨架索引循環，並將分頁移到選取商品。
		local entries = self:GetShopEntries()
		if #entries == 0 then return end
		self.shopSelectedIndex = (self.shopSelectedIndex - 1 + delta) % #entries + 1
		self.shopPage = math.floor((self.shopSelectedIndex - 1) / 6) + 1
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void SelectGood(integer index)
		-- tile 索引轉為此頁的商品索引，空格不接受選取。
		local indexOnPage = (self.shopPage - 1) * 6 + index
		if self:GetShopEntries()[indexOnPage] == nil then return end
		self.shopSelectedIndex = indexOnPage
		if self.shopTab == "inventory" and _Phase0VoyagePrototype ~= nil then _Phase0VoyagePrototype.tradeQuantity = 1 end
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void AdjustQuantity(integer delta)
		-- 貨艙出售以持有數量為上限；改裝卡出售仍以未安裝庫存為上限。
		local game = _Phase0VoyagePrototype
		if game == nil or _GreatVoyageVoyageState == nil then return end
		if self.shopTab == "sell" then
			local cargo = _GreatVoyageVoyageState:GetVoyageSnapshot().cargo or {}
			local selected = self:GetShopEntries()[self.shopSelectedIndex]
			local upper = selected ~= nil and _GreatVoyageVoyageData:GetCargoGoodQuantity(cargo, selected.id) or 0
			if upper <= 0 then
				game.tradeQuantity = 1
				self.shopStatusMessage = "貨艙空空的，沒有貨物可賣喔！"
				self:RefreshShop()
				return
			else
				game.tradeQuantity = math.max(1, math.min(upper, game.tradeQuantity + delta))
				self.shopStatusMessage = "交易數量調整為 " .. tostring(game.tradeQuantity)
			end
		elseif self.shopTab == "cards" or self.shopTab == "inventory" then
			local upper = 99
			if self.shopTab == "cards" and _GreatVoyageVoyageState ~= nil then
				local selected = self:GetShopEntries()[self.shopSelectedIndex]
				if selected ~= nil then upper = self:GetRemainingCardCapacity(_GreatVoyageVoyageState:GetVoyageSnapshot(), selected.id) end
			end
			if self.shopTab == "inventory" and _GreatVoyageVoyageState ~= nil then
				local selected = self:GetShopEntries()[self.shopSelectedIndex]
				if selected ~= nil then upper = math.max(1, (_GreatVoyageVoyageState:GetVoyageSnapshot().cardInventory or {})[selected.id] or 0) end
			end
			game.tradeQuantity = math.max(1, math.min(upper, game.tradeQuantity + delta))
		else
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			local freeSlots = math.max(0, (snapshot.ship.cargoCapacity or 0) - ((snapshot.cargo or {}).quantity or 0))
			game.tradeQuantity = math.max(1, math.min(freeSlots, game.tradeQuantity + delta))
		end
		self.shopStatusMessage = "交易數量調整為 " .. tostring(game.tradeQuantity)
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void BuyGood()
		-- 改裝卡沿用共用數量，實際上架驗證由伺服器處理。
		if self.shopTab == "sell" then return end
		if self.shopTab ~= "goods" then
			local selected = self:GetShopEntries()[self.shopSelectedIndex]
			if self.shopTab == "cards" and selected ~= nil and _GreatVoyageVoyageState ~= nil then
				_GreatVoyageVoyageState:BuyUpgradeCard(selected.id, _Phase0VoyagePrototype.tradeQuantity)
				self.shopStatusMessage = "改裝卡買進請求已送出！"
			end
			return
		end
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		if _GreatVoyageVoyageState == nil then
			self.shopStatusMessage = "商店連線中，暫時沒辦法交易喔！"
		else
			local name = game:GetGoodName(game.selectedGoodIndex)
			game:BuySelectedGood()
			self.shopStatusMessage = "已送出買入 " .. name .. " ×" .. tostring(game.tradeQuantity) .. "；等待確認中…"
		end
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void SellGood()
		-- 卡片出售只針對選取卡的未安裝庫存。
		if self.shopTab == "sell" then
			if _GreatVoyageVoyageState == nil then
				self.shopStatusMessage = "商店連線中，暫時沒辦法交易喔！"
			else
				local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
				local cargo = snapshot.cargo or {}
				local good = self:GetShopEntries()[self.shopSelectedIndex]
				local ownedQuantity = good ~= nil and _GreatVoyageVoyageData:GetCargoGoodQuantity(cargo, good.id) or 0
				local saleUnitPrice = 0
				if good ~= nil then saleUnitPrice = _GreatVoyagePlayerMarket:GetClientQuote(self.currentPortId, good.id, 1).unitPrice end
				if snapshot.playerId == "" or ownedQuantity <= 0 or good == nil or saleUnitPrice <= 0 then
					self.shopStatusMessage = "貨艙空空的，沒有貨物可賣喔！"
				else
					local quantity = _Phase0VoyagePrototype ~= nil and _Phase0VoyagePrototype.tradeQuantity or 1
					_GreatVoyageVoyageState:SellGoodQuantity(good.id, quantity)
					self.shopStatusMessage = "賣出請求已送出，等待確認中…"
				end
			end
			self:RefreshShop()
			return
		end
		if self.shopTab ~= "goods" then
			local selected = self:GetShopEntries()[self.shopSelectedIndex]
			if self.shopTab ~= "catalog" and selected ~= nil and _GreatVoyageVoyageState ~= nil then
				local quantity = 1
				if _Phase0VoyagePrototype ~= nil then quantity = _Phase0VoyagePrototype.tradeQuantity end
				_GreatVoyageVoyageState:SellUpgradeCard(selected.id, quantity)
				self.shopStatusMessage = "改裝卡賣出請求已送出！"
			end
			return
		end
		-- 賣出的是貨艙原貨物，不是目的港貨架同序號的商品。
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		if _GreatVoyageVoyageState == nil then
			self.shopStatusMessage = "商店連線中，暫時沒辦法交易喔！"
		else
			self:SetShopTab("sell")
			self.shopStatusMessage = "挑選貨艙裡要出售的商品與數量。"
		end
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void OnShopCloseClick(ButtonClickEvent event)
		self:CloseShop()
	end

	@ExecSpace("ClientOnly")
	method void OnGood1Click(ButtonClickEvent event)
		self:SelectGood(1)
	end

	@ExecSpace("ClientOnly")
	method void OnGood2Click(ButtonClickEvent event)
		self:SelectGood(2)
	end

	@ExecSpace("ClientOnly")
	method void OnGood3Click(ButtonClickEvent event)
		self:SelectGood(3)
	end

	@ExecSpace("ClientOnly")
	method void OnMinusClick(ButtonClickEvent event)
		self:AdjustQuantity(-1)
	end

	@ExecSpace("ClientOnly")
	method void OnPlusClick(ButtonClickEvent event)
		self:AdjustQuantity(1)
	end

	@ExecSpace("ClientOnly")
	method void OnBuyClick(ButtonClickEvent event)
		self:BuyGood()
	end

	@ExecSpace("ClientOnly")
	method void OnSellClick(ButtonClickEvent event)
		self:SellGood()
	end

	@ExecSpace("ClientOnly")
	method string GetPortName(string portId)
		if _GreatVoyageVoyageData ~= nil then
			local dataName = _GreatVoyageVoyageData:GetPortName(portId)
			if dataName ~= "未知港口" then return dataName end
		end
		if portId == "forest" then return "魔法森林" end
		if portId == "sky" then return "天空之城" end
		if portId == "ludus" then return "玩具城" end
		if portId == "nihal" then return "納希沙漠" end
		return "未知港口"
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 清空未播放的登場回饋；不留下 timer 或跨登入佇列。
		self._T.pendingVoyageStart = false
		self._T.pendingVoyageStartSequence = nil
		self._T.feedbackRevisions = {}
		self._T.acquiredQueue = {}
		self.acquiredElapsed = -1
		if isvalid(self.acquiredGroup) then self.acquiredGroup.Enable = false end
		-- 成對回收本次加到可見 child 按鈕的狀態事件。
		for _, subscription in ipairs(self._T.reskinStateHandlers or {}) do
			if isvalid(subscription.entity) and subscription.eventHandler ~= nil then
				subscription.entity:DisconnectEvent(ButtonStateChangeEvent, subscription.eventHandler)
			end
		end
		self._T.reskinStateHandlers = {}
		-- 回收本次商店新增的事件連線。
		for _, subscription in ipairs(self._T.merchantEvents or {}) do
			if isvalid(subscription.entity) then subscription.entity:DisconnectEvent(ButtonClickEvent, subscription.eventHandler) end
		end
		self._T.merchantEvents = {}
		self.clientAirBattle = nil
		if isvalid(self.shipOpenButton) and self.shipOpenHandler ~= nil then self.shipOpenButton.Entity:DisconnectEvent(ButtonClickEvent, self.shipOpenHandler) end
		if isvalid(self.shipCloseButton) and self.shipCloseHandler ~= nil then self.shipCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.shipCloseHandler) end
		if isvalid(self.shipRepairButton) and self.shipRepairHandler ~= nil then self.shipRepairButton.Entity:DisconnectEvent(ButtonClickEvent, self.shipRepairHandler) end
		if isvalid(self.shipCargoGridPrevButton) and self.shipCargoGridPrevHandler ~= nil then self.shipCargoGridPrevButton.Entity:DisconnectEvent(ButtonClickEvent, self.shipCargoGridPrevHandler) end
