	@ExecSpace("ClientOnly")
	method void ConnectMerchantGrid()
		-- 動態格位與頁籤保留成對事件連線，以便 OnEndPlay 回收。
		self._T.merchantEvents = {}
		local root = "/ui/GreatVoyageAdventure/ShopModal/Window/"
		local actions = {
			{ path = "MarketGoodsTab", callback = function() self:SetShopTab("goods") end },
			{ path = "CatalogTab", callback = function() self:SetShopTab("sell") end },
			{ path = "MarketInventoryTab", callback = function() self:SetShopTab("inventory") end },
			{ path = "Goods/Prev", callback = function() self:ChangeShopPage(-1) end },
			{ path = "Goods/Next", callback = function() self:ChangeShopPage(1) end }
		}
		for tile = 4, 6 do
			local capturedTile = tile
			table.insert(actions, { path = "Goods/Good" .. tostring(tile), callback = function() self:SelectGood(capturedTile) end })
		end
		for _, action in ipairs(actions) do
			local entity = _EntityService:GetEntityByPath(root .. action.path)
			if isvalid(entity) then
				local connection = entity:ConnectEvent(ButtonClickEvent, action.callback)
				table.insert(self._T.merchantEvents, { entity = entity, eventHandler = connection })
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetMerchantText(string path, string text)
		-- 修改共用貨架子標籤，缺少節點時安全略過。
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) and isvalid(entity.TextGUIRendererComponent) then entity.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method any GetShopEntries()
		-- 貨物、六張上架卡、玩家庫存及出售頁共用同一資料投影。
		if _GreatVoyageVoyageData == nil then return {} end
		if self.shopTab == "goods" then
			local port = _GreatVoyageVoyageData:GetPort(self.currentPortId)
			if port ~= nil then return port.goods end
			return {}
		end
		if _GreatVoyageVoyageState == nil then return {} end
		if self.shopTab == "sell" then
			local cargo = _GreatVoyageVoyageState:GetVoyageSnapshot().cargo or {}
			local goods = {}
			for _, cargoGood in ipairs(_GreatVoyageVoyageData:GetCargoGoods(cargo)) do
				local good = _GreatVoyageVoyageData:GetGoodById(cargoGood.id)
				if good ~= nil then table.insert(goods, good) end
			end
			return goods
		end
		local list = {}
		if self.shopTab == "cards" then
			for _, cardId in ipairs(_GreatVoyageVoyageState:GetClientCardMarket(self.currentPortId)) do
				local card = _GreatVoyageVoyageData:GetShipUpgradeCardById(cardId)
				if card ~= nil then table.insert(list, card) end
			end
		else
			local inventory = _GreatVoyageVoyageState:GetVoyageSnapshot().cardInventory or {}
			for _, card in ipairs(_GreatVoyageVoyageData:GetShipUpgradeCards()) do
				if (inventory[card.id] or 0) > 0 then table.insert(list, card) end
			end
			table.sort(list, function(a, b) if a.price == b.price then return a.id < b.id end return a.price < b.price end)
		end
		return list
	end

	@ExecSpace("ClientOnly")
	method void SetShopTab(string tab)
		-- 切換頁籤只改投影，不重新抽取港口改裝卡。
		if tab ~= "goods" and tab ~= "cards" and tab ~= "inventory" and tab ~= "sell" then return end
		self.shopTab = tab
		self.shopPage = 1
		self.shopSelectedIndex = 1
		self.shopStatusMessage = "點選商品看看特產介紹！"
		if _Phase0VoyagePrototype ~= nil then _Phase0VoyagePrototype.tradeQuantity = 1 end
		if tab == "cards" and _GreatVoyageVoyageState ~= nil then _GreatVoyageVoyageState:RequestCardMarket() end
		self:RefreshShop()
		log("[MerchantGrid] tab=" .. tab)
	end

	@ExecSpace("ClientOnly")
	method integer GetRemainingCardCapacity(any snapshot, string cardId)
		-- 持有上限包含未安裝及所有船上已安裝副本。
		local count = (snapshot.cardInventory or {})[cardId] or 0
		for _, ownedShip in pairs(snapshot.ownedShips or {}) do
			for _, installedId in pairs(ownedShip.slots or {}) do
				if installedId == cardId then count = count + 1 end
			end
		end
		return math.max(0, 99 - count)
	end

	@ExecSpace("ClientOnly")
	method void ChangeShopPage(integer delta)
		-- 分頁在上下界停止，選取新頁第一筆有效商品。
		local entries = self:GetShopEntries()
		local count = math.max(1, math.ceil(#entries / 6))
		self.shopPage = math.max(1, math.min(count, self.shopPage + delta))
		self.shopSelectedIndex = #entries > 0 and ((self.shopPage - 1) * 6 + 1) or 0
		self:RefreshShop()
	end

end
