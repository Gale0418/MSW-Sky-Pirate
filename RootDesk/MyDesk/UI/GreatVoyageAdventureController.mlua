	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 以實際幀時間推進特效，不受原本每 0.1 秒 UI 更新節流影響。
		self:UpdateShipAcquired(delta)
		-- 暫時連線失敗時低頻要求重新載入；伺服器仍保有自己的 backoff。
		if _GreatVoyageProfileStore ~= nil and _GreatVoyageProfileStore.clientLoadStatus == "retry" then
			self._T.loadRetryElapsed = (self._T.loadRetryElapsed or 0) + delta
			if self._T.loadRetryElapsed >= 30 then
				self._T.loadRetryElapsed = 0
				_GreatVoyageVoyageState:RequestEconomySnapshot()
			end
		else
			self._T.loadRetryElapsed = 0
		end
		self.refreshElapsed = self.refreshElapsed + delta
		if self.refreshElapsed < 0.1 then return end
		local elapsedInterval = self.refreshElapsed
		self.refreshElapsed = 0
		self:RefreshMapContext(false)
		self:RefreshInteraction()
		self:RefreshAirBattleDisplay()
		if self.modalOpen and self.modalType == "shop" then self:RefreshShop() end
		if self.modalOpen and self.modalType == "ship" then self:RefreshShipPanel() end
		if self.modalOpen and self.modalType == "ship_shop" then self:RefreshShipPanel(); self:RefreshShipShop() end
		if self.modalOpen and self.modalType == "card_market" then self:RefreshCardMarket() end
		if self.modalOpen and self.modalType == "card_market" and self.cardMarketRequestPending then
			self.cardMarketPendingElapsed = self.cardMarketPendingElapsed + elapsedInterval
			if self.cardMarketPendingElapsed >= 5 then
				self.cardMarketRequestPending = false
				self.cardMarketFeedback = "尚未收到伺服器更新，請確認港口位置、金幣與未安裝庫存。"
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshMapContext(boolean force)
		-- 地圖變更時重置共用貨架選擇，避免沿用另一港的索引。
		if _UserService.LocalPlayer ~= nil and _UserService.LocalPlayer.CurrentMapName ~= self.currentMapName then
			self.shopPage = 1; self.shopSelectedIndex = 1; self.shopTab = "goods"
			if _Phase0VoyagePrototype ~= nil then _Phase0VoyagePrototype.selectedGoodIndex = 1 end
		end
		-- 只有地圖實際變更時才關閉既有頁面並清除未完成請求。
		local player = _UserService.LocalPlayer
		if player == nil then return end
		local mapName = player.CurrentMapName
		local mapChanged = mapName ~= self.currentMapName
		if force == false and mapChanged == false then return end
		if mapChanged then
			self:CloseActiveModal()
			self.cardMarketRequestPending = false
			self.cardMarketPendingElapsed = 0
			self.cardMarketPendingRevision = -1
			self.pendingShipRepairRevision = -1
			self.pendingShipShopRevision = -1
		end
		self.currentMapName = mapName
		if isvalid(self.shipOpenButton) then
			local canOpenShip = mapName == "map_airship_deck" or (_GreatVoyageVoyageState ~= nil and _GreatVoyageVoyageState:GetPortIdFromMap(mapName) ~= "")
			self.shipOpenButton.Entity.Enable = canOpenShip
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShipOpen", self.shipOpenButton, canOpenShip)
		end
		self.boardingTarget = nil
		self.npcTarget = nil
		self.currentAction = ""
		self.promptButtonEntity.Enable = false

		if mapName == "map_forest_port" then
			self.currentPortId = "forest"
			self.portText.Text = "魔法森林空港"
			self.messageText.Text = "左邊是艾琳；右走到飛船梯旁，按 E 開航圖！"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_forest_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_forest_port/森林商人．艾琳")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "forest"
				_Phase0VoyagePrototype.currentPort = "魔法森林"
			end
		elseif mapName == "map_orbis_port" then
			self.currentPortId = "sky"
			self.portText.Text = "天空之城空港"
			self.messageText.Text = "漫步天空月台；商人露米在左側，飛船在右邊等你！"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_orbis_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_orbis_port/天空商人．露米")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "sky"
				_Phase0VoyagePrototype.currentPort = "天空之城"
			end
		elseif mapName == "map_ludus_port" then
			self.currentPortId = "ludus"
			self.portText.Text = "玩具城港"
			self.messageText.Text = "逛逛積木月台；靠近專屬飛船即可規劃新航線！"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_ludus_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_ludus_port/玩具城商人．奈洛")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "ludus"
				_Phase0VoyagePrototype.currentPort = "玩具城"
			end
		elseif mapName == "map_nihal_port" then
			self.currentPortId = "nihal"
			self.portText.Text = "納希沙漠港"
			self.messageText.Text = "感受沙漠月台風情；靠近飛船就能規劃下一站！"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_nihal_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_nihal_port/納希商人．沙琳")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "nihal"
				_Phase0VoyagePrototype.currentPort = "納希沙漠"
			end
		elseif mapName == "map_airship_deck" then
			self.portText.Text = "航行中"
			self.messageText.Text = "穿梭雲海空域；自動迎戰敵人後，繼續前往目的港！"
			self.targetX = 0.35
		else
			self.portText.Text = "楓谷雲海航線"
			self.messageText.Text = "前往魔法森林或天空之城等港口"
		end
		log("[Adventure] map context=" .. mapName .. " action=" .. self.currentAction)
	end

	@ExecSpace("ClientOnly")
	method void RefreshInteraction()
		if self.modalOpen then
			self.promptButtonEntity.Enable = false
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/PromptButton", self.promptButton, false)
			if isvalid(self.shipOpenButton) then
				self.shipOpenButton.Entity.Enable = false
				self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShipOpen", self.shipOpenButton, false)
			end
			return
		end
		if isvalid(self.shipOpenButton) then
			local canOpenShip = self.currentMapName == "map_airship_deck" or (_GreatVoyageVoyageState ~= nil and _GreatVoyageVoyageState:GetPortIdFromMap(self.currentMapName) ~= "")
			self.shipOpenButton.Entity.Enable = canOpenShip
			self:SetButtonEnabled("/ui/GreatVoyageAdventure/ShipOpen", self.shipOpenButton, canOpenShip)
		end
		local player = _UserService.LocalPlayer
		if player == nil or player.TransformComponent == nil then return end
		local playerPosition = player.TransformComponent.WorldPosition
		local near = false
		self.currentAction = ""

		if self.currentMapName == "map_airship_deck" then
			if _GreatVoyageVoyageState ~= nil then
				if _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
					local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
					local travelled = snapshot.distanceTravelled or 0
					local totalDistance = 0
					if snapshot.route ~= nil and snapshot.route.distance ~= nil then
						totalDistance = snapshot.route.distance
					else
						totalDistance = travelled + (snapshot.budgetRemaining or 0)
					end
					local progressPercent = 0
					if totalDistance > 0 then progressPercent = math.min(100, math.floor(travelled / totalDistance * 100 + 0.5)) end
					self.messageText.Text = "航程進度 " .. tostring(progressPercent) .. "%｜左右移動巡視甲板・抵港後結算"
				end
			end
		else
			local boardDistance = 999
			local npcDistance = 999
			if isvalid(self.boardingTarget) then
				local boardPosition = self.boardingTarget.TransformComponent.WorldPosition
				local boardX = playerPosition.x - boardPosition.x
				local boardY = playerPosition.y - boardPosition.y
				boardDistance = math.sqrt(boardX * boardX + boardY * boardY)
			end
			if isvalid(self.npcTarget) then
				local npcPosition = self.npcTarget.TransformComponent.WorldPosition
				local npcX = playerPosition.x - npcPosition.x
				local npcY = playerPosition.y - npcPosition.y
				npcDistance = math.sqrt(npcX * npcX + npcY * npcY)
			end
			if npcDistance <= 1.1 and npcDistance <= boardDistance then
				near = true
				self.currentAction = "shop"
			elseif boardDistance <= 1.25 then
				near = true
				self.currentAction = "open_map"
			end
		end

		self.promptButtonEntity.Enable = near
		self:SetButtonEnabled("/ui/GreatVoyageAdventure/PromptButton", self.promptButton, near)
		if near == false then return end
		if self.currentAction == "open_map" then
			self:SetPromptText("登上專屬飛空船：準備啟航")
		elseif self.currentAction == "shop" then
			self:SetPromptText("與港口商人聊聊")
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsNearPortMerchant()
		-- 用現有四港商人的距離確認是否顯示本地交易操作。
		local player = _UserService.LocalPlayer
		if player == nil or player.TransformComponent == nil or not isvalid(self.npcTarget) then return false end
		local playerPosition = player.TransformComponent.WorldPosition
		local npcPosition = self.npcTarget.TransformComponent.WorldPosition
		local dx = playerPosition.x - npcPosition.x
		local dy = playerPosition.y - npcPosition.y
		return math.sqrt(dx * dx + dy * dy) <= 1.1
	end

	@ExecSpace("ClientOnly")
	method void RefreshDeckEncounter(string encounterId)
		-- 舊事件面板已移除，保留空入口供歷史呼叫相容。
	end

	@ExecSpace("ClientOnly")
	method void ReceiveAirBattleSnapshot(string battleId, string phase, string airspaceId, string enemyId, string enemyName, number enemyHp, number enemyMaxHp, number playerHp, number playerMaxHp, number remainingSeconds, string outcome, number playerShotSequence, number enemyShotSequence, number playerShotElapsed, number enemyShotElapsed, string playerId)
		local player = _UserService.LocalPlayer
		if not isvalid(player) or player.PlayerComponent == nil or player.PlayerComponent.UserId ~= playerId then return end
		if player.CurrentMapName ~= nil and player.CurrentMapName ~= self.currentMapName then self:RefreshMapContext(false) end
		local previous = self.clientAirBattle
		self.clientAirBattle = {id = battleId, phase = phase, airspaceId = airspaceId, enemyId = enemyId, enemyName = enemyName, enemyHp = enemyHp, enemyMaxHp = enemyMaxHp, playerHp = playerHp, playerMaxHp = playerMaxHp, remainingSeconds = remainingSeconds, outcome = outcome, playerShotSequence = playerShotSequence, enemyShotSequence = enemyShotSequence, playerShotElapsed = playerShotElapsed, enemyShotElapsed = enemyShotElapsed}
		if previous == nil or previous.id ~= battleId or previous.phase ~= phase then
			log("[AirBattleUI] id=" .. battleId .. " phase=" .. phase .. " enemy=" .. enemyId .. " outcome=" .. outcome)
			if isvalid(self.messageText) and phase == "won" and self.currentMapName == "map_airship_deck" then
				self.messageText.Text = "擊退" .. enemyName .. "｜恢復平穩航行，到港後結算！"
			elseif isvalid(self.messageText) and phase == "sunk" and self.currentMapName ~= "map_airship_deck" then
				self.messageText.Text = "船體受損折返出發港，貨物全丟了…快到船艙管理修船！"
			end
		end
		self:RefreshAirBattleDisplay()
	end

	@ExecSpace("ClientOnly")
	method void RefreshAirBattleDisplay()
		local battle = self.clientAirBattle
		if battle == nil or not isvalid(self.messageText) then return end
		if battle.phase == "active" and self.currentMapName == "map_airship_deck" then
			self.messageText.Text = "自動空戰｜" .. battle.enemyName .. " " .. tostring(math.ceil(battle.enemyHp)) .. "/" .. tostring(math.ceil(battle.enemyMaxHp)) .. "｜船體 " .. tostring(math.ceil(battle.playerHp)) .. "/" .. tostring(math.ceil(battle.playerMaxHp))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 教學關閉輸入不得同時觸發港口快捷鍵或後方操作。
		if _GreatVoyageOnboarding ~= nil and _GreatVoyageOnboarding:IsInputBlocked() then return end
		if self.modalOpen then
			if event.key == KeyboardKey.Escape then
				self:CloseActiveModal()
			elseif self.modalType == "world_map" then
				if event.key == KeyboardKey.LeftArrow then
					self:CycleDestination(-1)
				elseif event.key == KeyboardKey.RightArrow then
					self:CycleDestination(1)
				elseif event.key == KeyboardKey.Return or event.key == KeyboardKey.E then
					self:BeginVoyage()
				end
			elseif self.modalType == "shop" then
				if event.key == KeyboardKey.LeftArrow then
					self:CycleGood(-1)
				elseif event.key == KeyboardKey.RightArrow then
					self:CycleGood(1)
				elseif event.key == KeyboardKey.UpArrow then
					self:AdjustQuantity(1)
				elseif event.key == KeyboardKey.DownArrow then
					self:AdjustQuantity(-1)
				elseif event.key == KeyboardKey.B then
					self:BuyGood()
				elseif event.key == KeyboardKey.S then
					self:SellGood()
				end
			end
			return
		end
		if event.key == KeyboardKey.E and self.promptButtonEntity.Enable then
			self:RunCurrentAction()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPromptClick(ButtonClickEvent event)
		self:RunCurrentAction()
	end

	@ExecSpace("ClientOnly")
	method void RunCurrentAction()
		-- 教學關閉輸入不得同時觸發港口快捷鍵或後方操作。
		if _GreatVoyageOnboarding ~= nil and _GreatVoyageOnboarding:IsInputBlocked() then return end
		if self.currentAction == "open_map" then
			self:OpenWorldMap()
		elseif self.currentAction == "shop" then
			self:OpenShop()
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenWorldMap()
		-- 保留在商店規劃的目的港；抵港後若相同，再選一個可達港。
		self.selectedDestinationId = self:GetPlannedTradeDestinationId()
		self.modalOpen = true
		self.modalType = "world_map"
		self.worldMapModal.Enable = true
		self.shopModal.Enable = false
		self.promptButtonEntity.Enable = false
		self:RefreshSelectionText()
		log("[Adventure] world map opened from=" .. self.currentPortId)
	end

	@ExecSpace("ClientOnly")
	method void CloseWorldMap()
		self.worldMapModal.Enable = false
		if self.modalType == "world_map" then
			self.modalOpen = false
			self.modalType = ""
		end
		log("[Adventure] world map closed")
	end

	@ExecSpace("ClientOnly")
	method void OpenShop()
		-- 商店保留自由航線；貨架資訊不透露外港收購價格。
		self:CloseActiveModal()
		self.selectedDestinationId = self:GetPlannedTradeDestinationId()
		self.modalOpen = true
		self.modalType = "shop"
		self.shopModal.Enable = true
		self.worldMapModal.Enable = false
		self.promptButtonEntity.Enable = false
		self.shopStatusMessage = "金幣資料同步中…"
		if _GreatVoyageVoyageState ~= nil then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			self.lastShopEconomyRevision = snapshot.economyRevision
			_GreatVoyageVoyageState:RequestEconomySnapshot()
			_GreatVoyageVoyageState:RequestCardMarket()
		end
		self:RefreshShop()
		log("[Adventure] merchant opened port=" .. self.currentPortId)
	end

	@ExecSpace("ClientOnly")
	method void CloseShop()
		self.shopModal.Enable = false
		if self.modalType == "shop" then
			self.modalOpen = false
			self.modalType = ""
		end
		log("[Adventure] merchant closed")
	end

	@ExecSpace("ClientOnly")
	method void CloseActiveModal()
		-- 開啟另一個頂層視窗前，直接關閉所有 modal，避免返回流程重開舊商店。
		if isvalid(self.worldMapModal) then self.worldMapModal.Enable = false end
		if isvalid(self.shopModal) then self.shopModal.Enable = false end
		if isvalid(self.cardMarketPanel) then self.cardMarketPanel.Enable = false end
		if isvalid(self.shipModal) then self.shipModal.Enable = false end
		if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
		self.shipShopReturnToFitting = false
		self.modalOpen = false
		self.modalType = ""
	end

	@ExecSpace("ClientOnly")
	method void OnShopShipClick(ButtonClickEvent event)
		-- 從港口市場切換至目前船舶的改裝頁。
		if self.modalType ~= "shop" or not isvalid(self.shipModal) or _GreatVoyageVoyageState == nil then return end
		self.selectedShipSlotIndex = 1
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local shipId = ""
		if snapshot.ship ~= nil then shipId = snapshot.ship.id end
		self:OpenCardMarket("install", "shop", shipId, 1)
	end

	@ExecSpace("ClientOnly")
	method void OnShopCardMarketClick(ButtonClickEvent event)
		-- 改裝卡使用同一個商店視窗及交易按鈕。
		if self.modalType == "shop" then self:SetShopTab("cards") end
	end

	@ExecSpace("ClientOnly")
	method void OnShipOpenClick(ButtonClickEvent event)
		if not isvalid(self.shipModal) or _GreatVoyageVoyageState == nil then return end
		self:CloseActiveModal()
		self.modalOpen = true
		self.modalType = "ship"
		self.shipModal.Enable = true
		if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
		self.promptButtonEntity.Enable = false
		self.pendingShipRepairRevision = -1
		_GreatVoyageVoyageState:RequestShipSnapshot()
		self:RefreshShipPanel()
		log("[ShipUI] opened map=" .. self.currentMapName)
	end

	@ExecSpace("ClientOnly")
	method void CloseShipPanel()
		if isvalid(self.shipModal) then self.shipModal.Enable = false end
		if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
		if self.modalType == "ship" or self.modalType == "ship_shop" then
			self.modalOpen = false
			self.modalType = ""
		end
		self.pendingShipRepairRevision = -1
		self.pendingShipShopRevision = -1
	end

	@ExecSpace("ClientOnly")
	method void OnShipCloseClick(ButtonClickEvent event)
		self:CloseShipPanel()
	end

	@ExecSpace("ClientOnly")
	method void OnShipShopBackClick(ButtonClickEvent event)
		-- 返回船舶改裝頁或船況管理頁。
		if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
		self.pendingShipShopRevision = -1
		if self.shipShopReturnToFitting then
			self.shipShopReturnToFitting = false
			if isvalid(self.shipModal) then self.shipModal.Enable = false end
			if isvalid(self.cardMarketPanel) then self.cardMarketPanel.Enable = true end
			self.modalType = "card_market"
			self.modalOpen = true
			self:RefreshCardMarket()
		else
			if self.modalType == "ship_shop" then self.modalType = "ship" end
			self:RefreshShipPanel()
		end
	end

