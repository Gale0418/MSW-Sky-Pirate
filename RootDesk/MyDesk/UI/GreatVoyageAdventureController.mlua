	@ExecSpace("ClientOnly")
	method void OpenActiveShipSlot(integer index)
		if self.modalType ~= "ship" or _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil then return end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local ship = snapshot.ship
		local definition = nil
		if ship ~= nil then definition = _GreatVoyageVoyageData:GetShipById(ship.id) end
		if definition == nil or definition.tier ~= 1 then
			self.shipStatusText.Text = "小風帆沒有改裝槽，找港口商人買 T1 船吧！"
			return
		end
		if snapshot.ownedShips == nil or snapshot.ownedShips[ship.id] == nil then return end
		if not self:IsNearPortMerchant() or snapshot.status == "sailing" then
			self.shipStatusText.Text = "請靠近港口商人再來管理改裝卡！"
			return
		end
		self.selectedShipSlotIndex = index
		self:OpenCardMarket("install", "ship", ship.id, index)
	end

	@ExecSpace("ClientOnly")
	method void SelectShipCatalogItem(integer index)
		-- 更新所選船舶與預設的第一個槽位。
		self.selectedShipCatalogIndex = index
		self.selectedShipSlotIndex = 1
		self:RefreshShipShop()
	end

	@ExecSpace("ClientOnly")
	method void SelectShipSlot(integer index)
		-- 更新目前要配置的改裝槽位。
		self.selectedShipSlotIndex = index
		self:RefreshShipShop()
	end

	@ExecSpace("ClientOnly")
	method void ConfigureSelectedShipSlot(integer cardIndex)
		-- 將選定改裝卡交由伺服器驗證並配置。
		if self.modalType ~= "ship_shop" or self.pendingShipShopRevision >= 0 or not self:IsNearPortMerchant() or _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil then return end
		local catalog = _GreatVoyageVoyageData:GetShipCatalog()
		local selected = catalog[self.selectedShipCatalogIndex]
		local cards = _GreatVoyageVoyageData:GetShipUpgradeCards()
		if selected == nil or selected.tier ~= 1 or self.selectedShipSlotIndex < 1 or self.selectedShipSlotIndex > 3 then return end
		local cardId = ""
		if cardIndex > 0 then
			local card = cards[cardIndex]
			if card == nil then return end
			cardId = card.id
		end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		if snapshot.ship == nil or snapshot.ownedShips == nil or snapshot.ownedShips[selected.id] == nil then return end
		self.pendingShipShopRevision = snapshot.ship.revision
		_GreatVoyageVoyageState:ConfigureShipSlot(selected.id, self.selectedShipSlotIndex, cardId)
		self:RefreshShipShop()
	end

	@ExecSpace("ClientOnly")
	method void OnShipShopActionClick(ButtonClickEvent event)
		-- 將購買或切換請求送到伺服器處理。
		if self.modalType ~= "ship_shop" or self.pendingShipShopRevision >= 0 or _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil then return end
		if not self:IsNearPortMerchant() or _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then return end
		local catalog = _GreatVoyageVoyageData:GetShipCatalog()
		local selected = catalog[self.selectedShipCatalogIndex]
		if selected == nil or selected.id == nil then return end
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		if snapshot.ship == nil or snapshot.ownedShips == nil then return end
		self.pendingShipShopRevision = snapshot.ship.revision
		if snapshot.ownedShips[selected.id] ~= nil then
			_GreatVoyageVoyageState:SelectShip(selected.id)
		else
			_GreatVoyageVoyageState:BuyShip(selected.id)
		end
		self:RefreshShipShop()
	end

	@ExecSpace("ClientOnly")
	method void OpenCardMarket(string mode, string returnModal, string shipId, integer slotIndex)
		-- 買賣模式回到共用商店；配裝頁保留既有槽位操作。
		if mode ~= "install" then
			self:OpenShop()
			if mode == "sell" then self:SetShopTab("inventory") else self:SetShopTab("cards") end
			return
		end
		if _GreatVoyageVoyageState == nil or _GreatVoyageVoyageData == nil or not isvalid(self.cardMarketPanel) then return end
		if not self:IsNearPortMerchant() or _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
			self.shopStatusMessage = "請到港口商人處管理改裝卡！"
			self.shipStatusText.Text = self.shopStatusMessage
			return
		end
		self.cardMarketMode = mode
		self.cardMarketReturnModal = returnModal
		self.cardMarketShipId = shipId
		if mode == "install" then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			if snapshot.ship ~= nil then self.cardMarketShipId = snapshot.ship.id end
		end
		self.selectedShipSlotIndex = slotIndex
		self.cardMarketSelectedCardId = ""
		self.cardMarketSelectedIndex = 0
		self.cardMarketPage = 1
		self.cardMarketQuantity = 1
		self.cardMarketInventoryRevision = -1
		self.cardMarketPendingRevision = -1
		self.cardMarketPendingElapsed = 0
		self.cardMarketRequestPending = false
		self.cardMarketFeedback = ""
		self.cardMarketPanel.Enable = true
		if isvalid(self.worldMapModal) then self.worldMapModal.Enable = false end
		if returnModal == "shop" then self.shopModal.Enable = false end
		if returnModal == "ship_shop" then self.shipShopPanel.Enable = false end
		if isvalid(self.shipModal) then self.shipModal.Enable = false end
		self.modalOpen = true
		self.modalType = "card_market"
		_GreatVoyageVoyageState:RequestShipSnapshot()
		self:RefreshCardMarket()
		log("[CardMarket] opened mode=" .. mode .. " port=" .. self.currentPortId)
	end

	@ExecSpace("ClientOnly")
	method void CloseCardMarket()
		if isvalid(self.cardMarketPanel) then self.cardMarketPanel.Enable = false end
		if self.cardMarketReturnModal == "ship_shop" then
			self.modalType = "ship_shop"
			if isvalid(self.shipModal) then self.shipModal.Enable = true end
			if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = true end
			self:RefreshShipPanel()
			self:RefreshShipShop()
		elseif self.cardMarketReturnModal == "ship" then
			self.modalType = "ship"
			if isvalid(self.shipModal) then self.shipModal.Enable = true end
			if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
			self:RefreshShipPanel()
		else
			self.modalType = "shop"
			if isvalid(self.shipModal) then self.shipModal.Enable = false end
			if isvalid(self.shipShopPanel) then self.shipShopPanel.Enable = false end
			if isvalid(self.shopModal) then self.shopModal.Enable = true end
			self:RefreshShop()
		end
		self.modalOpen = true
	end

	@ExecSpace("ClientOnly")
	method void OnCardMarketBackClick(ButtonClickEvent event)
		self:CloseCardMarket()
	end

	@ExecSpace("ClientOnly")
	method void OnCardMarketCloseClick(ButtonClickEvent event)
		self:CloseCardMarket()
	end

