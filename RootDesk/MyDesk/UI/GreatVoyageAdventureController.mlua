	@ExecSpace("ClientOnly")
	method void CacheReskinVisuals()
		-- 只在 UI 初始化時解析新增 child，更新循環使用快取參照。
		self._T.reskinVisuals = {}
		local paths = {
			"/ui/GreatVoyageAdventure/PromptButton",
			"/ui/GreatVoyageAdventure/ShipOpen",
			"/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Minus",
			"/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Plus",
			"/ui/GreatVoyageAdventure/ShopModal/Window/Trade/Sell",
			"/ui/GreatVoyageAdventure/ShipModal/Window/Cargo/Prev",
			"/ui/GreatVoyageAdventure/ShipModal/Window/Cargo/Next",
			"/ui/GreatVoyageAdventure/CardMarket/Window/Minus",
			"/ui/GreatVoyageAdventure/CardMarket/Window/Plus",
			"/ui/GreatVoyageAdventure/CardMarket/Window/Prev",
			"/ui/GreatVoyageAdventure/CardMarket/Window/Next",
			"/ui/GreatVoyageAdventure/CardMarket/Window/Close",
			"/ui/GreatVoyageAdventure/ShipModal/Window/Close",
			"/ui/GreatVoyageAdventure/ShipModal/Window/ShipShop/Close",
			"/ui/GreatVoyageAdventure/ShopModal/Window/Close",
			"/ui/GreatVoyageAdventure/WorldMapModal/Window/Close"
		}
		local cachedComponentCount = 0
		self._T.reskinButtonEnabled = {}
		self._T.reskinButtonStates = {}
		self._T.reskinStateHandlers = {}
		for _, path in ipairs(paths) do
			local visual = {
				material = nil,
				materialTransform = nil,
				materialBaseScale = nil,
				materialBasePosition = nil,
				label = nil,
				labelTransform = nil,
				rootTransform = nil,
				rootBaseSize = nil,
				button = nil
			}
			local rootEntity = _EntityService:GetEntityByPath(path)
			if isvalid(rootEntity) and isvalid(rootEntity.UITransformComponent) then
				visual.rootTransform = rootEntity.UITransformComponent
				visual.rootBaseSize = rootEntity.UITransformComponent.RectSize
			end
			if isvalid(rootEntity) and isvalid(rootEntity.ButtonComponent) then
				visual.button = rootEntity.ButtonComponent
				self._T.reskinButtonEnabled[path] = rootEntity.ButtonComponent.Enable
				self._T.reskinButtonStates[path] = ButtonState.Normal
				local capturedPath = path
				local stateEventHandle = rootEntity:ConnectEvent(ButtonStateChangeEvent, function(event)
					self:OnReskinButtonStateChange(capturedPath, event)
				end)
				table.insert(self._T.reskinStateHandlers, { entity = rootEntity, eventHandler = stateEventHandle })
			end
			local materialEntity = _EntityService:GetEntityByPath(path .. "/Material")
			if isvalid(materialEntity) and isvalid(materialEntity.SpriteGUIRendererComponent) then
				visual.material = materialEntity.SpriteGUIRendererComponent
				cachedComponentCount = cachedComponentCount + 1
			end
			if isvalid(materialEntity) and isvalid(materialEntity.UITransformComponent) then
				visual.materialTransform = materialEntity.UITransformComponent
				visual.materialBaseScale = materialEntity.UITransformComponent.UIScale
				visual.materialBasePosition = materialEntity.UITransformComponent.anchoredPosition
			end
			local labelEntity = _EntityService:GetEntityByPath(path .. "/Label")
			if isvalid(labelEntity) and isvalid(labelEntity.TextGUIRendererComponent) then
				visual.label = labelEntity.TextGUIRendererComponent
				cachedComponentCount = cachedComponentCount + 1
			end
			if isvalid(labelEntity) and isvalid(labelEntity.UITransformComponent) then
				visual.labelTransform = labelEntity.UITransformComponent
			end
			self._T.reskinVisuals[path] = visual
			self:ApplyReskinButtonState(path, ButtonState.Normal)
		end
		self._T.promptVisualLabel = nil
		local promptLabelEntity = _EntityService:GetEntityByPath("/ui/GreatVoyageAdventure/PromptButton/Label")
		if isvalid(promptLabelEntity) and isvalid(promptLabelEntity.TextGUIRendererComponent) then
			self._T.promptVisualLabel = promptLabelEntity.TextGUIRendererComponent
		end
		self._T.reskinComponentCount = cachedComponentCount
	end

	@ExecSpace("ClientOnly")
	method void SetPromptText(string text)
		-- 根文字維持可讀資料，畫面文字同步到安全區 Label；E 由獨立 KeyHint 呈現。
		if isvalid(self.promptLabel) then self.promptLabel.Text = text end
		if isvalid(self._T.promptVisualLabel) then self._T.promptVisualLabel.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetButtonEnabled(string path, ButtonComponent button, boolean enabled)
		-- 按鈕仍由原 ButtonComponent 控制；新增圖文 child 同步呈現 disabled 狀態。
		if not isvalid(button) then return end
		local wasEnabled = self._T.reskinButtonEnabled[path]
		self._T.reskinButtonEnabled[path] = enabled
		button.Enable = enabled
		if wasEnabled ~= enabled then self._T.reskinButtonStates[path] = ButtonState.Normal end
		self:ApplyReskinButtonState(path, self._T.reskinButtonStates[path] or ButtonState.Normal)
	end

	@ExecSpace("ClientOnly")
	method void OnReskinButtonStateChange(string path, ButtonStateChangeEvent event)
		-- 子圖層接管根圖 alpha=0 後的 hover/pressed 視覺。
		self._T.reskinButtonStates[path] = event.state
		self:ApplyReskinButtonState(path, event.state)
	end

	@ExecSpace("ClientOnly")
	method void ApplyReskinButtonState(string path, ButtonState state)
		local visual = self._T.reskinVisuals[path]
		if visual == nil then return end
		local materialColor = Color(1, 1, 1, 1)
		local labelColor = Color(1, 0.91, 0.69, 1)
		if self._T.reskinButtonEnabled[path] == false then
			materialColor = Color(0.58, 0.55, 0.49, 1)
			labelColor = Color(0.72, 0.67, 0.56, 1)
		elseif state == ButtonState.Hover then
			materialColor = Color(1, 0.98, 0.88, 1)
			labelColor = Color(1, 0.97, 0.82, 1)
		elseif state == ButtonState.Pressed then
			materialColor = Color(0.82, 0.73, 0.57, 1)
			labelColor = Color(0.94, 0.84, 0.64, 1)
		end
		if isvalid(visual.material) then visual.material.Color = materialColor end
		if isvalid(visual.label) then visual.label.FontColor = labelColor end
	end

	@ExecSpace("ClientOnly")
	method void FitCardMarketButtonVisual(string path, UITransformComponent rootTransform, boolean isFitting)
		-- 安裝模式縮窄翻頁按鈕時，縮放固定畫布並讓文字框跟隨根按鈕。
		local visual = self._T.reskinVisuals[path]
		if visual == nil or not isvalid(rootTransform) then return end
		local currentSize = rootTransform.RectSize
		if isvalid(visual.materialTransform) and visual.rootBaseSize ~= nil and visual.rootBaseSize.x > 0 and visual.rootBaseSize.y > 0 then
			local fitScale = math.min(currentSize.x / visual.rootBaseSize.x, currentSize.y / visual.rootBaseSize.y)
			local baseScale = visual.materialBaseScale
			local basePosition = visual.materialBasePosition
			if baseScale ~= nil then visual.materialTransform.UIScale = Vector3(baseScale.x * fitScale, baseScale.y * fitScale, baseScale.z) end
			if basePosition ~= nil then visual.materialTransform.anchoredPosition = Vector2(basePosition.x * fitScale, basePosition.y * fitScale) end
		end
		if isvalid(visual.labelTransform) then
			visual.labelTransform.RectSize = currentSize
			visual.labelTransform.anchoredPosition = Vector2(0, 0)
		end
		if isvalid(visual.label) then
			visual.label.BestFit = true
			visual.label.FontSize = 26
			visual.label.MinSize = 22
			visual.label.MaxSize = 26
			if isFitting then
				visual.label.FontSize = 18
				visual.label.MinSize = 16
				visual.label.MaxSize = 18
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 每次登入建立獨立的成交回饋狀態，不從存檔重播慶祝。
		self._T.feedbackRevisions = {}
		self._T.acquiredQueue = {}
		self._T.loadRetryElapsed = 0
		self.acquiredElapsed = -1
		if isvalid(self.acquiredGroup) then self.acquiredGroup.Enable = false end
		-- 綁定共用商店六格貨架與分頁，事件在結束時回收。
		self:CacheReskinVisuals()
		log("[GV-UI-RESKIN] OnBeginPlay entered; cached child renderer components=" .. tostring(self._T.reskinComponentCount or 0))
		self:ConnectMerchantGrid()
		if not isvalid(self.promptButton) or not isvalid(self.worldMapModal) or not isvalid(self.shopModal) then
			log_warning("[Adventure] UI bindings invalid")
			return
		end
		self.promptButtonEntity.Enable = false
		self:SetButtonEnabled("/ui/GreatVoyageAdventure/PromptButton", self.promptButton, false)
		self.worldMapModal.Enable = false
		self.shopModal.Enable = false
		self.promptHandler = self.promptButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPromptClick)
		self.forestHandler = self.forestButton.Entity:ConnectEvent(ButtonClickEvent, self.OnForestClick)
		self.skyHandler = self.skyButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSkyClick)
		if isvalid(self.ludusButton) then self.ludusHandler = self.ludusButton.Entity:ConnectEvent(ButtonClickEvent, self.OnLudusClick) end
		if isvalid(self.nihalButton) then self.nihalHandler = self.nihalButton.Entity:ConnectEvent(ButtonClickEvent, self.OnNihalClick) end
		self.sailHandler = self.sailButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSailClick)
		self.closeHandler = self.closeMapButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseMapClick)
		self.shopCloseHandler = self.shopCloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnShopCloseClick)
