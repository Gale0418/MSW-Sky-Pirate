	property boolean modalOpen = false
	property number routeAngle = 0
	property number routeArrowAngle = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if not isvalid(self.promptButton) or not isvalid(self.worldMapModal) or not isvalid(self.shopModal) then
			log_warning("[Adventure] UI bindings invalid")
			return
		end
		self.promptButtonEntity.Enable = false
		self.worldMapModal.Enable = false
		self.shopModal.Enable = false
		if isvalid(self.deckEncounterPanel) then self.deckEncounterPanel.Enable = false end
		self.promptHandler = self.promptButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPromptClick)
		self.forestHandler = self.forestButton.Entity:ConnectEvent(ButtonClickEvent, self.OnForestClick)
		self.skyHandler = self.skyButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSkyClick)
		if isvalid(self.ludusButton) then self.ludusHandler = self.ludusButton.Entity:ConnectEvent(ButtonClickEvent, self.OnLudusClick) end
		if isvalid(self.nihalButton) then self.nihalHandler = self.nihalButton.Entity:ConnectEvent(ButtonClickEvent, self.OnNihalClick) end
		self.sailHandler = self.sailButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSailClick)
		self.closeHandler = self.closeMapButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseMapClick)
		self.shopCloseHandler = self.shopCloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnShopCloseClick)
		self.good1Handler = self.shopGood1Button.Entity:ConnectEvent(ButtonClickEvent, self.OnGood1Click)
		self.good2Handler = self.shopGood2Button.Entity:ConnectEvent(ButtonClickEvent, self.OnGood2Click)
		self.good3Handler = self.shopGood3Button.Entity:ConnectEvent(ButtonClickEvent, self.OnGood3Click)
		self.minusHandler = self.shopMinusButton.Entity:ConnectEvent(ButtonClickEvent, self.OnMinusClick)
		self.plusHandler = self.shopPlusButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPlusClick)
		self.buyHandler = self.shopBuyButton.Entity:ConnectEvent(ButtonClickEvent, self.OnBuyClick)
		self.sellHandler = self.shopSellButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSellClick)
		self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		self:RefreshMapContext(true)
		log("[Adventure] voyage and merchant proximity UI ready")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self.refreshElapsed = self.refreshElapsed + delta
		if self.refreshElapsed < 0.1 then return end
		self.refreshElapsed = 0
		self:RefreshMapContext(false)
		self:RefreshInteraction()
		if self.modalOpen and self.modalType == "shop" then self:RefreshShop() end
	end

	@ExecSpace("ClientOnly")
	method void RefreshMapContext(boolean force)
		local player = _UserService.LocalPlayer
		if player == nil then return end
		local mapName = player.CurrentMapName
		if force == false and mapName == self.currentMapName then return end
		self.currentMapName = mapName
		self.lastEncounterId = ""
		self.lastRaidRemaining = -1
		if isvalid(self.deckEncounterPanel) then self.deckEncounterPanel.Enable = false end
		self.boardingTarget = nil
		self.npcTarget = nil
		self.currentAction = ""
		self.promptButtonEntity.Enable = false

		if mapName == "map_forest_port" then
			self.currentPortId = "forest"
			self.portText.Text = "魔法森林空港"
			self.messageText.Text = "艾琳在左側；往右走到飛船梯旁，按 E 開航圖"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_forest_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_forest_port/森林商人．艾琳")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "forest"
				_Phase0VoyagePrototype.currentPort = "魔法森林"
			end
		elseif mapName == "map_orbis_port" then
			self.currentPortId = "sky"
			self.portText.Text = "天空之城空港"
			self.messageText.Text = "探索天空月台；右側是專屬飛空船，商人露米在左側等你"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_orbis_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_orbis_port/天空商人．露米")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "sky"
				_Phase0VoyagePrototype.currentPort = "天空之城"
			end
		elseif mapName == "map_ludus_port" then
			self.currentPortId = "ludus"
			self.portText.Text = "玩具城港"
			self.messageText.Text = "探索玩具城月台；靠近飛空船可規劃下一段航線"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_ludus_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_ludus_port/玩具城商人．奈洛")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "ludus"
				_Phase0VoyagePrototype.currentPort = "玩具城"
			end
		elseif mapName == "map_nihal_port" then
			self.currentPortId = "nihal"
			self.portText.Text = "納希沙漠港"
			self.messageText.Text = "探索沙漠月台；靠近飛空船可規劃下一段航線"
			self.boardingTarget = _EntityService:GetEntityByPath("/maps/map_nihal_port/GV_ShipBoardInteractPoint")
			self.npcTarget = _EntityService:GetEntityByPath("/maps/map_nihal_port/納希商人．沙琳")
			if _Phase0VoyagePrototype ~= nil then
				_Phase0VoyagePrototype.currentPortId = "nihal"
				_Phase0VoyagePrototype.currentPort = "納希沙漠"
			end
		elseif mapName == "map_airship_deck" then
			self.portText.Text = "雲海航行甲板"
			self.messageText.Text = "雲海航程倒數開始；遇襲時航程持續"
			self.targetX = 0.35
		else
			self.portText.Text = "楓谷雲海航線"
			self.messageText.Text = "前往魔法森林或天空之城空港"
		end
		log("[Adventure] map context=" .. mapName .. " action=" .. self.currentAction)
	end

	@ExecSpace("ClientOnly")
	method void RefreshInteraction()
		if self.modalOpen then
			self.promptButtonEntity.Enable = false
			return
		end
		local player = _UserService.LocalPlayer
		if player == nil or player.TransformComponent == nil then return end
		local playerPosition = player.TransformComponent.WorldPosition
		local near = false
		self.currentAction = ""

		if self.currentMapName == "map_airship_deck" then
			local deckX = playerPosition.x - self.targetX
			local deckY = playerPosition.y - self.targetY
			local encounterId = ""
			if _GreatVoyageVoyageState ~= nil then encounterId = _GreatVoyageVoyageState.clientSnapshotPendingEncounterId end
			local raidRemaining = 0
			if _GreatVoyageVoyageState ~= nil then
				raidRemaining = _GreatVoyageVoyageState.clientSnapshotRaidRemaining
				if _GreatVoyageVoyageState.clientSnapshotStatus == "sailing" then
					local seconds = math.ceil(_GreatVoyageVoyageState.clientSnapshotRemainingSeconds)
					local secondsText = tostring(math.max(0, seconds))
					if seconds < 10 then secondsText = "0" .. secondsText end
					if raidRemaining > 0 then
						self.messageText.Text = "菇菇襲擊！按 Ctrl 迎擊，或撐到抵港　｜　剩餘 00:" .. secondsText
					elseif encounterId ~= "" then
						self.messageText.Text = "遭遇事件進行中；航程持續　｜　剩餘 00:" .. secondsText
					else
						self.messageText.Text = "航程 00:" .. secondsText .. "｜左右移動巡視甲板・遇襲按 Ctrl，也可撐到抵港"
					end
				end
			end
			if encounterId ~= self.lastEncounterId or raidRemaining ~= self.lastRaidRemaining then self:RefreshDeckEncounter(encounterId) end
			near = math.sqrt(deckX * deckX + deckY * deckY) <= 0.95
			near = near and encounterId ~= "" and raidRemaining == 0
			if near then self.currentAction = "arrive" end
			if raidRemaining > 0 then
				near = true
				self.currentAction = "attack"
			end
		else
			local boardDistance = 999
			local npcDistance = 999
			if isvalid(self.boardingTarget) then
				local boardPosition = self.boardingTarget.TransformComponent.WorldPosition
				local boardX = playerPosition.x - boardPosition.x
				local boardY = playerPosition.y - boardPosition.y
				boardDistance = math.sqrt(boardX * boardX + boardY * boardY)
			end
			if isvalid(self.npcTarget) then
				local npcPosition = self.npcTarget.TransformComponent.WorldPosition
				local npcX = playerPosition.x - npcPosition.x
				local npcY = playerPosition.y - npcPosition.y
				npcDistance = math.sqrt(npcX * npcX + npcY * npcY)
			end
			if npcDistance <= 1.1 and npcDistance <= boardDistance then
				near = true
				self.currentAction = "shop"
			elseif boardDistance <= 1.25 then
				near = true
				self.currentAction = "open_map"
			end
		end

		self.promptButtonEntity.Enable = near
		if near == false then return end
		if self.currentAction == "open_map" then
			self.promptLabel.Text = "E　登上你的專屬飛空船：啟航"
		elseif self.currentAction == "shop" then
			self.promptLabel.Text = "E　與港口商人交談"
		elseif self.currentAction == "attack" then
			self.promptLabel.Text = "攻擊菇菇　｜　鍵盤 Ctrl"
		else
			self.promptLabel.Text = "E　轉動舵輪：處理航程事件"
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshDeckEncounter(string encounterId)
		-- 只在遭遇 ID 改變時重建事件文案，避免每幀重算航線幾何。
		self.lastEncounterId = encounterId
		self.lastRaidRemaining = 0
		if _GreatVoyageVoyageState ~= nil then self.lastRaidRemaining = _GreatVoyageVoyageState.clientSnapshotRaidRemaining end
		if not isvalid(self.deckEncounterPanel) then return end
		self.deckEncounterPanel.Enable = encounterId ~= ""
		if encounterId == "" then return end
		local title = "未知空域事件"
		local body = "航程不會停下；可前往操舵台處理事件，或等待抵港。"
		local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
		local remainingText = ""
		if snapshot ~= nil then
			local seconds = math.max(0, math.ceil(snapshot.remainingSeconds or 0))
			remainingText = "　｜　剩餘 00:"
			if seconds < 10 then remainingText = remainingText .. "0" end
			remainingText = remainingText .. tostring(seconds)
		end
		if snapshot ~= nil and _GreatVoyageVoyageData ~= nil then
		local segment = _GreatVoyageVoyageState:GetSegmentForDistance(snapshot, snapshot.pausedDistance)
			if segment ~= nil then
				local card = _GreatVoyageVoyageData:GetEncounterCard(segment.airspaceId, snapshot.encounterCount + 1)
				if card ~= nil then
					title = card.title
					body = card.text
					if card.id == "victoria_mushroom_raid" then
						if snapshot.raidRemaining > 0 then
						body = body .. "\n按 Ctrl 迎擊，或撐到抵港｜菇菇剩餘 " .. tostring(snapshot.raidRemaining) .. " 隻。"
					else
						body = body .. "\n襲擊結束，繼續航行。"
						end
					end
				end
			end
		end
		if isvalid(self.encounterTitleText) then self.encounterTitleText.Text = "遭遇・" .. title end
		if isvalid(self.encounterBodyText) then self.encounterBodyText.Text = body end
		if self.lastRaidRemaining > 0 then
		self.messageText.Text = "菇菇襲擊！按 Ctrl 迎擊，或撐到抵港" .. remainingText
	else
		self.messageText.Text = "遭遇事件進行中；航程持續" .. remainingText
		end
		log("[Adventure] encounter shown id=" .. encounterId .. " title=" .. title)
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		if self.modalOpen then
			if event.key == KeyboardKey.Escape then
				self:CloseActiveModal()
			elseif self.modalType == "world_map" then
				if event.key == KeyboardKey.LeftArrow then
					self:CycleDestination(-1)
				elseif event.key == KeyboardKey.RightArrow then
					self:CycleDestination(1)
				elseif event.key == KeyboardKey.Return or event.key == KeyboardKey.E then
					self:BeginVoyage()
				end
			elseif self.modalType == "shop" then
				if event.key == KeyboardKey.LeftArrow then
					self:CycleGood(-1)
				elseif event.key == KeyboardKey.RightArrow then
					self:CycleGood(1)
				elseif event.key == KeyboardKey.UpArrow then
					self:AdjustQuantity(1)
				elseif event.key == KeyboardKey.DownArrow then
					self:AdjustQuantity(-1)
				elseif event.key == KeyboardKey.B then
					self:BuyGood()
				elseif event.key == KeyboardKey.S then
					self:SellGood()
				end
			end
			return
		end
		if event.key == KeyboardKey.E and self.promptButtonEntity.Enable then
			self:RunCurrentAction()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPromptClick(ButtonClickEvent event)
		self:RunCurrentAction()
	end

	@ExecSpace("ClientOnly")
	method void RunCurrentAction()
		if self.currentAction == "open_map" then
			self:OpenWorldMap()
		elseif self.currentAction == "shop" then
			self:OpenShop()
		elseif self.currentAction == "arrive" then
			self:ArriveAtDestination()
		elseif self.currentAction == "attack" then
			local player = _UserService.LocalPlayer
			if player ~= nil and player.GreatVoyagePlayerAttack ~= nil then player.GreatVoyagePlayerAttack:PerformAttack() end
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenWorldMap()
		-- 保留在商店規劃的目的港；抵港後若相同，再選一個可達港。
		self.selectedDestinationId = self:GetPlannedTradeDestinationId()
		self.modalOpen = true
		self.modalType = "world_map"
		self.worldMapModal.Enable = true
		self.shopModal.Enable = false
		self.promptButtonEntity.Enable = false
		self:RefreshSelectionText()
		log("[Adventure] world map opened from=" .. self.currentPortId)
	end

	@ExecSpace("ClientOnly")
	method void CloseWorldMap()
		self.worldMapModal.Enable = false
		if self.modalType == "world_map" then
			self.modalOpen = false
			self.modalType = ""
		end
		log("[Adventure] world map closed")
	end

	@ExecSpace("ClientOnly")
	method void OpenShop()
		-- 商店與航圖沿用同一個預定目的港，價差才有可操作的意義。
		self.selectedDestinationId = self:GetPlannedTradeDestinationId()
		self.modalOpen = true
		self.modalType = "shop"
		self.shopModal.Enable = true
		self.worldMapModal.Enable = false
		self.promptButtonEntity.Enable = false
		self.shopStatusMessage = "同步伺服器錢包中…"
		if _GreatVoyageVoyageState ~= nil then
			local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
			self.lastShopEconomyRevision = snapshot.economyRevision
			_GreatVoyageVoyageState:RequestEconomySnapshot()
		end
		self:RefreshShop()
		log("[Adventure] merchant opened port=" .. self.currentPortId)
	end

	@ExecSpace("ClientOnly")
	method void CloseShop()
		self.shopModal.Enable = false
		if self.modalType == "shop" then
			self.modalOpen = false
			self.modalType = ""
		end
		log("[Adventure] merchant closed")
	end

	@ExecSpace("ClientOnly")
	method void CloseActiveModal()
		if self.modalType == "shop" then self:CloseShop() else self:CloseWorldMap() end
	end

	@ExecSpace("ClientOnly")
	method void OnForestClick(ButtonClickEvent event)
		self:SelectDestination("forest")
	end

	@ExecSpace("ClientOnly")
	method void OnSkyClick(ButtonClickEvent event)
		self:SelectDestination("sky")
	end

	@ExecSpace("ClientOnly")
	method void OnLudusClick(ButtonClickEvent event)
		self:SelectDestination("ludus")
	end

	@ExecSpace("ClientOnly")
	method void OnNihalClick(ButtonClickEvent event)
		self:SelectDestination("nihal")
	end

	@ExecSpace("ClientOnly")
	method void SelectDestination(string portId)
		if portId == self.currentPortId then
			self.messageText.Text = "這裡就是目前港口，請選擇另一個目的地"
			return
		end
		self.selectedDestinationId = portId
		self:RefreshSelectionText()
		log("[Adventure] destination selected=" .. portId)
	end

	@ExecSpace("ClientOnly")
	method void CycleDestination(integer delta)
		local ports = { "forest", "sky", "ludus", "nihal" }
		local index = 1
		for i = 1, #ports do
			if ports[i] == self.selectedDestinationId then index = i break end
		end
		for _ = 1, #ports do
			index = index + delta
			if index < 1 then index = #ports elseif index > #ports then index = 1 end
			if ports[index] ~= self.currentPortId then
				self:SelectDestination(ports[index])
				return
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSelectionText()
		-- 目的港名稱與徽章選取狀態同步，讓航線端點不用靠記憶辨認。
		self.selectedText.Text = "目前：" .. self:GetPortName(self.currentPortId) .. "　→　目的地：" .. self:GetPortName(self.selectedDestinationId)
		self:RefreshPortSelection()
		self:RefreshRoutePreview()
	end

	@ExecSpace("ClientOnly")
	method void RefreshPortSelection()
		-- 選中的港口保持亮色與括號標記；目前港口稍暗，其他港口維持可選。
		local portIds = { "forest", "sky", "ludus", "nihal" }
		local buttons = { self.forestButton, self.skyButton, self.ludusButton, self.nihalButton }
		local labels = { self.forestPortLabel, self.skyPortLabel, self.ludusPortLabel, self.nihalPortLabel }
		for index, portId in ipairs(portIds) do
			local selected = portId == self.selectedDestinationId
			local button = buttons[index]
			if isvalid(button) and button.Entity.SpriteGUIRendererComponent ~= nil then
				if selected then
					button.Entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				elseif portId == self.currentPortId then
					button.Entity.SpriteGUIRendererComponent.Color = Color(0.55, 0.55, 0.55, 1)
				else
					button.Entity.SpriteGUIRendererComponent.Color = Color(0.76, 0.73, 0.67, 1)
				end
			end
			local label = labels[index]
			if isvalid(label) then
				local name = self:GetPortName(portId)
				if selected then
					label.Text = "〔" .. name .. "〕"
					label.FontColor = Color(0.48, 0.23, 0.04, 1)
				else
					label.Text = name
					label.FontColor = Color(0.29, 0.18, 0.09, 1)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method any GetPortPosition(string portId)
		-- 港口與箭頭共用航線資料座標，避免 UI 複本漂移。
		if _GreatVoyageVoyageData == nil then return nil end
		local port = _GreatVoyageVoyageData:GetPort(portId)
		if port == nil then return nil end
		return port.position
	end

	@ExecSpace("ClientOnly")
	method string GetRiskLevel(number risk)
		if risk >= 0.35 then return "極高" end
		if risk >= 0.25 then return "高" end
		if risk >= 0.15 then return "中" end
		return "低"
	end

	@ExecSpace("ClientOnly")
	method void RefreshRoutePreview()
		-- 地圖箭頭和空域文字都以相同的航線快照更新。
		if not isvalid(self.routeTransform) or not isvalid(self.routeArrowTransform) then return end
		local preview = nil
		if _GreatVoyageVoyageState ~= nil then
			preview = _GreatVoyageVoyageState:PreviewDirectRoute(self.currentPortId, self.selectedDestinationId)
		elseif _GreatVoyageVoyageData ~= nil then
			preview = _GreatVoyageVoyageData:PreviewDirectRoute(self.currentPortId, self.selectedDestinationId)
		end
		if preview == nil then return end
		local origin = self:GetPortPosition(self.currentPortId)
		local destination = self:GetPortPosition(self.selectedDestinationId)
		if origin == nil or destination == nil or preview.accepted ~= true then
			self.routeTransform.Enable = false
			self.routeArrowTransform.Enable = false
			if isvalid(self.previewSummaryText) then self.previewSummaryText.Text = "航線不可用\n" .. tostring(preview.reason) end
			if isvalid(self.airspaceOrderText) then self.airspaceOrderText.Text = "空域順序：—" end
			if isvalid(self.segmentDetailsText) then self.segmentDetailsText.Text = "請選擇其他港口" end
			return
		end
		local mapX = -165
		local mapY = -39
		local mapWidth = 640
		local mapHeight = 475
		local dx = (destination.x - origin.x) * mapWidth
		local dy = (destination.y - origin.y) * mapHeight
		local lineLength = math.sqrt(dx * dx + dy * dy)
		local angle = 0
		if math.abs(dx) <= 0.001 then
			angle = 90
		elseif dx < 0 then
			angle = math.atan(dy / dx) * 180 / math.pi + 180
		else
			angle = math.atan(dy / dx) * 180 / math.pi
		end
		self.routeTransform.Enable = true
		self.routeArrowTransform.Enable = true
		self.routeTransform.RectSize = Vector2(lineLength, 8)
		self.routeTransform.anchoredPosition = Vector2(mapX + (origin.x + destination.x - 1) * mapWidth * 0.5, mapY + (origin.y + destination.y - 1) * mapHeight * 0.5)
		self.routeTransform:Rotate(angle - self.routeAngle)
		self.routeArrowTransform.anchoredPosition = Vector2(mapX + (destination.x - 0.5) * mapWidth, mapY + (destination.y - 0.5) * mapHeight)
		-- UI 旋轉的正方向與地圖座標的 y 軸相反；箭頭須反轉角度才會指向目的港。
		self.routeArrowTransform:Rotate(-angle - self.routeArrowAngle)
		self.routeAngle = angle
		self.routeArrowAngle = -angle
		log("[MapRoute] " .. self.currentPortId .. "->" .. self.selectedDestinationId .. " start=" .. tostring(origin.x) .. "," .. tostring(origin.y) .. " end=" .. tostring(destination.x) .. "," .. tostring(destination.y))
		if isvalid(self.previewSummaryText) then
			local expectedCount = preview.expectedEncounterCount or preview.expectedEncounter or 0
			local distance = math.floor(preview.distance + 0.5)
			self.previewSummaryText.Text = "直航 60 秒　·　距離 " .. tostring(distance) .. "\n" .. self:GetRiskLevel(preview.risk) .. "風險　·　預期 " .. tostring(expectedCount) .. " 次遭遇\n遇襲時倒數仍會繼續"
		end
		local details = ""
		local accumulatedDistance = 0
		local shownDistance = 0
		local shownShare = 0
		for index, segment in ipairs(preview.segments) do
			if index > 1 then details = details .. "\n" end
			local shortName = segment.shortName or segment.displayName
			accumulatedDistance = accumulatedDistance + segment.length
			-- 逐段獨立四捨五入會讓總和差 1；以累計值取整，顯示值仍能加回總距離與 100%。
			local roundedDistance = math.floor(accumulatedDistance + 0.5)
			local distance = roundedDistance - shownDistance
			shownDistance = roundedDistance
			local roundedShare = 0
			if preview.distance > 0 then roundedShare = math.min(100, math.floor(accumulatedDistance / preview.distance * 100 + 0.5)) end
			local share = roundedShare - shownShare
			shownShare = roundedShare
			details = details .. shortName .. "  " .. tostring(distance) .. "／" .. tostring(share) .. "%"
		end
		if isvalid(self.airspaceOrderText) then self.airspaceOrderText.Text = "依序穿越 " .. tostring(#preview.segments) .. " 個空域（距離／占比）" end
		if isvalid(self.segmentDetailsText) then self.segmentDetailsText.Text = details end
		log("[Adventure] route preview " .. self.currentPortId .. "->" .. self.selectedDestinationId .. " distance=" .. tostring(preview.distance))
	end

	@ExecSpace("ClientOnly")
	method void OnSailClick(ButtonClickEvent event)
		self:BeginVoyage()
	end

	@ExecSpace("ClientOnly")
	method void StartVoyage(string destinationId)
		if _GreatVoyageVoyageState ~= nil then
			-- UI 只送目的地；Server 以 senderUserId 鎖定請求者。
			_GreatVoyageVoyageState:StartVoyage(destinationId)
		end
	end

	@ExecSpace("ClientOnly")
	method void BeginVoyage()
		if self.selectedDestinationId == self.currentPortId then
			self.messageText.Text = "目的地不可與目前港口相同"
			return
		end
		self.pendingDestinationId = self.selectedDestinationId
		if _GreatVoyageVoyageState ~= nil then
			self:StartVoyage(self.pendingDestinationId)
			log("[Adventure] state voyage requested destination=" .. self.pendingDestinationId)
		elseif _Phase0VoyagePrototype ~= nil then
			_Phase0VoyagePrototype:SelectDestination(self.pendingDestinationId)
			_Phase0VoyagePrototype:StartVoyage()
		end
		self:CloseWorldMap()
		self.messageText.Text = "離港！正在前往雲海航行甲板"
	end

	@ExecSpace("ClientOnly")
	method void OnCloseMapClick(ButtonClickEvent event)
		self:CloseWorldMap()
	end

	@ExecSpace("ClientOnly")
	method void ArriveAtDestination()
		local player = _UserService.LocalPlayer
		if player ~= nil and player.PlayerComponent ~= nil then
			if _GreatVoyageVoyageState ~= nil then
				local snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot()
				if snapshot == nil or snapshot.pendingEncounter == nil then return end
				if snapshot.raidRemaining > 0 then
					self.messageText.Text = "菇菇尚未擊退；也可以撐到抵港！"
					return
				end
				-- 舵輪只處理進行中的事件；航程倒數不受事件影響。
				_GreatVoyageVoyageState:ResolveEncounter("deck_resolved")
				log("[Adventure] deck encounter resolved by local player")
			else
				local targetMap = "map_orbis_port"
				local targetPosition = Vector2(0.7, -0.45)
				if self.pendingDestinationId == "forest" then
					targetMap = "map_forest_port"
					targetPosition = Vector2(5.5, -0.25)
				elseif self.pendingDestinationId == "ludus" then
					targetMap = "map_ludus_port"
				elseif self.pendingDestinationId == "nihal" then
					targetMap = "map_nihal_port"
				end
				player.PlayerComponent:MoveToMapPosition(targetMap, targetPosition)
			end
		end
		self.messageText.Text = "事件已處理，繼續沿原航線前進"
	end

	@ExecSpace("ClientOnly")
	method void RefreshShop()
		-- 三個欄位列本港特產；右欄以同一份資料試算預定目的港價差。
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		local snapshot = nil
		if _GreatVoyageVoyageState ~= nil then snapshot = _GreatVoyageVoyageState:GetVoyageSnapshot() end
		local prefix1 = "  "
		local prefix2 = "  "
		local prefix3 = "  "
		if game.selectedGoodIndex == 1 then prefix1 = "▶ " elseif game.selectedGoodIndex == 2 then prefix2 = "▶ " else prefix3 = "▶ " end
		if snapshot == nil or snapshot.playerId == "" then
			self.shopGoldText.Text = "持有 -- G（同步中）"
			self.shopCargoText.Text = "貨艙等待伺服器同步"
		else
			self.shopGoldText.Text = "持有 " .. tostring(snapshot.money) .. " G"
			self.shopCargoText.Text = game:GetCargoText()
			if snapshot.economyRevision ~= self.lastShopEconomyRevision then
				self.lastShopEconomyRevision = snapshot.economyRevision
				if snapshot.economyRevision > 0 and snapshot.economyMessage ~= "" then self.shopStatusMessage = snapshot.economyMessage end
			end
		end
		self.shopNpcNameText.Text = self:GetPortName(self.currentPortId) .. "商人"
		local destinationId = self:GetPlannedTradeDestinationId()
		self.shopDialogText.Text = "本港特產在外港更值錢。下一站暫定 " .. self:GetPortName(destinationId) .. "；選貨後看右側收購價。"
		self.shopGood1Text.Text = prefix1 .. game:GetGoodName(1)
		self.shopGood2Text.Text = prefix2 .. game:GetGoodName(2)
		self.shopGood3Text.Text = prefix3 .. game:GetGoodName(3)
		if isvalid(self.shopGood1PriceText) then self.shopGood1PriceText.Text = tostring(game:GetCurrentMarketPrice(1)) .. " G" end
		if isvalid(self.shopGood2PriceText) then self.shopGood2PriceText.Text = tostring(game:GetCurrentMarketPrice(2)) .. " G" end
		if isvalid(self.shopGood3PriceText) then self.shopGood3PriceText.Text = tostring(game:GetCurrentMarketPrice(3)) .. " G" end
		if _GreatVoyageVoyageData ~= nil then
			local good1 = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, 1)
			local good2 = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, 2)
			local good3 = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, 3)
			if good1 ~= nil and isvalid(self.shopGood1Icon) then self.shopGood1Icon.ImageRUID = DataRef(good1.iconRuid) end
			if good2 ~= nil and isvalid(self.shopGood2Icon) then self.shopGood2Icon.ImageRUID = DataRef(good2.iconRuid) end
			if good3 ~= nil and isvalid(self.shopGood3Icon) then self.shopGood3Icon.ImageRUID = DataRef(good3.iconRuid) end
		end
		self.shopSelectedText.Text = "已選：" .. game:GetGoodName(game.selectedGoodIndex)
		self.shopQuantityText.Text = "數量　" .. tostring(game.tradeQuantity)
		if isvalid(self.shopQuoteText) and _GreatVoyageVoyageData ~= nil then
			local selectedGood = _GreatVoyageVoyageData:GetLocalGood(self.currentPortId, game.selectedGoodIndex)
			if selectedGood ~= nil then
				local salePrice = _GreatVoyageVoyageData:GetSalePrice(destinationId, selectedGood.id)
				local spread = (salePrice - selectedGood.price) * game.tradeQuantity
				self.shopQuoteText.Text = self:GetPortName(destinationId) .. "收購 " .. tostring(salePrice) .. " G／件\n×" .. tostring(game.tradeQuantity) .. " 預估價差 +" .. tostring(spread) .. " G"
			end
		end
		self.shopStatusText.Text = self.shopStatusMessage
	end

	@ExecSpace("ClientOnly")
	method string GetPlannedTradeDestinationId()
		-- 舊目的港若等於目前港口，回退到第一個不同的已開放港。
		if _GreatVoyageVoyageData ~= nil and self.selectedDestinationId ~= self.currentPortId then
			if _GreatVoyageVoyageData:GetPort(self.selectedDestinationId) ~= nil then return self.selectedDestinationId end
		end
		if self.currentPortId ~= "forest" then return "forest" end
		return "sky"
	end

	@ExecSpace("ClientOnly")
	method void CycleGood(integer delta)
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		game:CycleTradeGood(delta)
		self.shopStatusMessage = "已選擇 " .. game:GetGoodName(game.selectedGoodIndex)
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void SelectGood(integer index)
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		game.selectedGoodIndex = index
		self.shopStatusMessage = "已選擇 " .. game:GetGoodName(index)
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void AdjustQuantity(integer delta)
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		game:AdjustTradeQuantity(delta)
		self.shopStatusMessage = "交易數量調整為 " .. tostring(game.tradeQuantity)
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void BuyGood()
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		if _GreatVoyageVoyageState == nil then
			self.shopStatusMessage = "伺服器商店尚未就緒，無法交易。"
		else
			local name = game:GetGoodName(game.selectedGoodIndex)
			game:BuySelectedGood()
			self.shopStatusMessage = "已送出買入 " .. name .. " ×" .. tostring(game.tradeQuantity) .. "；等待伺服器確認。"
		end
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void SellGood()
		-- 賣出的是貨艙原貨物，不是目的港貨架同序號的商品。
		local game = _Phase0VoyagePrototype
		if game == nil then return end
		if _GreatVoyageVoyageState == nil then
			self.shopStatusMessage = "伺服器商店尚未就緒，無法交易。"
		else
			game:SellCargo()
			self.shopStatusMessage = "已送出賣出請求；等待伺服器確認。"
		end
		self:RefreshShop()
	end

	@ExecSpace("ClientOnly")
	method void OnShopCloseClick(ButtonClickEvent event)
		self:CloseShop()
	end

	@ExecSpace("ClientOnly")
	method void OnGood1Click(ButtonClickEvent event)
		self:SelectGood(1)
	end

	@ExecSpace("ClientOnly")
	method void OnGood2Click(ButtonClickEvent event)
		self:SelectGood(2)
	end

	@ExecSpace("ClientOnly")
	method void OnGood3Click(ButtonClickEvent event)
		self:SelectGood(3)
	end

	@ExecSpace("ClientOnly")
	method void OnMinusClick(ButtonClickEvent event)
		self:AdjustQuantity(-1)
	end

	@ExecSpace("ClientOnly")
	method void OnPlusClick(ButtonClickEvent event)
		self:AdjustQuantity(1)
	end

	@ExecSpace("ClientOnly")
	method void OnBuyClick(ButtonClickEvent event)
		self:BuyGood()
	end

	@ExecSpace("ClientOnly")
	method void OnSellClick(ButtonClickEvent event)
		self:SellGood()
	end

	@ExecSpace("ClientOnly")
	method string GetPortName(string portId)
		if _GreatVoyageVoyageData ~= nil then
			local dataName = _GreatVoyageVoyageData:GetPortName(portId)
			if dataName ~= "未知港口" then return dataName end
		end
		if portId == "forest" then return "魔法森林" end
		return "天空之城"
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if isvalid(self.promptButton) and self.promptHandler ~= nil then self.promptButton.Entity:DisconnectEvent(ButtonClickEvent, self.promptHandler) end
		if isvalid(self.forestButton) and self.forestHandler ~= nil then self.forestButton.Entity:DisconnectEvent(ButtonClickEvent, self.forestHandler) end
		if isvalid(self.skyButton) and self.skyHandler ~= nil then self.skyButton.Entity:DisconnectEvent(ButtonClickEvent, self.skyHandler) end
		if isvalid(self.ludusButton) and self.ludusHandler ~= nil then self.ludusButton.Entity:DisconnectEvent(ButtonClickEvent, self.ludusHandler) end
		if isvalid(self.nihalButton) and self.nihalHandler ~= nil then self.nihalButton.Entity:DisconnectEvent(ButtonClickEvent, self.nihalHandler) end
		if isvalid(self.sailButton) and self.sailHandler ~= nil then self.sailButton.Entity:DisconnectEvent(ButtonClickEvent, self.sailHandler) end
		if isvalid(self.closeMapButton) and self.closeHandler ~= nil then self.closeMapButton.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler) end
		if isvalid(self.shopCloseButton) and self.shopCloseHandler ~= nil then self.shopCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.shopCloseHandler) end
		if isvalid(self.shopGood1Button) and self.good1Handler ~= nil then self.shopGood1Button.Entity:DisconnectEvent(ButtonClickEvent, self.good1Handler) end
		if isvalid(self.shopGood2Button) and self.good2Handler ~= nil then self.shopGood2Button.Entity:DisconnectEvent(ButtonClickEvent, self.good2Handler) end
		if isvalid(self.shopGood3Button) and self.good3Handler ~= nil then self.shopGood3Button.Entity:DisconnectEvent(ButtonClickEvent, self.good3Handler) end
		if isvalid(self.shopMinusButton) and self.minusHandler ~= nil then self.shopMinusButton.Entity:DisconnectEvent(ButtonClickEvent, self.minusHandler) end
		if isvalid(self.shopPlusButton) and self.plusHandler ~= nil then self.shopPlusButton.Entity:DisconnectEvent(ButtonClickEvent, self.plusHandler) end
		if isvalid(self.shopBuyButton) and self.buyHandler ~= nil then self.shopBuyButton.Entity:DisconnectEvent(ButtonClickEvent, self.buyHandler) end
		if isvalid(self.shopSellButton) and self.sellHandler ~= nil then self.shopSellButton.Entity:DisconnectEvent(ButtonClickEvent, self.sellHandler) end
		if self.keyHandler ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self.keyHandler) end
	end
end
